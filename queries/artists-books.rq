PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx: <http://sparql.xyz/facade-x/ns/>
PREFIX ab: <https://dkglab.github.io/ns/artists-books/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX bf: <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc: <http://id.loc.gov/ontologies/bflc/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX marc: <http://www.loc.gov/MARC21/slim#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

CONSTRUCT {
  ?book a ab:ArtistsBook ;
    rdfs:label ?title ;
    ab:itemKey ?canonical_key ;
    ab:heldBySloane ?held_flag ;
    bf:contribution ?contribution ;
    bf:provisionActivity ?bookPublication ;
    bf:language ?marc_language ;
    bf:language ?language041 ;
    bf:extent ?bookExtent ;
    bf:illustrativeContent ?illustrative_content ;
    bf:dimensions ?dimensions ;
    bf:editionStatement ?edition ;
    bf:summary ?bookSummary ;
    bf:identifiedBy ?bookISBN ;
    bf:identifiedBy ?bookOCLCNum ;
    foaf:isPrimaryTopicOf ?worldcat_url ;
    ab:constructedUsing ?constructionConcept ;
    ab:hasSubject ?subjectConcept ;
    .


  ?bookPublication a bf:Publication ;
    bflc:simpleAgent ?publisher ;
    bflc:simpleDate ?date ;
    bflc:simplePlace ?place ;
    .

  ?bookISBN a bf:Identifier ;
    rdf:value ?ISBN ;
    bf:source wd:Q33057 ; # ISBN
    .

  ?bookOCLCNum a bf:Local ;
    rdf:value ?oclc_number ;
    bf:source wd:Q846596 ; # Worldcat
    .

  ?bookExtent a bf:Extent ;
    rdfs:label ?extent ; # Extent
    .

  ?contribution a ?contributionType ;
    bf:agent ?creator ;
    bf:role ?roleConcept ;
    .

  ?roleConcept a bf:Role ;
    rdfs:label ?role_term ;
    .

  ?creator a bf:Agent ;
    rdfs:label ?creator_name ;
    .

  ?bookSummary
    a bf:Summary ;
    rdfs:label ?summary .

  ?marc_language a bf:Language ;
    rdfs:label ?language_label ;
  .

  ?language041 a bf:Language ;
  rdfs:label ?language041_label .

}
WHERE {
  SERVICE <x-sparql-anything:location=sources/artists-books.csv> {
    # Facade-X configuration for CSV data
    fx:properties
      fx:csv.headers "true" ;  # create xyz:header properties
      fx:csv.null-string  "" ; # treat empty strings as null values
      .

    # For each row in the canonical artists'-book list (#82: lib 1 ∪ 2 ∪ 3,
    # deduplicated to one node per work). Only canonicalKey and title are
    # required; publisher/date are OPTIONAL so books lacking them still emit
    # (otherwise books like Ruscha's "Every building on the Sunset Strip." which
    # has a date but no publisher would silently drop out, taking their citations
    # with them).
    ?bookRow
      xyz:canonicalKey ?canonical_key ;
      xyz:title ?title ;
      .

    # Mint new book URIs from the canonical key. Citations (sources/citations.ttl)
    # target these same item/<canonicalKey> URIs.
    BIND(fx:entity(ab:, "item/", ?canonical_key) AS ?book)
    BIND(fx:entity(ab:, "item/", ?canonical_key, "/publication") AS ?bookPublication)

    # Sloane holdings flag (#82): the ~1,300 works UNC physically holds (and has
    # images of). Non-held rows carry an empty cell -> null -> ?held_raw unbound
    # -> no triple.
    OPTIONAL { ?bookRow xyz:held ?held_raw }
    BIND(IF(BOUND(?held_raw), true, ?sentinel) AS ?held_flag)

    OPTIONAL { ?bookRow xyz:publisher ?publisher }
    OPTIONAL {
      ?bookRow xyz:date ?date_raw .
      # Strip Zotero's leading "YYYY-MM-DD " prefix from the date string
      BIND(REPLACE(?date_raw, "^\\d{4}-\\d{2}-\\d{2} ", "") AS ?date)
    }

    OPTIONAL {
      ?bookRow xyz:place ?place
    }
    OPTIONAL { ?bookRow xyz:ISBN ?ISBN }
    BIND(fx:entity(ab:, "item/", ?canonical_key, "/identifier") AS ?isbnNode)
    BIND(IF(BOUND(?ISBN), ?isbnNode, ?sentinel) AS ?bookISBN)
  }

  # Creators come from the full MARC records (sources/marc/artists-books-marc.zip),
  # which carry authoritative names plus real-world-object URIs (VIAF/ISNI in
  # $1) and LC name-authority URIs ($0). Since the canonical re-harvest (#84) each
  # record's synthetic 999 $a carries the *canonical* key, so the MARC joins the
  # book directly on ?canonical_key. A book with no MARC record simply gets no
  # enrichment.
  #
  # Kept OPTIONAL so books without a MARC record still emit.
  OPTIONAL {
    # One row per creator field, with a single chosen name / VIAF / ISNI / LC id.
    # Multiple $1 subfields (a creator often has both VIAF and ISNI) are folded
    # together here so each creator field yields exactly one ?creator downstream.
    #
    # ?illustrative_content_x is a *grouping key*, not a SAMPLE: unlike extent /
    # dimensions / edition — of which a book has exactly one — a record may
    # legitimately carry several 300 $b values (multi-part items list one per
    # volume or format), and all of them belong in the graph. Grouping on it
    # yields one row per (creator field, illustrative content) pair; the extra
    # rows re-assert identical contribution triples, which collapse in RDF.
    {
      SELECT ?canonical_key ?df ?ctag ?role_term ?contributionType
             (?illustrative_content_x AS ?illustrative_content)
             (?language041_x AS ?language041_code)
             (SAMPLE(?control_number_raw) AS ?control_number)
             (SAMPLE(?language_code_x) AS ?language_code)
             (SAMPLE(?extent_x) AS ?extent)
             (SAMPLE(?dimensions_x) AS ?dimensions)
             (SAMPLE(?edition_x) AS ?edition)
             (SAMPLE(?summary_x) AS ?summary)
             (SAMPLE(?name_x)  AS ?creator_name)
             (SAMPLE(?viaf_x)  AS ?viaf)
             (SAMPLE(?isni_x)  AS ?isni)
             (SAMPLE(?lc_id_x) AS ?lc_id)
      WHERE {
        SERVICE <x-sparql-anything:location=sources/marc/artists-books-marc.zip> {
          # Per-record MARC archive (#81): one MARCXML document per record. The
          # outer archive read lists the entries (fx:archive.matches); the inner
          # SERVICE triplifies just that one record (fx:location ?file +
          # fx:from-archive) and joins to the CSV row on the record's own 999 $a —
          # the key is read from the record data, not the filename. Each entry is
          # triplified once (per-record traversal still uses fx:anySlot, not a
          # variable predicate — docs/QUERY-PERFORMANCE.md).
          fx:properties fx:archive.matches ".*\\.xml" .
          ?archive fx:anySlot ?file .

          SERVICE <x-sparql-anything:> {
            fx:properties
              fx:location ?file ;
              fx:from-archive "sources/marc/artists-books-marc.zip" ;
              fx:media-type "application/xml" .

          # For each MARC record
          ?record a marc:record .

          # 999 $a — the canonical key stamped onto each record at harvest (#84),
          # to join directly with the canonical CSV query above.
          ?record fx:anySlot ?f999 .
          ?f999 a marc:datafield ; xyz:tag "999" .
          ?f999 fx:anySlot ?sf999a .
          ?sf999a xyz:code "a" ; rdf:_1 ?canonical_key .

          # OCLC number from the 001 control field (per record, always present).
          # 001 is a marc:controlfield, so its value is on rdf:_1, not a subfield.
          ?record fx:anySlot ?cf001 .
          ?cf001 a marc:controlfield ; xyz:tag "001" ; rdf:_1 ?control_number_raw .

          # Primary language from MARC 008 positions 35-37.
          OPTIONAL {
            ?record fx:anySlot ?cf008 .
            ?cf008
              a marc:controlfield ;
              xyz:tag "008" ;
              rdf:_1 ?fixed_fields .
            BIND(SUBSTR(?fixed_fields, 36, 3) AS ?language_code_raw)

            # Blank and fill-character values mean no usable language code.
            FILTER(?language_code_raw != "   " && ?language_code_raw != "|||")

            BIND(LCASE(?language_code_raw) AS ?language_code_x)
          }

          # Languages present from MARC 041 $a.
          # Older records may concatenate multiple 3-character MARC language
          # codes in one subfield (e.g. "engfreger"), while newer records repeat $a.
          OPTIONAL {
            ?record fx:anySlot ?df041 .
            ?df041
                a marc:datafield ;
                xyz:tag "041" .

            ?df041 fx:anySlot ?sf041a .
            ?sf041a
                xyz:code "a" ;
                rdf:_1 ?language041_raw .

            BIND(LCASE(STR(?language041_raw)) AS ?language041_value)

            # Only process values composed entirely of complete 3-character codes.
            # This intentionally excludes the malformed "enger" value.
            FILTER(REGEX(?language041_value, "^([a-z]{3})+$"))

            VALUES ?language_offset { 1 4 7 10 13 16 }

            BIND(
              SUBSTR(?language041_value, ?language_offset, 3)
              AS ?language041_x
            )

            FILTER(STRLEN(?language041_x) = 3)
            FILTER(?language041_x != "jap")
          }

          # Extent from MARC 300 $a. This describes the physical scope/form
          # of the item, e.g. "64 unnumbered pages" or "1 portfolio".
          OPTIONAL {
            ?record fx:anySlot ?df300 .
            ?df300 a marc:datafield ; xyz:tag "300" .

            ?df300 fx:anySlot ?sf300a .
            ?sf300a xyz:code "a" ; rdf:_1 ?extent_raw .

            # Strip trailing cataloging punctuation such as ":".
            BIND(REPLACE(?extent_raw, "[\\s:;/]+$", "") AS ?extent_x)
          }

          # Illustrative content from MARC 300 $b, such as
          # "illustrations" or "color illustrations".
          OPTIONAL {
            # Anchor the traversal independently on the record, as with 300 $c.
            # Reusing ?df300 could cause an unbound-subject scan when 300 $a
            # is absent but 300 $b is present.
            ?record fx:anySlot ?df300b .
            ?df300b a marc:datafield ; xyz:tag "300" .

            ?df300b fx:anySlot ?sf300b .
            ?sf300b
                xyz:code "b" ;
                rdf:_1 ?illustrative_content_raw .

            # Strip trailing cataloging punctuation such as ";", but not "."
            # — the AACR2 abbreviations here ("ill.", "col. ill.") end in one.
            BIND(
              REPLACE(?illustrative_content_raw, "[\\s:;/]+$", "")
              AS ?illustrative_content_x
            )

            # A handful of records carry a $b that is punctuation only (a bare
            # ";"), which strips to "". Drop it: every value is emitted now, and
            # a bound "" is truthy under the template's {{ with }}, so it would
            # render an empty "Illustrative content" row.
            FILTER(?illustrative_content_x != "")
          }

          OPTIONAL {
            # Re-derive the 300 datafield from the record (rather than reuse the
            # ?df300 bound in the extent OPTIONAL above): if a record has no 300 at
            # all, reusing an unbound ?df300 turns `fx:anySlot` into an unbound-
            # subject scan that grabs a stray $c from elsewhere (a bogus dimensions
            # on a record with no 300). Anchoring on ?record keeps it record-scoped.
            ?record fx:anySlot ?df300c .
            ?df300c a marc:datafield ; xyz:tag "300" .
            ?df300c fx:anySlot ?sf300c .
            ?sf300c
                xyz:code "c" ;
                rdf:_1 ?dimensions_raw .

            BIND(
              REPLACE(?dimensions_raw, "[\\s.;:/]+$", "")
              AS ?dimensions_x
            )
          }

          OPTIONAL {
            ?record fx:anySlot ?df250 .
            ?df250
                a marc:datafield ;
                xyz:tag "250" .

            ?df250 fx:anySlot ?sf250a .
            ?sf250a
                xyz:code "a" ;
                rdf:_1 ?edition_raw .

            BIND(
                REPLACE(?edition_raw, "[\\s.;:/]+$", "")
                AS ?edition_x
            )
          }

          OPTIONAL {
            ?record fx:anySlot ?df520 .
            ?df520
                a marc:datafield ;
                xyz:tag "520" .

            ?df520 fx:anySlot ?sf520a .
            ?sf520a
                xyz:code "a" ;
                rdf:_1 ?summary_raw .

            BIND(
                REPLACE(?summary_raw, "[\\s]+$", "")
                AS ?summary_x
            )
          }

          # Creator fields are OPTIONAL: the records with no 100/110/111/700/
          # 710/711 field still yield a row carrying canonical_key + the 001 number.
          OPTIONAL {

          # creator/contributor fields: personal (100/700), corporate (110/710),
          # meeting (111/711). 6xx (subjects) and 791 (acquisition funds) excluded.
          #
          # The tag test is wrapped in its own group so it prunes *here*. A bare
          # FILTER in this group would be a group filter, which SPARQL evaluates
          # after the whole group — i.e. after the four subfield OPTIONALs below —
          # so all 143,271 datafields carrying a $a would be pushed through those
          # nested-loop joins instead of the 10,943 creator ones. Same answers,
          # twice the runtime (see docs/QUERY-PERFORMANCE.md).
          {
            ?record fx:anySlot ?df .
            ?df a marc:datafield ; xyz:tag ?ctag .
            FILTER(?ctag IN ("100", "110", "111", "700", "710", "711"))
          }

          #binds the contribution type based on the tag of the datafield. 100, 110, and 111 are considered primary contributions, while 700, 710, and 711 are considered secondary contributions.
          BIND(
            IF(?ctag IN ("100", "110", "111"),
            bflc:PrimaryContribution,
            bf:Contribution
            ) AS ?contributionType
            )

          # $a — name. Strip trailing cataloguing punctuation.
          ?df fx:anySlot ?sfa .
          ?sfa xyz:code "a" ; rdf:_1 ?name_raw .
          BIND(REPLACE(?name_raw, "[\\s.,;:/]+$", "") AS ?name_x)

          # $e — relator term (role). A creator field may carry several; each
          # becomes its own group below so every role survives. Lower-cased to
          # match the relator lookup table (MARC enters these terms lower-case).
          OPTIONAL {
            ?df fx:anySlot ?sfe .
            ?sfe xyz:code "e" ; rdf:_1 ?role_raw .
            BIND(LCASE(REPLACE(?role_raw, "[\\s.,;:/]+$", "")) AS ?role_term)
          }

          # $1 — real-world-object URI. Prefer VIAF, else ISNI. Strip the leaked
          # trailing "." (see docs/MARC-RECORDS.md: 58% of $1 are corrupted this way).
          OPTIONAL {
            ?df fx:anySlot ?sfv .
            ?sfv xyz:code "1" ; rdf:_1 ?rwo_v .
            FILTER(CONTAINS(STR(?rwo_v), "viaf.org"))
            BIND(REPLACE(?rwo_v, "\\.$", "") AS ?viaf_x)
          }
          OPTIONAL {
            ?df fx:anySlot ?sfi .
            ?sfi xyz:code "1" ; rdf:_1 ?rwo_i .
            FILTER(CONTAINS(STR(?rwo_i), "isni.org"))
            BIND(REPLACE(?rwo_i, "\\.$", "") AS ?isni_x)
          }

          # $0 — LC name-authority URI. Keep just the local id, used to mint a
          # stable URI when the creator has no real-world-object URI.
          OPTIONAL {
            ?df fx:anySlot ?sf0 .
            ?sf0 xyz:code "0" ; rdf:_1 ?lc_0 .
            BIND(REPLACE(REPLACE(?lc_0, "\\.$", ""), "^.*/", "") AS ?lc_id_x)
          }
          }  # end OPTIONAL wrapping the creator fields
          }  # end inner per-record SERVICE
        }  # end archive-listing SERVICE
      }
      GROUP BY ?canonical_key ?df ?ctag ?role_term ?contributionType
               ?illustrative_content_x
               ?language041_x
    }

    # Convert the MARC language code to the corresponding LC language URI.
    BIND(
      IF(
        BOUND(?language_code),
        IRI(CONCAT(
          "http://id.loc.gov/vocabulary/languages/",
          ?language_code
        )),
        ?sentinel
      )
      AS ?marc_language
    )

    OPTIONAL {
      VALUES (?language_code_lookup ?language_label) {
        ("eng" "English")
        ("spa" "Spanish")
        ("ger" "German")
        ("fre" "French")
        ("und" "Undetermined")
        ("ita" "Italian")
        ("por" "Portuguese")
        ("zxx" "No linguistic content")
        ("dut" "Dutch")
        ("swe" "Swedish")
        ("jpn" "Japanese")
        ("mul" "Multiple languages")
        ("ara" "Arabic")
        ("pol" "Polish")
        ("cze" "Czech")
        ("per" "Persian")
        ("rus" "Russian")
        ("lat" "Latin")
        ("cat" "Catalan")
        ("hrv" "Croatian")
        ("dan" "Danish")
        ("kor" "Korean")
        ("yid" "Yiddish")
        ("heb" "Hebrew")
        ("urd" "Urdu")
        ("gle" "Irish")
        ("gre" "Greek")
        ("nor" "Norwegian")
        ("ice" "Icelandic")
        ("nah" "Nahuatl")
        ("zap" "Zapotec")
      }
      FILTER(?language_code_lookup = ?language_code)
    }

    # Additional languages present in MARC 041 $a.
    BIND(
      IF(
        BOUND(?language041_code),
        IRI(CONCAT(
          "http://id.loc.gov/vocabulary/languages/",
          ?language041_code
        )),
        ?sentinel
      )
      AS ?language041
    )

    OPTIONAL {
      VALUES (?language041_lookup ?language041_label) {
        ("eng" "English")
        ("spa" "Spanish")
        ("ger" "German")
        ("fre" "French")
        ("und" "Undetermined")
        ("ita" "Italian")
        ("por" "Portuguese")
        ("zxx" "No linguistic content")
        ("dut" "Dutch")
        ("swe" "Swedish")
        ("jpn" "Japanese")
        ("mul" "Multiple languages")
        ("ara" "Arabic")
        ("pol" "Polish")
        ("cze" "Czech")
        ("per" "Persian")
        ("rus" "Russian")
        ("lat" "Latin")
        ("cat" "Catalan")
        ("hrv" "Croatian")
        ("dan" "Danish")
        ("kor" "Korean")
        ("yid" "Yiddish")
        ("heb" "Hebrew")
        ("urd" "Urdu")
        ("gle" "Irish")
        ("gre" "Greek")
        ("nor" "Norwegian")
        ("ice" "Icelandic")
        ("nah" "Nahuatl")
        ("zap" "Zapotec")

        ("chi" "Chinese")
        ("myn" "Mayan languages")
        ("pan" "Panjabi")
        ("nav" "Navajo")
        ("cpe" "Creoles and pidgins, English-based")
        ("wel" "Welsh")
        ("hun" "Hungarian")
        ("bul" "Bulgarian")
        ("fin" "Finnish")
        ("slv" "Slovenian")
        ("hit" "Hittite")
        ("mao" "Maori")
        ("oto" "Otomian languages")
        ("vie" "Vietnamese")
        ("fil" "Filipino")
      }
      FILTER(?language041_lookup = ?language041_code)
    }

    # WorldCat link + OCLC identifier, from the 001 number sampled above. Extract
    # the first run of digits (dropping the on/ocn/ocm prefix, any trailing suffix
    # such as "wcm"/"wcmasp", and leading zeros), then guard: only treat the 001
    # as an OCLC number when it carries an OCLC prefix (on/ocn/ocm) or that digit
    # run is at most 10 digits. A longer bare 001 is a local system id (e.g. an
    # Ex Libris Alma MMS id), not an OCLC number, so a worldcat.org/oclc/ link
    # minted from it would 404 (#51). Both ?worldcat_url and ?bookOCLCNum stay
    # unbound (guarded) for a non-OCLC 001.
    BIND(REPLACE(REPLACE(?control_number, "^\\D*(\\d+).*$", "$1"), "^0+", "") AS ?oclc_raw)
    BIND(
      IF(REGEX(?control_number, "^(on|ocn|ocm)", "i") || REGEX(?oclc_raw, "^[0-9]{1,10}$"),
         ?oclc_raw, ?sentinel)
      AS ?oclc_number
    )
    BIND(IF(BOUND(?oclc_number), IRI(CONCAT("https://www.worldcat.org/oclc/", ?oclc_number)), ?sentinel) AS ?worldcat_url)

    # Use the real-world-object URI (VIAF, else ISNI) as the creator's identity;
    # only mint an ab:creator/ URI when no such URI exists, keyed off the LC
    # authority id when present, otherwise a slug of the name.
    BIND(COALESCE(?viaf, ?isni) AS ?rwo)
    BIND(REPLACE(REPLACE(LCASE(?creator_name), "[^a-z0-9]+", "-"), "(^-)|(-$)", "") AS ?name_slug)
    BIND(COALESCE(?lc_id, ?name_slug) AS ?creator_key)
    BIND(IF(BOUND(?rwo), IRI(?rwo), fx:entity(ab:, "creator/", ?creator_key)) AS ?creator)

    # Map the relator term to its LC relator URI. The lookup binds its own key
    # variable (?relator_term) and joins via FILTER rather than sharing
    # ?role_term directly: a shared variable would match every row of the table
    # when ?role_term is unbound (creator field with no $e), exploding into all
    # relators. Terms without a confident code (e.g. "sponsoring body", "poet")
    # fall back to a minted ab:role/ URI so no role is lost. ?roleConcept stays
    # unbound when the creator field has no $e.
    OPTIONAL {
      VALUES (?relator_term ?relator) {
        ("artist"                                       <http://id.loc.gov/vocabulary/relators/art>)
        ("author"                                       <http://id.loc.gov/vocabulary/relators/aut>)
        ("publisher"                                    <http://id.loc.gov/vocabulary/relators/pbl>)
        ("photographer"                                 <http://id.loc.gov/vocabulary/relators/pht>)
        ("book artist"                                  <http://id.loc.gov/vocabulary/relators/bka>)
        ("book designer"                                <http://id.loc.gov/vocabulary/relators/bkd>)
        ("illustrator"                                  <http://id.loc.gov/vocabulary/relators/ill>)
        ("editor"                                       <http://id.loc.gov/vocabulary/relators/edt>)
        ("printer"                                      <http://id.loc.gov/vocabulary/relators/prt>)
        ("translator"                                   <http://id.loc.gov/vocabulary/relators/trl>)
        ("host institution"                             <http://id.loc.gov/vocabulary/relators/his>)
        ("papermaker"                                   <http://id.loc.gov/vocabulary/relators/ppm>)
        ("issuing body"                                 <http://id.loc.gov/vocabulary/relators/isb>)
        ("contributor"                                  <http://id.loc.gov/vocabulary/relators/ctb>)
        ("writer of added text"                         <http://id.loc.gov/vocabulary/relators/wat>)
        ("interviewer"                                  <http://id.loc.gov/vocabulary/relators/ivr>)
        ("interviewee"                                  <http://id.loc.gov/vocabulary/relators/ive>)
        ("binder"                                       <http://id.loc.gov/vocabulary/relators/bnd>)
        ("designer"                                     <http://id.loc.gov/vocabulary/relators/dsr>)
        ("composer"                                     <http://id.loc.gov/vocabulary/relators/cmp>)
        ("compiler"                                     <http://id.loc.gov/vocabulary/relators/com>)
        ("book producer"                                <http://id.loc.gov/vocabulary/relators/bkp>)
        ("writer of introduction"                       <http://id.loc.gov/vocabulary/relators/win>)
        ("writer of added commentary"                   <http://id.loc.gov/vocabulary/relators/wac>)
        ("writer of supplementary textual content"      <http://id.loc.gov/vocabulary/relators/wst>)
        ("curator"                                      <http://id.loc.gov/vocabulary/relators/cur>)
        ("distributor"                                  <http://id.loc.gov/vocabulary/relators/dst>)
        ("author of introduction, etc"                  <http://id.loc.gov/vocabulary/relators/aui>)
        ("author of afterword, colophon, etc"           <http://id.loc.gov/vocabulary/relators/aft>)
        ("typographer"                                  <http://id.loc.gov/vocabulary/relators/tyg>)
        ("sponsor"                                      <http://id.loc.gov/vocabulary/relators/spn>)
        ("researcher"                                   <http://id.loc.gov/vocabulary/relators/res>)
        ("printmaker"                                   <http://id.loc.gov/vocabulary/relators/prm>)
        ("organizer"                                    <http://id.loc.gov/vocabulary/relators/orm>)
        ("honouree"                                     <http://id.loc.gov/vocabulary/relators/hnr>)
        ("creator"                                      <http://id.loc.gov/vocabulary/relators/cre>)
        ("cover designer"                               <http://id.loc.gov/vocabulary/relators/cov>)
        ("collector"                                    <http://id.loc.gov/vocabulary/relators/col>)
      }
      FILTER(?relator_term = ?role_term)
    }

    BIND(REPLACE(REPLACE(?role_term, "[^a-z0-9]+", "-"), "(^-)|(-$)", "") AS ?role_slug)
    BIND(COALESCE(?relator, fx:entity(ab:, "role/", ?role_slug)) AS ?roleConcept)

    # Per-book MARC sub-resource URIs. The MARC now joins on ?canonical_key, so it
    # is bound inside this OPTIONAL and the sub-resources are minted inline (each
    # guarded so a book with no MARC match emits no dangling node). For a book
    # that never matched MARC the whole OPTIONAL contributes nothing, so these
    # stay unbound and no triple is emitted.
    BIND(IF(BOUND(?oclc_number), fx:entity(ab:, "item/", ?canonical_key, "/oclc"), ?sentinel) AS ?bookOCLCNum)
    BIND(IF(BOUND(?extent), fx:entity(ab:, "item/", ?canonical_key, "/extent"), ?sentinel) AS ?bookExtent)
    BIND(IF(BOUND(?summary), fx:entity(ab:, "item/", ?canonical_key, "/summary"), ?sentinel) AS ?bookSummary)
    BIND(IF(BOUND(?creator_key), fx:entity(ab:, "item/", ?canonical_key, "/contribution/", ?creator_key), ?sentinel) AS ?contribution)
  }

  # Construction & production methods (#86). Attach ab:constructedUsing by
  # joining each book's genre/technique/material heading occurrences
  # (sources/construction/occurrences.csv, one row per book heading, keyed by the
  # canonical key) to the curated decisions (sources/construction/decisions.csv)
  # on the cluster key -- the same reconciliation unit the SKOS scheme itself is
  # built from (sources/construction/build-scheme.rq). Only include=y clusters
  # carry a conceptId, so a book emits one edge per distinct construction concept
  # its headings map to. The concept URI is minted exactly as in the scheme
  # (ab:construction/<conceptId>), so it resolves against sources/construction-
  # methods.ttl, which Fuseki loads alongside this graph. Kept OPTIONAL so a book
  # with no construction heading emits nothing.
  #
  # Both inputs are small committed CSVs -- the MARC was traversed once, offline,
  # to produce occurrences.csv (see mine-occurrences.rq) -- so this is a cheap
  # CSV-to-CSV join, not a second pass over the archive. Wrapped in a sub-SELECT
  # so it is evaluated once and hash-joined to the outer books on ?canonical_key.
  # decisions is listed first (the ~60 include=y rows drive the join) so ARQ's
  # linear `sequence` re-reads only the occurrences CSV per decision, not vice
  # versa.
  OPTIONAL {
    SELECT DISTINCT ?canonical_key ?constructionConcept WHERE {
      SERVICE <x-sparql-anything:location=sources/construction/decisions.csv,csv.headers=true> {
        ?dRow xyz:cluster    ?cCluster ;
              xyz:include    "y" ;
              xyz:conceptId  ?cConceptId .
      }
      SERVICE <x-sparql-anything:location=sources/construction/occurrences.csv,csv.headers=true> {
        ?oRow xyz:canonicalKey ?canonical_key ;
              xyz:cluster       ?cCluster .
      }
      BIND(fx:entity(ab:, "construction/", ?cConceptId) AS ?constructionConcept)
    }
  }

  # Subject terms (#105). Attach ab:hasSubject exactly as ab:constructedUsing
  # above, but from the parallel subjects pipeline: join each book's 650/651
  # subject-heading occurrences (sources/subjects/occurrences.csv, keyed by the
  # canonical key) to the curated decisions (sources/subjects/decisions.csv) on
  # the shared cluster key, and mint ab:subject/<conceptId> -- the same URI the
  # SKOS scheme defines (sources/subjects/build-scheme.rq), so it resolves against
  # sources/subject-terms.ttl, which Fuseki loads alongside this graph. The two
  # SERVICEs bind the same ?sCluster so ARQ hash-joins them. Kept OPTIONAL so a
  # book with no subject heading emits nothing.
  OPTIONAL {
    SELECT DISTINCT ?canonical_key ?subjectConcept WHERE {
      SERVICE <x-sparql-anything:location=sources/subjects/decisions.csv,csv.headers=true> {
        ?sdRow xyz:cluster    ?sCluster ;
               xyz:include    "y" ;
               xyz:conceptId  ?sConceptId .
      }
      SERVICE <x-sparql-anything:location=sources/subjects/occurrences.csv,csv.headers=true> {
        ?soRow xyz:canonicalKey ?canonical_key ;
               xyz:cluster       ?sCluster .
      }
      BIND(fx:entity(ab:, "subject/", ?sConceptId) AS ?subjectConcept)
    }
  }
}
