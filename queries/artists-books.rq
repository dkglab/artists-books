PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx: <http://sparql.xyz/facade-x/ns/>
PREFIX fxe: <http://sparql.xyz/facade-x/engine/>
PREFIX ab: <https://dkglab.github.io/ns/artists-books/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX bf: <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc: <http://id.loc.gov/ontologies/bflc/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX marc: <http://www.loc.gov/MARC21/slim#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX madsrdf: <http://www.loc.gov/mads/rdf/v1#>

CONSTRUCT {
  ?book a ab:ArtistsBook ;
    rdfs:label ?title ;
    bf:title ?bookTitle ;
    bf:title ?variantTitle ;
    ab:itemKey ?canonical_key ;
    ab:heldBySloane ?held_flag ;
    bf:contribution ?contribution ;
    bf:contribution ?zoteroContribution ;
    bf:language ?marc_language ;
    bf:language ?language041 ;
    bf:language ?zoteroLanguage ;
    bf:note ?languageNote ;
    bf:note ?originalLanguageNote ;
    bf:extent ?bookExtent ;
    bf:illustrativeContent ?illustrative_content ;
    bf:dimensions ?dimensions ;
    bf:editionStatement ?edition ;
    bf:summary ?bookSummary ;
    bf:relatedTo ?relatedWork ;
    bf:relation ?relation ;
    bf:identifiedBy ?bookISBN ;
    bf:identifiedBy ?bookOCLCNum ;
    foaf:isPrimaryTopicOf ?worldcat_url ;
    ab:constructedUsing ?constructionConcept ;
    bf:genreForm ?genreFormConcept ;
    ab:hasSubject ?subjectConcept ;
    ab:sourceImage ?sourceImage ;
    ab:representativeImage ?thumbnail ;
    ab:imagesAt ?imagesAt ;
    .


  # Title (#11, #20): the main title as a bf:Title node, read from MARC 245
  # where the book has a record and from the Zotero title otherwise. The same
  # composed string is the book's rdfs:label, which the site displays.
  ?bookTitle a bf:Title ;
    rdfs:label ?title ;
    bf:mainTitle ?main_title ;
    bf:subtitle ?subtitle ;
    bf:partNumber ?part_number ;
    bf:partName ?part_name ;
    .

  # Variant titles from MARC 246 (#20): cover, spine, parallel, portion ...
  ?variantTitle a bf:VariantTitle ;
    rdfs:label ?variant_label ;
    bf:mainTitle ?variant_main ;
    bf:subtitle ?variant_subtitle ;
    bf:partNumber ?variant_part_number ;
    bf:partName ?variant_part_name ;
    bf:variantType ?variant_type ;
    .

  ?bookISBN a bf:Identifier ;
    rdf:value ?ISBN ;
    bf:source wd:Q33057 ; # ISBN
    .

  ?bookOCLCNum a bf:Local ;
    rdf:value ?oclc_number ;
    bf:source wd:Q846596 ; # Worldcat
    .

  ?bookExtent a bf:Extent ;
    rdfs:label ?extent ; # Extent
    .

  ?contribution a ?contributionType ;
    bf:agent ?creator ;
    bf:role ?roleConcept ;
    .

  ?roleConcept a bf:Role ;
    rdfs:label ?role_term ;
    .

  ?creator a bf:Agent ;
    rdfs:label ?creator_label ;
    .

  # Zotero-creator fallback (#170): books with no MARC creator field.
  ?zoteroContribution a ?zoteroContributionType ;
    bf:agent ?zoteroCreator ;
    bf:role ?zoteroRole ;
    .

  ?zoteroCreator a bf:Agent ;
    rdfs:label ?zotero_creator_label ;
    .

  ?zoteroRole a bf:Role ;
    rdfs:label ?zotero_role_term ;
    .

  ?bookSummary
    a bf:Summary ;
    rdfs:label ?summary .

  ?marc_language a bf:Language .

  ?language041 a bf:Language .

  ?originalLanguage a bf:Language .

  ?labelledLanguage rdfs:label ?language_label .

  ?languageNote a bf:Note ;
    rdfs:label ?language_note ;
  .

  ?originalLanguageNote
    a bf:Note ;
    bf:language ?originalLanguage ;
  .

  ?sourceImage a ab:SourceImage ;
    schema:about ?book ;
    ab:iiifPath ?src_iiif_path ;
    schema:contentUrl ?src_url ;
    schema:encodingFormat "image/jpeg" ;
    ab:pixelWidth ?src_width ;
    ab:pixelHeight ?src_height ;
    ab:imageViewType ?srcViewConcept ;
    .

  ?thumbnail a ab:Thumbnail ;
    schema:about ?book ;
    ab:iiifPath ?thumb_iiif_path ;
    schema:contentUrl ?thumb_url ;
    schema:encodingFormat "image/jpeg" ;
    ab:pixelWidth ?thumb_width ;
    ab:pixelHeight ?thumb_height ;
    ab:imageViewType ?thumbViewConcept ;
    .

  ?relatedWorkContribution a bflc:PrimaryContribution ;
    bf:agent ?creator ;
    .

  # The kind of relationship, where the field states it in $i (#32): a
  # bf:Relation from the book to the related work, its bf:relationship the
  # RDA designator ("Container of (work)", "Inspired by").
  ?relation a bf:Relation ;
    bf:relationship ?relationshipConcept ;
    bf:associatedResource ?relatedWork ;
    .

  ?relationshipConcept a bf:Relationship ;
    rdfs:label ?relationship_label ;
    .

  ?relatedWork
    a bf:Work ;
    rdfs:label ?related_title ;
    bf:contribution ?relatedWorkContribution ;
    madsrdf:isIdentifiedByAuthority ?relatedWorkAuthority ;
    schema:sameAs ?relatedWorkRwo ;
    .

}
WHERE {
  SERVICE <x-sparql-anything:location=sources/artists-books.csv> {
    # Facade-X configuration for CSV data
    fxe:properties
      fxe:csv.headers "true" ;  # create xyz:header properties
      fxe:csv.null-string  "" ; # treat empty strings as null values
      .

    # For each row in the canonical artists'-book list (#82: lib 1 ∪ 2 ∪ 3,
    # deduplicated to one node per work). Only canonicalKey is required here:
    # the Zotero title is just the fallback for a book with no MARC 245, and a
    # book needs one or the other (the FILTER at the end of the query). Eight
    # rows have an empty Zotero title, and before #20 they silently dropped out.
    # The publication statement (publisher, date, place) is not read here: it
    # is queries/publications.rq, shared with the reference works (#21).
    ?bookRow xyz:canonicalKey ?canonical_key .
    OPTIONAL { ?bookRow xyz:title ?zotero_title }

    # Mint new book URIs from the canonical key. Citations (sources/citations.ttl)
    # target these same item/<canonicalKey> URIs.
    BIND(fx:entity(ab:, "item/", ?canonical_key) AS ?book)

    # Sloane holdings flag (#82): the ~1,300 works UNC physically holds (and has
    # images of). Non-held rows carry an empty cell -> null -> ?held_raw unbound
    # -> no triple.
    OPTIONAL { ?bookRow xyz:held ?held_raw }
    BIND(IF(BOUND(?held_raw), true, ?sentinel) AS ?held_flag)

    OPTIONAL { ?bookRow xyz:language ?zotero_language }
    OPTIONAL { ?bookRow xyz:ISBN ?ISBN }
    BIND(fx:entity(ab:, "item/", ?canonical_key, "/identifier") AS ?isbnNode)
    BIND(IF(BOUND(?ISBN), ?isbnNode, ?sentinel) AS ?bookISBN)
  }

  # Creators come from the full MARC records (sources/marc/artists-books-marc/),
  # which carry authoritative names plus real-world-object URIs (VIAF/ISNI in
  # $1) and LC name-authority URIs ($0). Since the canonical re-harvest (#84) each
  # record's synthetic 999 $a carries the *canonical* key, so the MARC joins the
  # book directly on ?canonical_key. A book with no MARC record simply gets no
  # enrichment.
  #
  # Kept OPTIONAL so books without a MARC record still emit.
  OPTIONAL {
    # One row per creator field, carrying just its $a name: who the field names
    # is decided corpus-wide, not here (#170) -- see the agents.csv join below.
    #
    # ?illustrative_content_x is a *grouping key*, not a SAMPLE: unlike extent /
    # dimensions / edition — of which a book has exactly one — a record may
    # legitimately carry several 300 $b values (multi-part items list one per
    # volume or format), and all of them belong in the graph. Grouping on it
    # yields one row per (creator field, illustrative content) pair; the extra
    # rows re-assert identical contribution triples, which collapse in RDF.
    {
      SELECT ?canonical_key ?df ?ctag ?role_term ?contributionType
             (?illustrative_content_x AS ?illustrative_content)
             (?language041_x AS ?language041_code)
             (?original_language_x AS ?original_language_code)
             (SAMPLE(?control_number_raw) AS ?control_number)
             (SAMPLE(?language_code_x) AS ?language_code)
             (SAMPLE(?language_note_x) AS ?language_note)
             (SAMPLE(?extent_x) AS ?extent)
             (SAMPLE(?dimensions_x) AS ?dimensions)
             (SAMPLE(?edition_x) AS ?edition)
             (SAMPLE(?summary_x) AS ?summary)
             (SAMPLE(?related_title_x) AS ?related_title)
             (SAMPLE(?name_title_x) AS ?name_title)
             (SAMPLE(?relationship_x) AS ?relationship_label)
             (SAMPLE(?work_authority_x) AS ?work_authority)
             (SAMPLE(?work_rwo_x) AS ?work_rwo)
             (SAMPLE(?images_at_x) AS ?images_at)
             (SAMPLE(?marc_title_x) AS ?marc_title)
             (SAMPLE(?main_title_x) AS ?marc_main_title)
             (SAMPLE(?subtitle_x) AS ?subtitle)
             (SAMPLE(?part_number_x) AS ?part_number)
             (SAMPLE(?part_name_x) AS ?part_name)
             (SAMPLE(?variant_label_x) AS ?variant_label)
             (SAMPLE(?variant_main_x) AS ?variant_main)
             (SAMPLE(?variant_subtitle_x) AS ?variant_subtitle)
             (SAMPLE(?variant_part_number_x) AS ?variant_part_number)
             (SAMPLE(?variant_part_name_x) AS ?variant_part_name)
             (SAMPLE(?variant_type_x) AS ?variant_type)
             (SAMPLE(?name_x)  AS ?creator_name)
      WHERE {
        SERVICE <x-sparql-anything:location=sources/marc/artists-books-marc/> {
          # Per-record MARC directory (#81): one MARCXML document per record. The
          # outer folder read lists the files (fxe:archive.matches); the inner
          # SERVICE triplifies just that one record (fxe:location ?file) and
          # joins to the CSV row on the record's own 999 $a —
          # the key is read from the record data, not the filename. Each file is
          # triplified once (per-record traversal still uses fx:anySlot, not a
          # variable predicate — docs/QUERY-PERFORMANCE.md).
          fxe:properties fxe:archive.matches ".*\\.xml" .
          ?folder fx:anySlot ?file .

          SERVICE <x-sparql-anything:> {
            fxe:properties
              fxe:location ?file ;
              fxe:media-type "application/xml" .

          # For each MARC record
          ?record a marc:record .

          # 999 $a — the canonical key stamped onto each record at harvest (#84),
          # to join directly with the canonical CSV query above.
          ?record fx:anySlot ?f999 .
          ?f999 a marc:datafield ; xyz:tag "999" .
          ?f999 fx:anySlot ?sf999a .
          ?sf999a xyz:code "a" ; rdf:_1 ?canonical_key .

          # OCLC number from the 001 control field. 001 is a marc:controlfield,
          # so its value is on rdf:_1, not a subfield.
          #
          # OPTIONAL because not every record has one: records synthesized from a
          # non-MARC source (the eHive harvest of the Visual Studies Workshop
          # collection, #99) deliberately carry no 001, because eHive's object id
          # is not a catalogue control number and the OCLC guard below would
          # happily mint a worldcat.org link from a 6-digit one. Matching 001 as a
          # required pattern would drop the *whole* MARC contribution for such a
          # record -- creator, extent and summary along with the OCLC.
          OPTIONAL {
            ?record fx:anySlot ?cf001 .
            ?cf001 a marc:controlfield ; xyz:tag "001" ; rdf:_1 ?control_number_raw .
          }

          # Primary language from MARC 008 positions 35-37.
          OPTIONAL {
            ?record fx:anySlot ?cf008 .
            ?cf008
              a marc:controlfield ;
              xyz:tag "008" ;
              rdf:_1 ?fixed_fields .
            BIND(SUBSTR(?fixed_fields, 36, 3) AS ?language_code_raw)

            # Only a real three-letter code: blanks and fill characters ("|||")
            # mean none, and a short 008 (the synthesized eHive/UW records)
            # yields "" from SUBSTR, which would mint .../languages/ with no code.
            FILTER(REGEX(?language_code_raw, "^[A-Za-z]{3}$"))

            BIND(LCASE(?language_code_raw) AS ?language_code_x)
          }

          # Languages present from MARC 041 $a.
          # Older records may concatenate multiple 3-character MARC language
          # codes in one subfield (e.g. "engfreger"), while newer records repeat $a.
          OPTIONAL {
            ?record fx:anySlot ?df041 .
            ?df041
                a marc:datafield ;
                xyz:tag "041" .

            ?df041 fx:anySlot ?sf041a .
            ?sf041a
                xyz:code "a" ;
                rdf:_1 ?language041_raw .

            BIND(LCASE(STR(?language041_raw)) AS ?language041_value)

            # Only process values composed entirely of complete 3-character codes.
            # This intentionally excludes the malformed "enger" value.
            FILTER(REGEX(?language041_value, "^([a-z]{3})+$"))

            VALUES ?language_offset { 1 4 7 10 13 16 }

            BIND(
              SUBSTR(?language041_value, ?language_offset, 3)
              AS ?language041_s
            )

            FILTER(STRLEN(?language041_s) = 3)
            # "jap" is MARC's discontinued code for Japanese.
            BIND(IF(?language041_s = "jap", "jpn", ?language041_s) AS ?language041_x)
          }

          # Original language from MARC 041 $h.
          OPTIONAL {
            ?record fx:anySlot ?df041h .
            ?df041h
                a marc:datafield ;
                xyz:tag "041" .

            ?df041h fx:anySlot ?sf041h .
            ?sf041h
                xyz:code "h" ;
                rdf:_1 ?original_language_raw .

            BIND(
              LCASE(STR(?original_language_raw))
              AS ?original_language_value
            )

            FILTER(REGEX(?original_language_value, "^([a-z]{3})+$"))

            VALUES ?original_language_offset { 1 4 7 10 13 16 }

            BIND(
              SUBSTR(?original_language_value, ?original_language_offset, 3)
              AS ?original_language_s
            )

            FILTER(STRLEN(?original_language_s) = 3)
            # "jap" is MARC's discontinued code for Japanese.
            BIND(IF(?original_language_s = "jap", "jpn", ?original_language_s) AS ?original_language_x)
          }

          # Extent from MARC 300 $a. This describes the physical scope/form
          # of the item, e.g. "64 unnumbered pages" or "1 portfolio".
          OPTIONAL {
            ?record fx:anySlot ?df300 .
            ?df300 a marc:datafield ; xyz:tag "300" .

            ?df300 fx:anySlot ?sf300a .
            ?sf300a xyz:code "a" ; rdf:_1 ?extent_raw .

            # Strip trailing cataloging punctuation such as ":".
            BIND(REPLACE(?extent_raw, "^\\s+|[\\s:;/]+$", "") AS ?extent_x)
          }

          # Illustrative content from MARC 300 $b, such as
          # "illustrations" or "color illustrations".
          OPTIONAL {
            # Anchor the traversal independently on the record, as with 300 $c.
            # Reusing ?df300 could cause an unbound-subject scan when 300 $a
            # is absent but 300 $b is present.
            ?record fx:anySlot ?df300b .
            ?df300b a marc:datafield ; xyz:tag "300" .

            ?df300b fx:anySlot ?sf300b .
            ?sf300b
                xyz:code "b" ;
                rdf:_1 ?illustrative_content_raw .

            # Strip trailing cataloging punctuation such as ";", but not "."
            # — the AACR2 abbreviations here ("ill.", "col. ill.") end in one.
            BIND(
              REPLACE(?illustrative_content_raw, "^\\s+|[\\s:;/]+$", "")
              AS ?illustrative_content_x
            )

            # A handful of records carry a $b that is punctuation only (a bare
            # ";"), which strips to "". Drop it: every value is emitted now, and
            # a bound "" is truthy under the template's {{ with }}, so it would
            # render an empty "Illustrative content" row.
            FILTER(?illustrative_content_x != "")
          }

          OPTIONAL {
            # Re-derive the 300 datafield from the record (rather than reuse the
            # ?df300 bound in the extent OPTIONAL above): if a record has no 300 at
            # all, reusing an unbound ?df300 turns `fx:anySlot` into an unbound-
            # subject scan that grabs a stray $c from elsewhere (a bogus dimensions
            # on a record with no 300). Anchoring on ?record keeps it record-scoped.
            ?record fx:anySlot ?df300c .
            ?df300c a marc:datafield ; xyz:tag "300" .
            ?df300c fx:anySlot ?sf300c .
            ?sf300c
                xyz:code "c" ;
                rdf:_1 ?dimensions_raw .

            BIND(
              REPLACE(?dimensions_raw, "^\\s+|[\\s.;:/]+$", "")
              AS ?dimensions_x
            )
          }

          OPTIONAL {
            ?record fx:anySlot ?df250 .
            ?df250
                a marc:datafield ;
                xyz:tag "250" .

            ?df250 fx:anySlot ?sf250a .
            ?sf250a
                xyz:code "a" ;
                rdf:_1 ?edition_raw .

            BIND(
                REPLACE(?edition_raw, "^\\s+|[\\s.;:/]+$", "")
                AS ?edition_x
            )
          }

          OPTIONAL {
            ?record fx:anySlot ?df520 .
            ?df520
                a marc:datafield ;
                xyz:tag "520" .

            ?df520 fx:anySlot ?sf520a .
            ?sf520a
                xyz:code "a" ;
                rdf:_1 ?summary_raw .

            BIND(
                REPLACE(?summary_raw, "^\\s+|[\\s]+$", "")
                AS ?summary_x
            )
          }

          # Human-readable language note from MARC 546 $a.
          OPTIONAL {
            ?record fx:anySlot ?df546 .
            ?df546
                a marc:datafield ;
                xyz:tag "546" .

            ?df546 fx:anySlot ?sf546a .
            ?sf546a
                xyz:code "a" ;
                rdf:_1 ?language_note_raw .

            BIND(
              REPLACE(?language_note_raw, "^\\s+|[\\s]+$", "")
              AS ?language_note_x
            )
          }

          # Title from MARC 245 (#11, #20): $a title proper, $b remainder of
          # title (subtitle, parallel title), $n/$p part number/name. $c (the
          # statement of responsibility), $h (the medium) and the rest are not
          # title. Every record has exactly one 245. Subfield positions can't be
          # read without a variable predicate (docs/QUERY-PERFORMANCE.md), so the
          # parts are composed in the fixed order $a $b $n $p, which is right for
          # every record in the corpus: the only four 245s carrying both $b and
          # $n/$p put $b first, and the 246s never carry both. Each part is stripped of the ISBD punctuation that ends it
          # (the " :" before $b, the " /" before $c, a closing ".") -- except an
          # ellipsis -- and rejoined with ". " before a part and ": " before $b
          # (" = " or "; " when that is what $a ended with: a parallel title, or
          # a second title by the same author). 45 records put the "=" at the
          # start of $b instead, so leading punctuation is stripped from $b/$n/$p
          # too, and a part that is nothing but punctuation is dropped.
          OPTIONAL {
            ?record fx:anySlot ?df245 .
            ?df245 a marc:datafield ; xyz:tag "245" .
            ?df245 fx:anySlot ?sf245a .
            ?sf245a xyz:code "a" ; rdf:_1 ?t245a_raw .
            OPTIONAL { ?df245 fx:anySlot ?sf245b . ?sf245b xyz:code "b" ; rdf:_1 ?t245b_raw . }
            OPTIONAL { ?df245 fx:anySlot ?sf245n . ?sf245n xyz:code "n" ; rdf:_1 ?t245n_raw . }
            OPTIONAL { ?df245 fx:anySlot ?sf245p . ?sf245p xyz:code "p" ; rdf:_1 ?t245p_raw . }

            BIND(REPLACE(?t245a_raw, "^\\s+|[\\s,;:/=]+$", "") AS ?t245a_s)
            BIND(IF(REGEX(?t245a_s, "\\.\\.\\.$"), ?t245a_s, REPLACE(?t245a_s, "\\.$", "")) AS ?main_title_x)
            BIND(REPLACE(?t245b_raw, "^[\\s,;:/=]+|[\\s,;:/=]+$", "") AS ?t245b_s0)
            BIND(IF(?t245b_s0 = "", ?sentinel, ?t245b_s0) AS ?t245b_s)
            BIND(IF(REGEX(?t245b_s, "\\.\\.\\.$"), ?t245b_s, REPLACE(?t245b_s, "\\.$", "")) AS ?subtitle_x)
            BIND(REPLACE(?t245n_raw, "^[\\s,;:/=]+|[\\s,;:/=]+$", "") AS ?t245n_s0)
            BIND(IF(?t245n_s0 = "", ?sentinel, ?t245n_s0) AS ?t245n_s)
            BIND(IF(REGEX(?t245n_s, "\\.\\.\\.$"), ?t245n_s, REPLACE(?t245n_s, "\\.$", "")) AS ?part_number_x)
            BIND(REPLACE(?t245p_raw, "^[\\s,;:/=]+|[\\s,;:/=]+$", "") AS ?t245p_s0)
            BIND(IF(?t245p_s0 = "", ?sentinel, ?t245p_s0) AS ?t245p_s)
            BIND(IF(REGEX(?t245p_s, "\\.\\.\\.$"), ?t245p_s, REPLACE(?t245p_s, "\\.$", "")) AS ?part_name_x)

            BIND(IF(REGEX(?t245a_raw, "=\\s*$") || REGEX(COALESCE(?t245b_raw, ""), "^\\s*="), " = ", IF(REGEX(?t245a_raw, ";\\s*$"), "; ", ": ")) AS ?t245b_sep)
            BIND(CONCAT(
              ?main_title_x,
              COALESCE(CONCAT(?t245b_sep, ?subtitle_x), ""),
              COALESCE(CONCAT(". ", ?part_number_x), ""),
              COALESCE(CONCAT(IF(BOUND(?part_number_x), ", ", ". "), ?part_name_x), "")
            ) AS ?marc_title_x)
          }

          # Creator fields are OPTIONAL: the records with no 100/110/111/700/
          # 710/711 field still yield a row carrying canonical_key + the 001 number.
          OPTIONAL {

          # creator/contributor fields: personal (100/700), corporate (110/710),
          # meeting (111/711). 6xx (subjects) and 791 (acquisition funds) excluded.
          #
          # The tag test is wrapped in its own group so it prunes *here*. A bare
          # FILTER in this group would be a group filter, which SPARQL evaluates
          # after the whole group — i.e. after the four subfield OPTIONALs below —
          # so all 143,271 datafields carrying a $a would be pushed through those
          # nested-loop joins instead of the 10,943 creator ones. Same answers,
          # twice the runtime (see docs/QUERY-PERFORMANCE.md).
          #
          # A field with a $t is a name/title added entry for a related *work*
          # (#32), read by the related-work branch below. Unless its ind2 is 2
          # it names a work the book derives from (based on, adapted from,
          # inspired by), whose creator made only that work, so it is not
          # credited here. ind2 2 is an analytical entry -- the book *contains*
          # the work (a monograph's own "Works. Selections", a songbook's
          # songs) -- so its creator made part of the book and keeps the credit.
          {
            {
              ?record fx:anySlot ?df .
              ?df a marc:datafield ; xyz:tag ?ctag .
              FILTER(?ctag IN ("100", "110", "111", "700", "710", "711"))
              FILTER NOT EXISTS {
                ?df fx:anySlot ?sft . ?sft xyz:code "t" .
                FILTER NOT EXISTS { ?df xyz:ind2 "2" }
              }
            }

          #binds the contribution type based on the tag of the datafield. 100, 110, and 111 are considered primary contributions, while 700, 710, and 711 are considered secondary contributions.
          BIND(
            IF(?ctag IN ("100", "110", "111"),
            bflc:PrimaryContribution,
            bf:Contribution
            ) AS ?contributionType
            )

          # $a — name. Strip trailing cataloguing punctuation.
          ?df fx:anySlot ?sfa .
          ?sfa xyz:code "a" ; rdf:_1 ?name_raw .
          BIND(REPLACE(?name_raw, "^\\s+|[\\s.,;:/]+$", "") AS ?name_x)

          # $e — relator term (role). A creator field may carry several; each
          # becomes its own group below so every role survives. Lower-cased to
          # match the relator lookup table (MARC enters these terms lower-case).
          OPTIONAL {
            ?df fx:anySlot ?sfe .
            ?sfe xyz:code "e" ; rdf:_1 ?role_raw .
            BIND(LCASE(REPLACE(?role_raw, "^\\s+|[\\s.,;:/]+$", "")) AS ?role_term)
          }

          }  # end creator branch
          UNION
          {
            # Related titles from MARC 740 (#32): one row per 740 field, carrying
            # ?df but none of the creator variables, so the GROUP BY below gives
            # each field its own group. Trailing cataloguing punctuation is
            # stripped as for the other MARC fields -- except from $a when a $n
            # follows, where "Tabe." + "#11." reads correctly as "Tabe. #11".
            ?record fx:anySlot ?df .
            ?df a marc:datafield ; xyz:tag "740" .

            ?df fx:anySlot ?sf740a .
            ?sf740a xyz:code "a" ; rdf:_1 ?related_title_a .

            OPTIONAL {
              ?df fx:anySlot ?sf740n .
              ?sf740n xyz:code "n" ; rdf:_1 ?related_title_n .
            }

            BIND(
              IF(
                BOUND(?related_title_n),
                CONCAT(
                  REPLACE(?related_title_a, "^\\s+|\\s+$", ""),
                  " ",
                  REPLACE(?related_title_n, "^\\s+|[\\s.,;:/]+$", "")
                ),
                REPLACE(?related_title_a, "^\\s+|[\\s.,;:/]+$", "")
              )
              AS ?related_title_x
            )
          }  # end related-title branch
          UNION
          {
            # Related works from MARC 730 uniform titles (#32): one row per
            # field, grouped on its ?df like the 740s. In this collection they
            # are mostly the serial a book was issued in ("Journal of artists'
            # books. No. 35 (Supplement)"), source texts (Bible, Aesop) and
            # newspapers used as material. The title is $a, $n and $p, each
            # after ". " as in a uniform title; $l/$s/$f/$k describe the
            # expression, not the work, and are left out. $p can repeat
            # ("Bible. O.T. Job XXXVIII"), so its first and second occurrence
            # are read by subfield position (as in publications.rq: STRAFTER on
            # the slot IRI, since fx:cardinal fails inside this SERVICE); no
            # field here has three. Trailing punctuation is stripped from each
            # part, except the period of a closing initialism ("O.T.").
            ?record fx:anySlot ?df .
            ?df a marc:datafield ; xyz:tag "730" .

            ?df fx:anySlot ?sf730a .
            ?sf730a xyz:code "a" ; rdf:_1 ?ut730a_raw .
            OPTIONAL { ?df fx:anySlot ?sf730n . ?sf730n xyz:code "n" ; rdf:_1 ?ut730n_raw . }
            # $i relationship designator ("Translation of:"), minus its colon.
            OPTIONAL {
              ?df fx:anySlot ?sf730i . ?sf730i xyz:code "i" ; rdf:_1 ?ut730i_raw .
              BIND(REPLACE(?ut730i_raw, "^\\s+|[\\s:]+$", "") AS ?relationship_x)
            }

            # The work's identifiers (#32): $0 its LC name-title / uniform-title
            # authority, $1 its real-world-object URI (VIAF, or an LC Hub). Read
            # only from a field with no $l or $s: those make it an entry for an
            # *expression* (a translation, a version), which LC authorizes
            # separately -- "Cendrars. Prose du Transsibérien. English" -- while
            # this node stands for the work, its title being read without them.
            OPTIONAL {
              ?df fx:anySlot ?sfut0 . ?sfut0 xyz:code "0" ; rdf:_1 ?ut_id0_raw .
              BIND(REPLACE(?ut_id0_raw, "^\\s+|[\\s.]+$", "") AS ?work_authority_x)
              FILTER(STRSTARTS(?work_authority_x, "http://id.loc.gov/authorities/"))
              FILTER NOT EXISTS { ?df fx:anySlot ?sfutx0 . ?sfutx0 xyz:code ?utx0 . FILTER(?utx0 IN ("l", "s")) }
            }
            OPTIONAL {
              ?df fx:anySlot ?sfut1 . ?sfut1 xyz:code "1" ; rdf:_1 ?ut_id1_raw .
              BIND(REPLACE(?ut_id1_raw, "^\\s+|[\\s.]+$", "") AS ?work_rwo_x)
              FILTER(REGEX(?work_rwo_x, "^https?://"))
              FILTER NOT EXISTS { ?df fx:anySlot ?sfutx1 . ?sfutx1 xyz:code ?utx1 . FILTER(?utx1 IN ("l", "s")) }
            }
            OPTIONAL {
              ?df fx:anySlot ?sf730p . ?sf730p xyz:code "p" ; rdf:_1 ?ut730p_raw .
              ?df ?slot730p ?sf730p .
              BIND(xsd:integer(STRAFTER(STR(?slot730p), "#_")) AS ?pos730p)
              FILTER NOT EXISTS {
                ?df fx:anySlot ?sf730e . ?sf730e xyz:code "p" . ?df ?slot730e ?sf730e .
                FILTER(xsd:integer(STRAFTER(STR(?slot730e), "#_")) < ?pos730p)
              }
            }
            OPTIONAL {
              ?df fx:anySlot ?sf730q . ?sf730q xyz:code "p" ; rdf:_1 ?ut730q_raw .
              ?df ?slot730q ?sf730q .
              FILTER(xsd:integer(STRAFTER(STR(?slot730q), "#_")) > ?pos730p)
            }

            BIND(REPLACE(?ut730a_raw, "^\\s+|[\\s,;:/]+$", "") AS ?ut730a_s)
            BIND(REPLACE(?ut730n_raw, "^\\s+|[\\s,;:/]+$", "") AS ?ut730n_s)
            BIND(REPLACE(?ut730p_raw, "^\\s+|[\\s,;:/]+$", "") AS ?ut730p_s)
            BIND(REPLACE(?ut730q_raw, "^\\s+|[\\s,;:/]+$", "") AS ?ut730q_s)
            BIND(CONCAT(
              IF(REGEX(?ut730a_s, "(^|[\\s.])[A-Z]\\.$"), ?ut730a_s, REPLACE(?ut730a_s, "\\.$", "")),
              COALESCE(CONCAT(". ", IF(REGEX(?ut730n_s, "(^|[\\s.])[A-Z]\\.$"), ?ut730n_s, REPLACE(?ut730n_s, "\\.$", ""))), ""),
              COALESCE(CONCAT(". ", IF(REGEX(?ut730p_s, "(^|[\\s.])[A-Z]\\.$"), ?ut730p_s, REPLACE(?ut730p_s, "\\.$", ""))), ""),
              COALESCE(CONCAT(IF(REGEX(?ut730p_s, "\\.$"), " ", ". "), IF(REGEX(?ut730q_s, "(^|[\\s.])[A-Z]\\.$"), ?ut730q_s, REPLACE(?ut730q_s, "\\.$", ""))), "")
            ) AS ?related_title_x)
            FILTER(?related_title_x != "")
          }  # end uniform-title branch
          UNION
          {
            # Related works from name/title added entries (#32): a 700/710/711
            # with a $t names a work the book is related to (inspired by, an
            # adaptation of, a container of ...) and, in $a, that work's
            # creator. One row per field, grouped on its ?df like the 740s. The
            # $a is read exactly as the creator branch reads it, so ?ctag +
            # ?creator_name find the creator's agent in agents.csv -- but no
            # contribution to the *book* is minted for it (see ?contribution
            # below); the agent is credited on the related work instead. The
            # $t alone is the title: $l/$s/$f/$k describe the expression.
            ?record fx:anySlot ?df .
            ?df a marc:datafield ; xyz:tag ?ctag .
            FILTER(?ctag IN ("700", "710", "711"))

            ?df fx:anySlot ?sfta .
            ?sfta xyz:code "a" ; rdf:_1 ?name_raw .
            BIND(REPLACE(?name_raw, "^\\s+|[\\s.,;:/]+$", "") AS ?name_x)

            ?df fx:anySlot ?sftt .
            ?sftt xyz:code "t" ; rdf:_1 ?name_title_raw .

            # $i relationship designator ("Container of (work):", "Inspired
            # by :"), minus its colon and the space some records put before it.
            OPTIONAL {
              ?df fx:anySlot ?sfti . ?sfti xyz:code "i" ; rdf:_1 ?name_title_i_raw .
              BIND(REPLACE(?name_title_i_raw, "^\\s+|[\\s:]+$", "") AS ?relationship_x)
            }

            # The work's identifiers (#32): $0 its LC name-title / uniform-title
            # authority, $1 its real-world-object URI (VIAF, or an LC Hub). Read
            # only from a field with no $l or $s: those make it an entry for an
            # *expression* (a translation, a version), which LC authorizes
            # separately -- "Cendrars. Prose du Transsibérien. English" -- while
            # this node stands for the work, its title being read without them.
            OPTIONAL {
              ?df fx:anySlot ?sfnt0 . ?sfnt0 xyz:code "0" ; rdf:_1 ?nt_id0_raw .
              BIND(REPLACE(?nt_id0_raw, "^\\s+|[\\s.]+$", "") AS ?work_authority_x)
              FILTER(STRSTARTS(?work_authority_x, "http://id.loc.gov/authorities/"))
              FILTER NOT EXISTS { ?df fx:anySlot ?sfntx0 . ?sfntx0 xyz:code ?ntx0 . FILTER(?ntx0 IN ("l", "s")) }
            }
            OPTIONAL {
              ?df fx:anySlot ?sfnt1 . ?sfnt1 xyz:code "1" ; rdf:_1 ?nt_id1_raw .
              BIND(REPLACE(?nt_id1_raw, "^\\s+|[\\s.]+$", "") AS ?work_rwo_x)
              FILTER(REGEX(?work_rwo_x, "^https?://"))
              FILTER NOT EXISTS { ?df fx:anySlot ?sfntx1 . ?sfntx1 xyz:code ?ntx1 . FILTER(?ntx1 IN ("l", "s")) }
            }
            BIND(REPLACE(?name_title_raw, "^\\s+|[\\s.,;:/]+$", "") AS ?related_title_x)
            FILTER(?related_title_x != "")
            BIND(true AS ?name_title_x)
          }  # end name/title related-work branch
          UNION
          {
            # Where images of the book can be found, from MARC 856 $u (#17): one
            # row per 856 field, grouped on its ?df like the 740s above. Only
            # links on an allowlist of hosts are kept -- the ones that, when
            # audited (2026-11-21), led to images of the book itself: a full PDF
            # scan (Visual Studies Workshop, the Met's library) or a per-item
            # image viewer (SCAD's Luna, LIBRARYSTACK, UW-Madison's digital
            # collections). The other non-Artstor 856s are tables of contents,
            # blurbs, catalogue records or paywalled proxies, and the
            # library.artstor.org links duplicate the IIIF images from #9.
            # Matching on the host rather than on the indicators or $z/$3
            # wording is deliberate: those links are mostly 4 0, not 4 2, and the
            # notes are inconsistent.
            ?record fx:anySlot ?df .
            ?df a marc:datafield ; xyz:tag "856" .

            ?df fx:anySlot ?sf856u .
            ?sf856u xyz:code "u" ; rdf:_1 ?images_at_raw .
            BIND(REPLACE(?images_at_raw, "^\\s+|\\s+$", "") AS ?images_at_x)
            FILTER(REGEX(?images_at_x, "^https?://((www\\.)?wsworkshop\\.org/artist_books/|scad\\.lunaimaging\\.com/|(www\\.)?librarystack\\.org/|libmma\\.s3-website-us-east-1\\.amazonaws\\.com/|digital\\.library\\.wisc\\.edu/)"))
          }  # end images-at branch
          UNION
          {
            # Variant titles from MARC 246 (#20): one row per field, grouped on
            # its ?df like the 740s. The parts are cleaned and composed as for
            # the 245 above. The kind of variant comes from the second
            # indicator; when that is blank the cataloguer spells it out in $i
            # ("Title on cover:", "Umschlagt."), which is used as-is minus its
            # closing colon. ind2 3 ("other title") and a blank with no $i say
            # nothing about the kind, so they emit no bf:variantType.
            ?record fx:anySlot ?df .
            ?df a marc:datafield ; xyz:tag "246" .
            OPTIONAL { ?df xyz:ind2 ?v246_ind2_raw }

            ?df fx:anySlot ?sf246a .
            ?sf246a xyz:code "a" ; rdf:_1 ?v246a_raw .
            OPTIONAL { ?df fx:anySlot ?sf246b . ?sf246b xyz:code "b" ; rdf:_1 ?v246b_raw . }
            OPTIONAL { ?df fx:anySlot ?sf246n . ?sf246n xyz:code "n" ; rdf:_1 ?v246n_raw . }
            OPTIONAL { ?df fx:anySlot ?sf246p . ?sf246p xyz:code "p" ; rdf:_1 ?v246p_raw . }
            OPTIONAL { ?df fx:anySlot ?sf246i . ?sf246i xyz:code "i" ; rdf:_1 ?v246i_raw . }

            BIND(REPLACE(?v246a_raw, "^\\s+|[\\s,;:/=]+$", "") AS ?v246a_s)
            BIND(IF(REGEX(?v246a_s, "\\.\\.\\.$"), ?v246a_s, REPLACE(?v246a_s, "\\.$", "")) AS ?variant_main_x)
            BIND(REPLACE(?v246b_raw, "^[\\s,;:/=]+|[\\s,;:/=]+$", "") AS ?v246b_s0)
            BIND(IF(?v246b_s0 = "", ?sentinel, ?v246b_s0) AS ?v246b_s)
            BIND(IF(REGEX(?v246b_s, "\\.\\.\\.$"), ?v246b_s, REPLACE(?v246b_s, "\\.$", "")) AS ?variant_subtitle_x)
            BIND(REPLACE(?v246n_raw, "^[\\s,;:/=]+|[\\s,;:/=]+$", "") AS ?v246n_s0)
            BIND(IF(?v246n_s0 = "", ?sentinel, ?v246n_s0) AS ?v246n_s)
            BIND(IF(REGEX(?v246n_s, "\\.\\.\\.$"), ?v246n_s, REPLACE(?v246n_s, "\\.$", "")) AS ?variant_part_number_x)
            BIND(REPLACE(?v246p_raw, "^[\\s,;:/=]+|[\\s,;:/=]+$", "") AS ?v246p_s0)
            BIND(IF(?v246p_s0 = "", ?sentinel, ?v246p_s0) AS ?v246p_s)
            BIND(IF(REGEX(?v246p_s, "\\.\\.\\.$"), ?v246p_s, REPLACE(?v246p_s, "\\.$", "")) AS ?variant_part_name_x)

            BIND(IF(REGEX(?v246a_raw, "=\\s*$") || REGEX(COALESCE(?v246b_raw, ""), "^\\s*="), " = ", IF(REGEX(?v246a_raw, ";\\s*$"), "; ", ": ")) AS ?v246b_sep)
            BIND(CONCAT(
              ?variant_main_x,
              COALESCE(CONCAT(?v246b_sep, ?variant_subtitle_x), ""),
              COALESCE(CONCAT(". ", ?variant_part_number_x), ""),
              COALESCE(CONCAT(IF(BOUND(?variant_part_number_x), ", ", ". "), ?variant_part_name_x), "")
            ) AS ?variant_label_x)

            BIND(REPLACE(COALESCE(?v246_ind2_raw, ""), "\\s+", "") AS ?v246_ind2)
            BIND(REPLACE(?v246i_raw, "^\\s+|[\\s:]+$", "") AS ?v246i)
            BIND(
              IF(?v246_ind2 = "0", "portion",
              IF(?v246_ind2 = "1", "parallel",
              IF(?v246_ind2 = "2", "distinctive",
              IF(?v246_ind2 = "4", "cover",
              IF(?v246_ind2 = "5", "added title page",
              IF(?v246_ind2 = "6", "caption",
              IF(?v246_ind2 = "7", "running",
              IF(?v246_ind2 = "8", "spine",
              IF(?v246_ind2 = "" && COALESCE(?v246i, "") != "", ?v246i,
                 ?sentinel)))))))))
              AS ?variant_type_x
            )
            FILTER(?variant_main_x != "")
          }  # end variant-title branch
          }  # end OPTIONAL creator/related-title/images-at/variant-title extraction
        }  # end inner per-record SERVICE
      }  # end folder-listing SERVICE
      }
      GROUP BY ?canonical_key ?df ?ctag ?role_term ?contributionType
               ?illustrative_content_x
               ?language041_x
               ?original_language_x
    }

    # Convert the MARC language code to the corresponding LC language URI.
    BIND(
      IF(
        BOUND(?language_code),
        IRI(CONCAT(
          "http://id.loc.gov/vocabulary/languages/",
          ?language_code
        )),
        ?sentinel
      )
      AS ?marc_language
    )

    # Display labels for every language code the 008/041 reads emit, from one
    # table. Matching any of the row's three codes can yield up to three label
    # rows; CONSTRUCT collapses the duplicate triples. The lookup binds its own
    # key and joins by FILTER (like the relator table below) so an unbound code
    # matches nothing. A code missing here still gets its bf:language edge; the
    # site then shows the bare code.
    OPTIONAL {
      VALUES (?language_lookup ?language_label) {
        ("ara" "Arabic")
        ("ben" "Bengali")
        ("bul" "Bulgarian")
        ("cat" "Catalan")
        ("chi" "Chinese")
        ("cpe" "Creoles and pidgins, English-based")
        ("cze" "Czech")
        ("dan" "Danish")
        ("dut" "Dutch")
        ("eng" "English")
        ("fil" "Filipino")
        ("fin" "Finnish")
        ("fre" "French")
        ("ger" "German")
        ("gle" "Irish")
        ("gmh" "German, Middle High")
        ("grc" "Greek, Ancient")
        ("gre" "Greek")
        ("heb" "Hebrew")
        ("hit" "Hittite")
        ("hrv" "Croatian")
        ("hun" "Hungarian")
        ("ice" "Icelandic")
        ("ita" "Italian")
        ("jpn" "Japanese")
        ("kor" "Korean")
        ("lat" "Latin")
        ("mao" "Maori")
        ("mul" "Multiple languages")
        ("myn" "Mayan languages")
        ("nah" "Nahuatl")
        ("nav" "Navajo")
        ("nor" "Norwegian")
        ("oto" "Otomian languages")
        ("pan" "Panjabi")
        ("per" "Persian")
        ("pli" "Pali")
        ("pol" "Polish")
        ("por" "Portuguese")
        ("que" "Quechua")
        ("rus" "Russian")
        ("slv" "Slovenian")
        ("spa" "Spanish")
        ("swe" "Swedish")
        ("ton" "Tongan")
        ("tur" "Turkish")
        ("ukr" "Ukrainian")
        ("und" "Undetermined")
        ("urd" "Urdu")
        ("vie" "Vietnamese")
        ("wel" "Welsh")
        ("yid" "Yiddish")
        ("zap" "Zapotec")
        ("zxx" "No linguistic content")
      }
      FILTER(?language_lookup IN (?language_code, ?language041_code, ?original_language_code))
      BIND(IRI(CONCAT("http://id.loc.gov/vocabulary/languages/", ?language_lookup)) AS ?labelledLanguage)
    }

    # Additional languages present in MARC 041 $a.
    BIND(
      IF(
        BOUND(?language041_code),
        IRI(CONCAT(
          "http://id.loc.gov/vocabulary/languages/",
          ?language041_code
        )),
        ?sentinel
      )
      AS ?language041
    )

    # WorldCat link + OCLC identifier, from the 001 number sampled above. Extract
    # the first run of digits (dropping the on/ocn/ocm prefix, any trailing suffix
    # such as "wcm"/"wcmasp", and leading zeros), then guard: only treat the 001
    # as an OCLC number when it carries an OCLC prefix (on/ocn/ocm) or that digit
    # run is at most 10 digits. A longer bare 001 is a local system id (e.g. an
    # Ex Libris Alma MMS id), not an OCLC number, so a worldcat.org/oclc/ link
    # minted from it would 404 (#51). Both ?worldcat_url and ?bookOCLCNum stay
    # unbound (guarded) for a non-OCLC 001.
    BIND(REPLACE(REPLACE(?control_number, "^\\D*(\\d+).*$", "$1"), "^0+", "") AS ?oclc_raw)
    BIND(
      IF(REGEX(?control_number, "^(on|ocn|ocm)", "i") || REGEX(?oclc_raw, "^[0-9]{1,10}$"),
         ?oclc_raw, ?sentinel)
      AS ?oclc_number
    )
    BIND(IF(BOUND(?oclc_number), IRI(CONCAT("https://www.worldcat.org/oclc/", ?oclc_number)), ?sentinel) AS ?worldcat_url)

    # Creator identity (#170). Who a field names is resolved across the whole
    # corpus, not from the field's own $0/$1 -- how well a heading is controlled
    # depends on which catalogue the record came from, so the same person used
    # to arrive as a VIAF, an LC-id and a name-slug agent. sources/creators/
    # build.py clusters every 1xx/7xx field of both MARC directories (shared
    # ids, identical dated headings, unambiguous names, a frozen id.loc.gov
    # reconciliation and hand decisions) and writes agents.csv: one row per
    # (record, tag, $a name) with the agent's URI (VIAF, else ISNI, else
    # ab:creator/<lcId>, else ab:creator/<slug>), key and single preferred
    # label. reference-works.rq reads the same file, so a creator shared with a
    # reference work is one node.
    #
    # The join is on shared variables -- ?canonical_key ?ctag ?creator_name --
    # inside a sub-SELECT, so the CSV is triplified once and hash-joined rather
    # than re-read per creator field. ?creator_name is the very string
    # mine.py computes (the $a with trailing punctuation stripped). A record
    # with two same-tag fields sharing an $a but differing in $b/$d (e.g.
    # "Scripps College" and "Scripps College. Press") joins both agents.
    OPTIONAL {
      SELECT ?canonical_key ?ctag ?creator_name ?creator ?creator_key ?creator_label WHERE {
        SERVICE <x-sparql-anything:location=sources/creators/agents.csv,csv.headers=true> {
          ?agentRow xyz:source       "book" ;
                    xyz:canonicalKey ?canonical_key ;
                    xyz:tag          ?ctag ;
                    xyz:name         ?creator_name ;
                    xyz:agentKey     ?creator_key ;
                    xyz:agentUri     ?agent_uri ;
                    xyz:label        ?creator_label .
        }
        BIND(IRI(?agent_uri) AS ?creator)
      }
    }

    # Map the relator term to its LC relator URI. The lookup binds its own key
    # variable (?relator_term) and joins via FILTER rather than sharing
    # ?role_term directly: a shared variable would match every row of the table
    # when ?role_term is unbound (creator field with no $e), exploding into all
    # relators. Terms without a confident code (e.g. "sponsoring body", "poet")
    # fall back to a minted ab:role/ URI so no role is lost. ?roleConcept stays
    # unbound when the creator field has no $e.
    OPTIONAL {
      VALUES (?relator_term ?relator) {
        ("artist"                                       <http://id.loc.gov/vocabulary/relators/art>)
        ("author"                                       <http://id.loc.gov/vocabulary/relators/aut>)
        ("publisher"                                    <http://id.loc.gov/vocabulary/relators/pbl>)
        ("photographer"                                 <http://id.loc.gov/vocabulary/relators/pht>)
        ("book artist"                                  <http://id.loc.gov/vocabulary/relators/bka>)
        ("book designer"                                <http://id.loc.gov/vocabulary/relators/bkd>)
        ("illustrator"                                  <http://id.loc.gov/vocabulary/relators/ill>)
        ("editor"                                       <http://id.loc.gov/vocabulary/relators/edt>)
        ("printer"                                      <http://id.loc.gov/vocabulary/relators/prt>)
        ("translator"                                   <http://id.loc.gov/vocabulary/relators/trl>)
        ("host institution"                             <http://id.loc.gov/vocabulary/relators/his>)
        ("papermaker"                                   <http://id.loc.gov/vocabulary/relators/ppm>)
        ("issuing body"                                 <http://id.loc.gov/vocabulary/relators/isb>)
        ("contributor"                                  <http://id.loc.gov/vocabulary/relators/ctb>)
        ("writer of added text"                         <http://id.loc.gov/vocabulary/relators/wat>)
        ("interviewer"                                  <http://id.loc.gov/vocabulary/relators/ivr>)
        ("interviewee"                                  <http://id.loc.gov/vocabulary/relators/ive>)
        ("binder"                                       <http://id.loc.gov/vocabulary/relators/bnd>)
        ("designer"                                     <http://id.loc.gov/vocabulary/relators/dsr>)
        ("composer"                                     <http://id.loc.gov/vocabulary/relators/cmp>)
        ("compiler"                                     <http://id.loc.gov/vocabulary/relators/com>)
        ("book producer"                                <http://id.loc.gov/vocabulary/relators/bkp>)
        ("writer of introduction"                       <http://id.loc.gov/vocabulary/relators/win>)
        ("writer of added commentary"                   <http://id.loc.gov/vocabulary/relators/wac>)
        ("writer of supplementary textual content"      <http://id.loc.gov/vocabulary/relators/wst>)
        ("curator"                                      <http://id.loc.gov/vocabulary/relators/cur>)
        ("distributor"                                  <http://id.loc.gov/vocabulary/relators/dst>)
        ("author of introduction, etc"                  <http://id.loc.gov/vocabulary/relators/aui>)
        ("author of afterword, colophon, etc"           <http://id.loc.gov/vocabulary/relators/aft>)
        ("typographer"                                  <http://id.loc.gov/vocabulary/relators/tyg>)
        ("sponsor"                                      <http://id.loc.gov/vocabulary/relators/spn>)
        ("researcher"                                   <http://id.loc.gov/vocabulary/relators/res>)
        ("printmaker"                                   <http://id.loc.gov/vocabulary/relators/prm>)
        ("organizer"                                    <http://id.loc.gov/vocabulary/relators/orm>)
        ("honouree"                                     <http://id.loc.gov/vocabulary/relators/hnr>)
        ("creator"                                      <http://id.loc.gov/vocabulary/relators/cre>)
        ("cover designer"                               <http://id.loc.gov/vocabulary/relators/cov>)
        ("collector"                                    <http://id.loc.gov/vocabulary/relators/col>)
      }
      FILTER(?relator_term = ?role_term)
    }

    BIND(REPLACE(REPLACE(?role_term, "[^a-z0-9]+", "-"), "(^-)|(-$)", "") AS ?role_slug)
    BIND(COALESCE(?relator, fx:entity(ab:, "role/", ?role_slug)) AS ?roleConcept)

    # Per-book MARC sub-resource URIs. The MARC now joins on ?canonical_key, so it
    # is bound inside this OPTIONAL and the sub-resources are minted inline (each
    # guarded so a book with no MARC match emits no dangling node). For a book
    # that never matched MARC the whole OPTIONAL contributes nothing, so these
    # stay unbound and no triple is emitted.
    BIND(IF(BOUND(?oclc_number), fx:entity(ab:, "item/", ?canonical_key, "/oclc"), ?sentinel) AS ?bookOCLCNum)
    BIND(IF(BOUND(?extent), fx:entity(ab:, "item/", ?canonical_key, "/extent"), ?sentinel) AS ?bookExtent)
    BIND(IF(BOUND(?language_note), fx:entity(ab:, "item/", ?canonical_key, "/language-note"), ?sentinel) AS ?languageNote)
    BIND(IF(BOUND(?summary), fx:entity(ab:, "item/", ?canonical_key, "/summary"), ?sentinel) AS ?bookSummary)
    BIND(IF(BOUND(?original_language_code), IRI(CONCAT("http://id.loc.gov/vocabulary/languages/", ?original_language_code)), ?sentinel) AS ?originalLanguage)
    BIND(IF(BOUND(?original_language_code), fx:entity(ab:, "item/", ?canonical_key, "/original-language"), ?sentinel) AS ?originalLanguageNote)
    # A name/title row (#32) binds a creator too: that agent made the related
    # work, so it is credited there. (A contained work's creator, ind2 2, also
    # has a creator-branch row of the same field, which credits the book.)
    # Tested on the branch's
    # own ?name_title flag, not on ?creator_name: the agents.csv join above
    # treats a row's unbound ?ctag/?creator_name as a wildcard, so a 740 or
    # 856 row can come out of it with a creator bound.
    BIND(IF(BOUND(?creator_key) && !BOUND(?name_title), fx:entity(ab:, "item/", ?canonical_key, "/contribution/", ?creator_key), ?sentinel) AS ?contribution)
    # Related works (740, 730 and 7xx name/title, #32) are deliberately scoped per
    # book and left unreconciled for now: the same title on two books is two
    # bf:Work nodes, and one matching a book already in the collection is not
    # yet linked to its item/ URI. The title is hashed rather than slugged
    # because these titles are long, punctuation-heavy and often non-Latin,
    # which a slug would mangle or collide. A name/title work hashes its
    # creator's $a in too ("name|title"), so two authors' works of one title
    # stay apart; a 740 or 730 keeps its title-only hash, so a 730 and a 740
    # of one title on one book are one work.
    BIND(IF(BOUND(?related_title), fx:entity(ab:, "item/", ?canonical_key, "/related-work/", SHA256(IF(BOUND(?name_title), CONCAT(?creator_name, "|", ?related_title), STR(?related_title)))), ?sentinel) AS ?relatedWork)
    # The relation (#32) hangs off the related work's own URI, which is already
    # per book, and is keyed by its relationship too: one work can be the
    # target of two designators (Oe's "Map" is entered both as a contained
    # work and as a contained expression), and each bf:Relation carries one.
    # The relationship concept is minted from a slug of the RDA designator,
    # qualifier included, so "Container of (work)" and "Container of
    # (expression)" stay distinct, as RDA has them.
    BIND(IF(BOUND(?relatedWork) && BOUND(?work_authority), IRI(?work_authority), ?sentinel) AS ?relatedWorkAuthority)
    BIND(IF(BOUND(?relatedWork) && BOUND(?work_rwo), IRI(?work_rwo), ?sentinel) AS ?relatedWorkRwo)
    BIND(REPLACE(REPLACE(LCASE(?relationship_label), "[^a-z0-9]+", "-"), "(^-)|(-$)", "") AS ?relationship_slug)
    BIND(IF(BOUND(?relatedWork) && BOUND(?relationship_label), IRI(CONCAT(STR(?relatedWork), "/relation/", ?relationship_slug)), ?sentinel) AS ?relation)
    BIND(IF(BOUND(?relation), fx:entity(ab:, "relationship/", ?relationship_slug), ?sentinel) AS ?relationshipConcept)
    BIND(IF(BOUND(?name_title) && BOUND(?creator_key), IRI(CONCAT(STR(?relatedWork), "/contribution/", ?creator_key)), ?sentinel) AS ?relatedWorkContribution)
    BIND(IF(BOUND(?images_at), IRI(?images_at), ?sentinel) AS ?imagesAt)
    # Variant titles (#20), scoped per book like the related works. Hashed on the
    # label *and* the kind, so a title that appears both on the cover and on the
    # spine is two nodes, each with one bf:variantType.
    BIND(IF(BOUND(?variant_label), fx:entity(ab:, "item/", ?canonical_key, "/variant-title/", SHA256(CONCAT(?variant_label, "|", COALESCE(?variant_type, "")))), ?sentinel) AS ?variantTitle)
  }

  # The title (#11, #20) comes from MARC 245 where the book has a record, and
  # falls back to the Zotero title otherwise -- whole, as the main title, since
  # Zotero does not separate the subtitle. Every row of a book's MARC match
  # carries the same 245, so this never yields two labels for one book.
  BIND(COALESCE(?marc_title, ?zotero_title) AS ?title)
  BIND(COALESCE(?marc_main_title, ?zotero_title) AS ?main_title)
  BIND(fx:entity(ab:, "item/", ?canonical_key, "/title") AS ?bookTitle)
  # A group filter, so it runs after every OPTIONAL: it only drops a book with
  # neither a MARC nor a Zotero title.
  FILTER(BOUND(?title))

  # Language falls back to the Zotero string (a plain literal) when the book's
  # MARC record carries no 008 language code -- or when the book has no MARC
  # record at all, as most non-held works don't until the harvest completes
  # (#99). Without this ~640 books would lose the language they had.
  BIND(IF(BOUND(?language_code), ?sentinel, ?zotero_language) AS ?zoteroLanguage)

  # Zotero-creator fallback (#170). A book with no MARC creator field -- most
  # often no MARC record at all -- is credited from its Zotero creators, which
  # sources/creators/build.py has already joined to the corpus-wide agents by
  # normalized name (unambiguous matches only; tag "zotero" in agents.csv). The
  # agent URI and label are the very ones the MARC path emits, so e.g. a
  # Drucker book with no MARC lands on the same agent as the catalogued ones.
  # Principal Zotero roles (artist/author/creator) become a
  # bflc:PrimaryContribution, the equivalent of a 1xx, so cards credit them.
  OPTIONAL {
    SELECT ?canonical_key ?zoteroContribution ?zoteroContributionType ?zoteroCreator
           ?zotero_creator_label ?zoteroRole ?zotero_role_term
    WHERE {
      SERVICE <x-sparql-anything:location=sources/creators/agents.csv,csv.headers=true> {
        ?zRow xyz:source       "book" ;
              xyz:tag          "zotero" ;
              xyz:canonicalKey ?canonical_key ;
              xyz:agentKey     ?z_key ;
              xyz:agentUri     ?z_uri ;
              xyz:label        ?zotero_creator_label .
        OPTIONAL { ?zRow xyz:primary  ?z_primary }
        OPTIONAL { ?zRow xyz:roleUri  ?z_role_uri }
        OPTIONAL { ?zRow xyz:roleTerm ?z_role_term }
      }
      BIND(IF(COALESCE(?z_role_term, "") != "", ?z_role_term, ?sentinel) AS ?zotero_role_term)
      BIND(IRI(?z_uri) AS ?zoteroCreator)
      # Empty cells arrive as "" (no csv.null-string here), so test the value.
      BIND(IF(COALESCE(?z_primary, "") = "y", bflc:PrimaryContribution, bf:Contribution) AS ?zoteroContributionType)
      BIND(IF(COALESCE(?z_role_uri, "") != "", IRI(?z_role_uri), ?sentinel) AS ?zoteroRole)
      BIND(fx:entity(ab:, "item/", ?canonical_key, "/contribution/", ?z_key) AS ?zoteroContribution)
    }
  }

  # Construction & production methods (#86). Attach ab:constructedUsing by
  # joining each book's genre/technique/material heading occurrences
  # (sources/construction/occurrences.csv, one row per book heading, keyed by the
  # canonical key) to the curated decisions (sources/construction/decisions.csv)
  # on the cluster key -- the same reconciliation unit the SKOS scheme itself is
  # built from (sources/construction/build-scheme.rq). Only include=y clusters
  # carry a conceptId, so a book emits one edge per distinct construction concept
  # its headings map to. The concept URI is minted exactly as in the scheme
  # (ab:construction/<conceptId>), so it resolves against sources/construction-
  # methods.ttl, which Fuseki loads alongside this graph. Kept OPTIONAL so a book
  # with no construction heading emits nothing.
  #
  # Both inputs are small committed CSVs -- the MARC was traversed once, offline,
  # to produce occurrences.csv (see mine-occurrences.rq) -- so this is a cheap
  # CSV-to-CSV join, not a second pass over the MARC. Wrapped in a sub-SELECT
  # so it is evaluated once and hash-joined to the outer books on ?canonical_key.
  # decisions is listed first (the ~60 include=y rows drive the join) so ARQ's
  # linear `sequence` re-reads only the occurrences CSV per decision, not vice
  # versa.
  #
  # Genre/form (#25) is not a separate track: it is the construction scheme's
  # genre-form category (#117), so a concept in that category also gets a
  # bf:genreForm edge, the BIBFRAME home for MARC 655 genre. Same concept URI,
  # so the site renders it once, under construction. ?noGenreForm is never
  # bound, so the IF leaves ?genreFormConcept unbound for other categories.
  OPTIONAL {
    SELECT DISTINCT ?canonical_key ?constructionConcept ?genreFormConcept WHERE {
      SERVICE <x-sparql-anything:location=sources/construction/decisions.csv,csv.headers=true> {
        ?dRow xyz:cluster    ?cCluster ;
              xyz:include    "y" ;
              xyz:conceptId  ?cConceptId ;
              xyz:category   ?cCategory .
      }
      # Subject-track occurrences are UNIONed in so a construction decision can
      # claim a 650 heading the construction pool doesn't mine (#148; see
      # sources/construction/build-scheme.rq).
      {
        SERVICE <x-sparql-anything:location=sources/construction/occurrences.csv,csv.headers=true> {
          ?oRow xyz:canonicalKey ?canonical_key ;
                xyz:cluster       ?cCluster .
        }
      } UNION {
        SERVICE <x-sparql-anything:location=sources/subjects/occurrences.csv,csv.headers=true> {
          ?oRow xyz:canonicalKey ?canonical_key ;
                xyz:cluster       ?cCluster .
        }
      }
      BIND(fx:entity(ab:, "construction/", ?cConceptId) AS ?constructionConcept)
      BIND(IF(?cCategory = "genre-form", ?constructionConcept, ?noGenreForm) AS ?genreFormConcept)
    }
  }

  # Subject terms (#105). Attach ab:hasSubject exactly as ab:constructedUsing
  # above, but from the parallel subjects pipeline: join each book's 650/651
  # subject-heading occurrences (sources/subjects/occurrences.csv, keyed by the
  # canonical key) to the curated decisions (sources/subjects/decisions.csv) on
  # the shared cluster key, and mint ab:subject/<conceptId> -- the same URI the
  # SKOS scheme defines (sources/subjects/build-scheme.rq), so it resolves against
  # sources/subject-terms.ttl, which Fuseki loads alongside this graph. The two
  # SERVICEs bind the same ?sCluster so ARQ hash-joins them. Kept OPTIONAL so a
  # book with no subject heading emits nothing.
  OPTIONAL {
    SELECT DISTINCT ?canonical_key ?subjectConcept WHERE {
      SERVICE <x-sparql-anything:location=sources/subjects/decisions.csv,csv.headers=true> {
        ?sdRow xyz:cluster    ?sCluster ;
               xyz:include    "y" ;
               xyz:conceptId  ?sConceptId .
      }
      SERVICE <x-sparql-anything:location=sources/subjects/occurrences.csv,csv.headers=true> {
        ?soRow xyz:canonicalKey ?canonical_key ;
               xyz:cluster       ?sCluster .
      }
      BIND(fx:entity(ab:, "subject/", ?sConceptId) AS ?subjectConcept)
    }
  }

  # Images (#9). Attach the JSTOR IIIF imagery by joining the canonical key to a
  # Forum SSID (sources/artstor-ssid.csv), then the SSID to its image
  # (sources/ssid-media.csv). Both are small committed CSVs, so this is a cheap
  # CSV-to-CSV join; the two SERVICEs bind the same ?ssid so ARQ hash-joins them.
  # Only about 1,145 of the 7,920 books have any image at all, so both blocks are
  # OPTIONAL and every minted node hangs off a key that only binds on a match.
  #
  # status "ok" is required on both sides: nine SSIDs are access-restricted and
  # 403 at the image tier, and one crosswalk row resolved to a not-found page.
  #
  # The dimensions emitted are the *master's*, straight from the CSV, not those of
  # the derivative at schema:contentUrl -- see ab:IIIFImageNode in docs/vocab.ttl
  # for why (in short: the master's are exact and carry the same aspect ratio).
  #
  # One ab:SourceImage per SSID, keyed by SSID like the per-creator contributions
  # are keyed by creator. Four books legitimately have several -- multi-volume
  # sets and cover variants -- so the book key alone would collapse distinct
  # images onto one node and emit multi-valued paths and dimensions.
  OPTIONAL {
    SELECT DISTINCT ?canonical_key ?sourceImage ?src_iiif_path ?src_url
                    ?src_width ?src_height ?srcViewConcept
    WHERE {
      SERVICE <x-sparql-anything:location=sources/artstor-ssid.csv,csv.headers=true> {
        ?imgRow xyz:canonicalKey ?canonical_key ;
                xyz:ssid         ?ssid ;
                xyz:status       "ok" .
      }
      SERVICE <x-sparql-anything:location=sources/ssid-media.csv,csv.headers=true> {
        ?mediaRow xyz:ssid          ?ssid ;
                  xyz:status        "ok" ;
                  xyz:iiifPath      ?src_iiif_path ;
                  xyz:width         ?src_width_raw ;
                  xyz:height        ?src_height_raw ;
                  xyz:imageViewType ?src_view_raw .
      }
      BIND(fx:entity(ab:, "item/", ?canonical_key, "/image/", ?ssid) AS ?sourceImage)
      BIND(xsd:integer(?src_width_raw) AS ?src_width)
      BIND(xsd:integer(?src_height_raw) AS ?src_height)
      BIND(STRDT(CONCAT("https://www.jstor.org", ?src_iiif_path, "/full/,1200/0/default.jpg"), xsd:anyURI) AS ?src_url)

      # Normalize Forum's free-text "Image View Type" onto the three concepts in
      # sources/image-view-types.ttl, which Fuseki loads alongside this graph.
      # Thirteen spellings occur; image 1 is the cover in ~1,039 records, an
      # interior in 45, and the enclosure in the rest. Anything unrecognized
      # leaves ?src_view_slug unbound and emits no term rather than guessing.
      BIND(LCASE(?src_view_raw) AS ?src_view_lc)
      BIND(IF(STRSTARTS(?src_view_lc, "(cover") || STRSTARTS(?src_view_lc, "(front"), "cover",
           IF(STRSTARTS(?src_view_lc, "(interior"), "interior",
           IF(CONTAINS(?src_view_lc, "enclosure") || CONTAINS(?src_view_lc, "bag"), "enclosure",
              ?sentinel))) AS ?src_view_slug)
      BIND(IF(BOUND(?src_view_slug),
              fx:entity(ab:, "image-view/", ?src_view_slug), ?sentinel) AS ?srcViewConcept)
    }
  }

  # One ab:Thumbnail per book -- the representative one, so the index gets exactly
  # one row per book. Where a book has several SSIDs the lowest wins; they are all
  # covers, so there is no better discriminator than picking deterministically.
  # Both halves are self-contained sub-SELECTs joined on ?ssid afterwards, so
  # neither pushes a bound key into a SERVICE and each CSV is triplified once.
  OPTIONAL {
    SELECT ?canonical_key ?thumbnail ?thumb_iiif_path ?thumb_url
           ?thumb_width ?thumb_height ?thumbViewConcept
    WHERE {
      {
        SELECT ?canonical_key (STR(MIN(?ssid_num)) AS ?ssid) WHERE {
          SERVICE <x-sparql-anything:location=sources/artstor-ssid.csv,csv.headers=true> {
            ?anyRow xyz:canonicalKey ?canonical_key ;
                    xyz:ssid         ?any_ssid ;
                    xyz:status       "ok" .
          }
          SERVICE <x-sparql-anything:location=sources/ssid-media.csv,csv.headers=true> {
            ?anyMedia xyz:ssid   ?any_ssid ;
                      xyz:status "ok" .
          }
          BIND(xsd:integer(?any_ssid) AS ?ssid_num)
        }
        GROUP BY ?canonical_key
      }
      {
        SELECT ?ssid ?thumb_iiif_path ?thumb_width_raw ?thumb_height_raw ?thumb_view_raw WHERE {
          SERVICE <x-sparql-anything:location=sources/ssid-media.csv,csv.headers=true> {
            ?thumbRow xyz:ssid          ?ssid ;
                      xyz:status        "ok" ;
                      xyz:iiifPath      ?thumb_iiif_path ;
                      xyz:width         ?thumb_width_raw ;
                      xyz:height        ?thumb_height_raw ;
                      xyz:imageViewType ?thumb_view_raw .
          }
        }
      }
      BIND(fx:entity(ab:, "item/", ?canonical_key, "/thumbnail") AS ?thumbnail)
      BIND(xsd:integer(?thumb_width_raw) AS ?thumb_width)
      BIND(xsd:integer(?thumb_height_raw) AS ?thumb_height)
      BIND(STRDT(CONCAT("https://www.jstor.org", ?thumb_iiif_path, "/full/,300/0/default.jpg"), xsd:anyURI) AS ?thumb_url)
      BIND(LCASE(?thumb_view_raw) AS ?thumb_view_lc)
      BIND(IF(STRSTARTS(?thumb_view_lc, "(cover") || STRSTARTS(?thumb_view_lc, "(front"), "cover",
           IF(STRSTARTS(?thumb_view_lc, "(interior"), "interior",
           IF(CONTAINS(?thumb_view_lc, "enclosure") || CONTAINS(?thumb_view_lc, "bag"), "enclosure",
              ?sentinel))) AS ?thumb_view_slug)
      BIND(IF(BOUND(?thumb_view_slug),
              fx:entity(ab:, "image-view/", ?thumb_view_slug), ?sentinel) AS ?thumbViewConcept)
    }
  }
}
