PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx: <http://sparql.xyz/facade-x/ns/>
PREFIX ab: <https://dkglab.github.io/ns/artists-books/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX bf: <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc: <http://id.loc.gov/ontologies/bflc/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX marc: <http://www.loc.gov/MARC21/slim#>
PREFIX xhtml: <http://www.w3.org/1999/xhtml#>

# Reference works and the citations that link them to artists' books (#34, #42).
#
# Two independent UNION branches feed graph/reference-resources.ttl:
#
#   1. The reference-work *resource* (#34): the node + its own BIBFRAME bib
#      metadata, mirroring the shape the artists' books get in artists-books.rq
#      but typed ab:ReferenceWork and minted under reference/<itemKey>. The
#      collection is heterogeneous (151 book + 3 journalArticle + 2 webpage), so
#      ab:ReferenceWork is a subclass of schema:CreativeWork (docs/vocab.ttl). Most
#      fields come from reference-resources.csv; a basic slice of the harvested
#      MARC (sources/marc/reference-resources-marc.xml) is also read — for now just the
#      primary creator (100 $a), to demonstrate the join. The remaining
#      MARC-derived fields the artists' books carry (OCLC/WorldCat, secondary
#      creators, relator roles, identity URIs, extent/dimensions) are still
#      absent (#40/#51).
#
#   2. The *citation* (#42, moved here from artists-books.rq): each "Cited:" note
#      paragraph is a reference work citing an artist's book. The citation is now
#      anchored on the reference resource it appears in —
#      reference/<refItemKey>/citation/<abcItemKey> — rather than on the artist's
#      book. The citing reference work is resolved *live in SPARQL* by reading the
#      note HTML (sources/zotero/notes.zip) with SPARQL-Anything's archive + HTML
#      triplifiers and matching the reference title against the flattened paragraph
#      text (substring, longest wins; an <em>-exact fallback for titles below the
#      substring floor) — this replaces the old cite_match.py citation crosswalk.
#      The cited artist's book comes from the #55 ABC crosswalk, joined *inside* the
#      archive read so only in-scope note files are triplified (see
#      docs/QUERY-PERFORMANCE.md). Page-number / image-page extraction
#      (#43/#44/#15/#16) is still TODO.
CONSTRUCT {
  ?ref a ab:ReferenceWork ;
    rdfs:label ?title ;
    ab:itemKey ?item_key ;
    bf:provisionActivity ?refPublication ;
    bf:language ?language ;
    bf:identifiedBy ?refISBN ;
    bf:contribution ?refContribution ;
    .

  ?refContribution a bflc:PrimaryContribution ;
    bf:agent ?refAgent ;
    .

  ?refAgent a bf:Agent ;
    rdfs:label ?creator_name ;
    .

  ?refPublication a bf:Publication ;
    bflc:simpleAgent ?publisher ;
    bflc:simpleDate ?date ;
    bflc:simplePlace ?place ;
    .

  ?refISBN a bf:Identifier ;
    rdf:value ?ISBN ;
    bf:source wd:Q33057 ; # ISBN
    .

  ?citation a ab:Citation ;
    ab:citedBy ?citedRef ;
    ab:cites ?book ;
    rdfs:label ?citation_text ;
    .
}
WHERE {
  {
    SERVICE <x-sparql-anything:location=sources/zotero/reference-resources.csv> {
      # Facade-X configuration for CSV data
      fx:properties
        fx:csv.headers "true" ;  # create xyz:header properties
        fx:csv.null-string  "" ; # treat empty strings as null values
        .

      # For each row in reference-resources.csv. Only itemKey and title are
      # required; every other field is OPTIONAL so all 156 rows emit a node
      # (e.g. webpages/articles carry no publisher).
      ?refRow
        xyz:itemKey ?item_key ;
        xyz:title ?title ;
        .

      # Mint the reference-work URI and its publication sub-resource.
      BIND(fx:entity(ab:, "reference/", ?item_key) AS ?ref)
      BIND(fx:entity(ab:, "reference/", ?item_key, "/publication") AS ?refPublication)

      OPTIONAL { ?refRow xyz:publisher ?publisher }
      OPTIONAL {
        ?refRow xyz:date ?date_raw .
        # Strip Zotero's leading "YYYY-MM-DD " prefix from the date string.
        BIND(REPLACE(?date_raw, "^\\d{4}-\\d{2}-\\d{2} ", "") AS ?date)
      }
      OPTIONAL { ?refRow xyz:place ?place }
      OPTIONAL { ?refRow xyz:language ?language }

      OPTIONAL { ?refRow xyz:ISBN ?ISBN }
      BIND(fx:entity(ab:, "reference/", ?item_key, "/identifier") AS ?isbnNode)
      BIND(IF(BOUND(?ISBN), ?isbnNode, ?sentinel) AS ?refISBN)
    }

    # Basic MARC slice: the primary creator (100 $a) from the harvested
    # reference MARC, joined to the CSV row by the synthetic 999 $a itemKey
    # (same join the artists' books use). Kept OPTIONAL — most reference works
    # have a MARC record but only some carry a 100 main entry (edited volumes /
    # exhibition catalogs enter creators on 700/710 instead, not read yet).
    # Traversal uses fx:anySlot, not a variable predicate (see
    # docs/QUERY-PERFORMANCE.md). Name only for now — no roles / identity URIs (#46).
    OPTIONAL {
      SERVICE <x-sparql-anything:location=sources/marc/reference-resources-marc.xml> {
        ?record a marc:record .

        # 999 $a — the Zotero itemKey stamped onto each record at harvest time;
        # join to the CSV row above.
        ?record fx:anySlot ?f999 .
        ?f999 a marc:datafield ; xyz:tag "999" .
        ?f999 fx:anySlot ?sf999a .
        ?sf999a xyz:code "a" ; rdf:_1 ?item_key .

        # 100 $a — primary creator name. Strip trailing cataloguing punctuation.
        ?record fx:anySlot ?df100 .
        ?df100 a marc:datafield ; xyz:tag "100" .
        ?df100 fx:anySlot ?sf100a .
        ?sf100a xyz:code "a" ; rdf:_1 ?name_raw .
        BIND(REPLACE(?name_raw, "[\\s.,;:/]+$", "") AS ?creator_name)
      }
      BIND(fx:entity(ab:, "reference/", ?item_key, "/contribution/primary") AS ?refContribution)
      BIND(fx:entity(ab:, "reference/", ?item_key, "/agent/primary") AS ?refAgent)
    }
  }
  UNION
  {
    # Each note paragraph -> the reference work it cites. Two match paths (a nested
    # UNION); both read the paragraph's flattened text off the <p> #innerText and
    # take ?citation_text from it (byte-identical to the old crosswalk citationText).
    #
    # In BOTH paths the ABC crosswalk (#55) is joined *inside* the archive read,
    # right after listing the note files, so the expensive HTML triplifier only runs
    # on the ~194 in-scope files instead of all ~4,000 (docs/QUERY-PERFORMANCE.md).
    # The join also supplies ?abc_key (the cited lib-3 record -> ABC book) under the
    # same review gate artists-books.rq applies. The .html filename is the itemKey.
    {
      # PATH substring: a reference title (>=16 normalized chars) appears verbatim in
      # the paragraph; the longest such title wins (NOT EXISTS a longer match). The
      # 16-char floor drops generic short titles ("Artists books") that are too
      # ambiguous to auto-cite -- the review=yes rows the old crosswalk excluded.
      SERVICE <x-sparql-anything:location=sources/zotero/notes.zip> {
        fx:properties fx:archive.matches ".*\\.html" .
        ?dir fx:anySlot ?file .
        BIND(REPLACE(REPLACE(STR(?file), "^.*/", ""), "\\.html$", "") AS ?cited_key)
        SERVICE <x-sparql-anything:location=sources/abc-master-crosswalk.csv> {
          fx:properties fx:csv.headers "true" ; fx:csv.null-string "" .
          ?xwRow xyz:abcItemKey ?abc_key ; xyz:citedItemKey ?cited_key .
          OPTIONAL { ?xwRow xyz:review ?xw_review }
          FILTER(!BOUND(?xw_review) || ?xw_review != "yes")
        }
        SERVICE <x-sparql-anything:> {
          fx:properties fx:location ?file ; fx:from-archive "sources/zotero/notes.zip" ; fx:media-type "text/html" .
          ?p rdf:type xhtml:p ; <https://html.spec.whatwg.org/#innerText> ?citation_text .
        }
      }
      BIND(REPLACE(REPLACE(LCASE(?citation_text), "[^a-z0-9]+", " "), "^ +| +$", "") AS ?ntext)
      SERVICE <x-sparql-anything:location=sources/zotero/reference-resources.csv> {
        fx:properties fx:csv.headers "true" ; fx:csv.null-string "" .
        ?r xyz:itemKey ?ref_key ; xyz:title ?refTitle .
      }
      BIND(REPLACE(REPLACE(LCASE(?refTitle), "[^a-z0-9]+", " "), "^ +| +$", "") AS ?ntitle)
      BIND(STRLEN(?ntitle) AS ?tlen)
      FILTER(?tlen >= 16 && CONTAINS(?ntext, ?ntitle))
      FILTER NOT EXISTS {
        SERVICE <x-sparql-anything:location=sources/zotero/reference-resources.csv> {
          fx:properties fx:csv.headers "true" ; fx:csv.null-string "" .
          ?r2 xyz:title ?t2 .
        }
        BIND(REPLACE(REPLACE(LCASE(?t2), "[^a-z0-9]+", " "), "^ +| +$", "") AS ?nt2)
        FILTER(STRLEN(?nt2) >= 16 && STRLEN(?nt2) > ?tlen && CONTAINS(?ntext, ?nt2))
      }
    }
    UNION
    {
      # PATH <em>-exact: a reference title too short for the substring floor,
      # appearing as a complete <em> (e.g. "Conveyor."). Fires only when the
      # paragraph has NO substring match at all (>=10 chars) -- mirrors cite_match's
      # substring-then-em precedence.
      SERVICE <x-sparql-anything:location=sources/zotero/notes.zip> {
        fx:properties fx:archive.matches ".*\\.html" .
        ?dir fx:anySlot ?file .
        BIND(REPLACE(REPLACE(STR(?file), "^.*/", ""), "\\.html$", "") AS ?cited_key)
        SERVICE <x-sparql-anything:location=sources/abc-master-crosswalk.csv> {
          fx:properties fx:csv.headers "true" ; fx:csv.null-string "" .
          ?xwRow xyz:abcItemKey ?abc_key ; xyz:citedItemKey ?cited_key .
          OPTIONAL { ?xwRow xyz:review ?xw_review }
          FILTER(!BOUND(?xw_review) || ?xw_review != "yes")
        }
        SERVICE <x-sparql-anything:> {
          fx:properties fx:location ?file ; fx:from-archive "sources/zotero/notes.zip" ; fx:media-type "text/html" .
          ?p rdf:type xhtml:p ; <https://html.spec.whatwg.org/#innerText> ?citation_text .
          ?p fx:anySlot ?emEl . ?emEl rdf:type xhtml:em ; <https://html.spec.whatwg.org/#innerText> ?emRaw .
        }
      }
      BIND(REPLACE(REPLACE(LCASE(?citation_text), "[^a-z0-9]+", " "), "^ +| +$", "") AS ?ntext)
      BIND(REPLACE(REPLACE(LCASE(?emRaw), "[^a-z0-9]+", " "), "^ +| +$", "") AS ?nem)
      SERVICE <x-sparql-anything:location=sources/zotero/reference-resources.csv> {
        fx:properties fx:csv.headers "true" ; fx:csv.null-string "" .
        ?r xyz:itemKey ?ref_key ; xyz:title ?refTitle .
      }
      BIND(REPLACE(REPLACE(LCASE(?refTitle), "[^a-z0-9]+", " "), "^ +| +$", "") AS ?ntitle)
      FILTER(?nem = ?ntitle)
      FILTER NOT EXISTS {
        SERVICE <x-sparql-anything:location=sources/zotero/reference-resources.csv> {
          fx:properties fx:csv.headers "true" ; fx:csv.null-string "" .
          ?r3 xyz:title ?t3 .
        }
        BIND(REPLACE(REPLACE(LCASE(?t3), "[^a-z0-9]+", " "), "^ +| +$", "") AS ?nt3)
        FILTER(STRLEN(?nt3) >= 10 && CONTAINS(?ntext, ?nt3))
      }
    }

    # The citation is anchored on the reference resource it appears in.
    BIND(fx:entity(ab:, "reference/", ?ref_key)                         AS ?citedRef)
    BIND(fx:entity(ab:, "item/", ?abc_key)                              AS ?book)
    BIND(fx:entity(ab:, "reference/", ?ref_key, "/citation/", ?abc_key) AS ?citation)
  }
}
