PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx: <http://sparql.xyz/facade-x/ns/>
PREFIX ab: <https://dkglab.github.io/ns/artists-books/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX bf: <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc: <http://id.loc.gov/ontologies/bflc/>
PREFIX wd: <http://www.wikidata.org/entity/>
PREFIX marc: <http://www.loc.gov/MARC21/slim#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

# Reference works (#34, #42). Builds graph/reference-works.ttl.
#
# This is branch 1 of the former reference-resources.rq, split out for the
# phased graph rebuild (#82, task 4): the reference-work *resource* only. The
# citations that link reference works to artists' books are no longer built
# here — they are frozen once into sources/citations.ttl (issue #82, task 3)
# and loaded into Fuseki as-is, so the whole citation UNION branch (the
# citation/ABC crosswalk reads + the ab:Citation mint) is gone from the
# repeatable build.
#
# Each reference work is the node + its own BIBFRAME bib metadata, mirroring the
# shape the artists' books get in artists-books.rq but typed ab:ReferenceWork and
# minted under reference/<canonicalKey>. The collection is heterogeneous
# (book + journalArticle + webpage), so ab:ReferenceWork is a subclass of
# schema:CreativeWork (docs/vocab.ttl). Most fields come from
# sources/reference-works.csv (the canonical RW list from the Phase-0 dedup);
# the harvested MARC (sources/marc/reference-works-marc.zip) supplies the
# creators — every 1xx/7xx field, with relator roles and identity URIs, exactly
# as artists-books.rq reads them (#40, #46) — and the OCLC number / WorldCat
# link (001, #51). Extent/dimensions are not read from the reference MARC.
#
# The canonical RW keys are lib-3 keys, and the reference MARC was harvested
# under those same lib-3 keys, so the 999 $a join below still works directly.
CONSTRUCT {
  ?ref a ab:ReferenceWork ;
    rdfs:label ?title ;
    ab:itemKey ?canonical_key ;
    bf:provisionActivity ?refPublication ;
    bf:language ?language ;
    bf:identifiedBy ?refISBN ;
    bf:identifiedBy ?refOCLCNum ;
    foaf:isPrimaryTopicOf ?worldcat_url ;
    bf:contribution ?contribution ;
    .

  ?contribution a ?contributionType ;
    bf:agent ?creator ;
    bf:role ?roleConcept ;
    .

  ?roleConcept a bf:Role ;
    rdfs:label ?role_term ;
    .

  ?creator a bf:Agent ;
    rdfs:label ?creator_name ;
    .

  ?refPublication a bf:Publication ;
    bflc:simpleAgent ?publisher ;
    bflc:simpleDate ?date ;
    bflc:simplePlace ?place ;
    .

  ?refISBN a bf:Identifier ;
    rdf:value ?ISBN ;
    bf:source wd:Q33057 ; # ISBN
    .

  ?refOCLCNum a bf:Local ;
    rdf:value ?oclc_number ;
    bf:source wd:Q846596 ;   # WorldCat
    .
}
WHERE {
  SERVICE <x-sparql-anything:location=sources/reference-works.csv> {
    # Facade-X configuration for CSV data
    fx:properties
      fx:csv.headers "true" ;  # create xyz:header properties
      fx:csv.null-string  "" ; # treat empty strings as null values
      .

    # For each row in reference-works.csv. Only canonicalKey and title are
    # required; every other field is OPTIONAL so all rows emit a node
    # (e.g. webpages/articles carry no publisher).
    ?refRow
      xyz:canonicalKey ?canonical_key ;
      xyz:title ?title ;
      .

    # Mint the reference-work URI and its publication sub-resource.
    BIND(fx:entity(ab:, "reference/", ?canonical_key) AS ?ref)
    BIND(fx:entity(ab:, "reference/", ?canonical_key, "/publication") AS ?refPublication)

    OPTIONAL { ?refRow xyz:publisher ?publisher }
    OPTIONAL {
      ?refRow xyz:date ?date_raw .
      # Strip Zotero's leading "YYYY-MM-DD " prefix from the date string.
      BIND(REPLACE(?date_raw, "^\\d{4}-\\d{2}-\\d{2} ", "") AS ?date)
    }
    OPTIONAL { ?refRow xyz:place ?place }
    OPTIONAL { ?refRow xyz:language ?language }

    OPTIONAL { ?refRow xyz:ISBN ?ISBN }
    BIND(fx:entity(ab:, "reference/", ?canonical_key, "/identifier") AS ?isbnNode)
    BIND(IF(BOUND(?ISBN), ?isbnNode, ?sentinel) AS ?refISBN)
  }

  # Creators and the OCLC number from the harvested reference MARC. The MARC is
  # a per-record archive (#81): sources/marc/reference-works-marc.zip holds one
  # <itemKey>.xml document per record, read with SPARQL-Anything's nested
  # Archive -> XML triplifiers. The outer archive read lists the entries
  # (fx:archive.matches) and the inner SERVICE triplifies just that one record
  # (fx:location ?file + fx:from-archive), joining to the CSV row on the record's
  # own 999 $a — the key is read from the record data, not the filename.
  # Per-record traversal uses fx:anySlot (docs/QUERY-PERFORMANCE.md).
  #
  # The creator extraction is the one artists-books.rq uses, minus the fields
  # the reference works don't carry: 100/110/111 become bflc:PrimaryContribution
  # and 700/710/711 bf:Contribution (#40, #46). Many reference works are edited
  # volumes or exhibition catalogues with no 1xx main entry, whose only creators
  # are on 700/710 — reading just the 100, as this query used to, left them
  # creatorless.
  #
  # One group per (record, creator field, role): SAMPLE collapses the per-field
  # subfield matches, so each creator field yields exactly one ?creator, while a
  # field with several $e roles keeps every one of them.
  OPTIONAL {
    {
      SELECT ?canonical_key ?df ?ctag ?role_term ?contributionType
             (SAMPLE(?control_number_raw) AS ?control_number)
             (SAMPLE(?name_x)  AS ?creator_name)
             (SAMPLE(?viaf_x)  AS ?viaf)
             (SAMPLE(?isni_x)  AS ?isni)
             (SAMPLE(?lc_id_x) AS ?lc_id)
      WHERE {
        SERVICE <x-sparql-anything:location=sources/marc/reference-works-marc.zip> {
          fx:properties fx:archive.matches ".*\\.xml" .
          ?archive fx:anySlot ?file .

          SERVICE <x-sparql-anything:> {
            fx:properties
              fx:location ?file ;
              fx:from-archive "sources/marc/reference-works-marc.zip" ;
              fx:media-type "application/xml" .

            ?record a marc:record .

            # 999 $a — the canonical key stamped on each record at harvest; join
            # to the CSV row above.
            ?record fx:anySlot ?f999 .
            ?f999 a marc:datafield ; xyz:tag "999" .
            ?f999 fx:anySlot ?sf999a .
            ?sf999a xyz:code "a" ; rdf:_1 ?canonical_key .

            # OCLC number from the 001 control field (#51). OPTIONAL so a record
            # with no 001 still yields its creators. 001 is a marc:controlfield,
            # so its value is on rdf:_1, not a subfield.
            OPTIONAL {
              ?record fx:anySlot ?cf001 .
              ?cf001 a marc:controlfield ; xyz:tag "001" ; rdf:_1 ?control_number_raw .
            }

            # Creator fields are OPTIONAL: a record with no 1xx/7xx still yields
            # a row carrying canonical_key + the 001 number.
            OPTIONAL {
              # The tag test is wrapped in its own group so it prunes here,
              # before the subfield OPTIONALs below, rather than as a group
              # filter evaluated after them (docs/QUERY-PERFORMANCE.md).
              {
                ?record fx:anySlot ?df .
                ?df a marc:datafield ; xyz:tag ?ctag .
                FILTER(?ctag IN ("100", "110", "111", "700", "710", "711"))
              }

              BIND(
                IF(?ctag IN ("100", "110", "111"),
                   bflc:PrimaryContribution,
                   bf:Contribution
                ) AS ?contributionType
              )

              # $a — name. Strip trailing cataloguing punctuation.
              ?df fx:anySlot ?sfa .
              ?sfa xyz:code "a" ; rdf:_1 ?name_raw .
              BIND(REPLACE(?name_raw, "[\\s.,;:/]+$", "") AS ?name_x)

              # $e — relator term (role), lower-cased to match the lookup table.
              OPTIONAL {
                ?df fx:anySlot ?sfe .
                ?sfe xyz:code "e" ; rdf:_1 ?role_raw .
                BIND(LCASE(REPLACE(?role_raw, "[\\s.,;:/]+$", "")) AS ?role_term)
              }

              # $1 — real-world-object URI. Prefer VIAF, else ISNI. Strip the
              # leaked trailing "." (see docs/MARC-RECORDS.md).
              OPTIONAL {
                ?df fx:anySlot ?sfv .
                ?sfv xyz:code "1" ; rdf:_1 ?rwo_v .
                FILTER(CONTAINS(STR(?rwo_v), "viaf.org"))
                BIND(REPLACE(?rwo_v, "\\.$", "") AS ?viaf_x)
              }
              OPTIONAL {
                ?df fx:anySlot ?sfi .
                ?sfi xyz:code "1" ; rdf:_1 ?rwo_i .
                FILTER(CONTAINS(STR(?rwo_i), "isni.org"))
                BIND(REPLACE(?rwo_i, "\\.$", "") AS ?isni_x)
              }

              # $0 — LC name-authority URI; keep just the local id.
              OPTIONAL {
                ?df fx:anySlot ?sf0 .
                ?sf0 xyz:code "0" ; rdf:_1 ?lc_0 .
                BIND(REPLACE(REPLACE(?lc_0, "\\.$", ""), "^.*/", "") AS ?lc_id_x)
              }
            }
          }  # end inner per-record SERVICE
        }  # end archive-listing SERVICE
      }
      GROUP BY ?canonical_key ?df ?ctag ?role_term ?contributionType
    }

    # WorldCat link + OCLC identifier from the 001 number (#51). Extract the
    # first run of digits (dropping the on/ocn/ocm prefix, any trailing suffix
    # such as "wcm"/"wcmasp", and leading zeros), then guard: only treat the 001
    # as an OCLC number when it carries an OCLC prefix (on/ocn/ocm) or that digit
    # run is at most 10 digits. A longer bare 001 is a local system id (e.g. an
    # Ex Libris Alma MMS id), not an OCLC number, so a worldcat.org/oclc/ link
    # minted from it would 404. All three vars below stay unbound (guarded on
    # ?oclc_number) for a non-OCLC or absent 001, so no dangling /oclc node is minted.
    BIND(REPLACE(REPLACE(?control_number, "^\\D*(\\d+).*$", "$1"), "^0+", "") AS ?oclc_raw)
    BIND(
      IF(REGEX(?control_number, "^(on|ocn|ocm)", "i") || REGEX(?oclc_raw, "^[0-9]{1,10}$"),
         ?oclc_raw, ?sentinel)
      AS ?oclc_number
    )
    BIND(IF(BOUND(?oclc_number), IRI(CONCAT("https://www.worldcat.org/oclc/", ?oclc_number)), ?sentinel) AS ?worldcat_url)
    BIND(IF(BOUND(?oclc_number), fx:entity(ab:, "reference/", ?canonical_key, "/oclc"), ?sentinel) AS ?refOCLCNum)

    # Creator identity, minted exactly as in artists-books.rq so that a person
    # who both made a book in the collection and wrote about artists' books is
    # one node across the two graphs: the real-world-object URI (VIAF, else
    # ISNI), else ab:creator/ keyed off the LC authority id, else a name slug.
    # All unbound for a row with no creator field (?creator_name unbound).
    BIND(COALESCE(?viaf, ?isni) AS ?rwo)
    BIND(REPLACE(REPLACE(LCASE(?creator_name), "[^a-z0-9]+", "-"), "(^-)|(-$)", "") AS ?name_slug)
    BIND(COALESCE(?lc_id, ?name_slug) AS ?creator_key)
    BIND(IF(BOUND(?rwo), IRI(?rwo), fx:entity(ab:, "creator/", ?creator_key)) AS ?creator)
    BIND(IF(BOUND(?creator_key), fx:entity(ab:, "reference/", ?canonical_key, "/contribution/", ?creator_key), ?sentinel) AS ?contribution)

    # Map the relator term to its LC relator URI, falling back to a minted
    # ab:role/ URI. Joined via FILTER on a separate key variable so an unbound
    # ?role_term doesn't match every row. Keep this table in sync with the one
    # in artists-books.rq.
    OPTIONAL {
      VALUES (?relator_term ?relator) {
        ("artist"                                       <http://id.loc.gov/vocabulary/relators/art>)
        ("author"                                       <http://id.loc.gov/vocabulary/relators/aut>)
        ("publisher"                                    <http://id.loc.gov/vocabulary/relators/pbl>)
        ("photographer"                                 <http://id.loc.gov/vocabulary/relators/pht>)
        ("book artist"                                  <http://id.loc.gov/vocabulary/relators/bka>)
        ("book designer"                                <http://id.loc.gov/vocabulary/relators/bkd>)
        ("illustrator"                                  <http://id.loc.gov/vocabulary/relators/ill>)
        ("editor"                                       <http://id.loc.gov/vocabulary/relators/edt>)
        ("printer"                                      <http://id.loc.gov/vocabulary/relators/prt>)
        ("translator"                                   <http://id.loc.gov/vocabulary/relators/trl>)
        ("host institution"                             <http://id.loc.gov/vocabulary/relators/his>)
        ("papermaker"                                   <http://id.loc.gov/vocabulary/relators/ppm>)
        ("issuing body"                                 <http://id.loc.gov/vocabulary/relators/isb>)
        ("contributor"                                  <http://id.loc.gov/vocabulary/relators/ctb>)
        ("writer of added text"                         <http://id.loc.gov/vocabulary/relators/wat>)
        ("interviewer"                                  <http://id.loc.gov/vocabulary/relators/ivr>)
        ("interviewee"                                  <http://id.loc.gov/vocabulary/relators/ive>)
        ("binder"                                       <http://id.loc.gov/vocabulary/relators/bnd>)
        ("designer"                                     <http://id.loc.gov/vocabulary/relators/dsr>)
        ("composer"                                     <http://id.loc.gov/vocabulary/relators/cmp>)
        ("compiler"                                     <http://id.loc.gov/vocabulary/relators/com>)
        ("book producer"                                <http://id.loc.gov/vocabulary/relators/bkp>)
        ("writer of introduction"                       <http://id.loc.gov/vocabulary/relators/win>)
        ("writer of added commentary"                   <http://id.loc.gov/vocabulary/relators/wac>)
        ("writer of supplementary textual content"      <http://id.loc.gov/vocabulary/relators/wst>)
        ("curator"                                      <http://id.loc.gov/vocabulary/relators/cur>)
        ("distributor"                                  <http://id.loc.gov/vocabulary/relators/dst>)
        ("author of introduction, etc"                  <http://id.loc.gov/vocabulary/relators/aui>)
        ("author of afterword, colophon, etc"           <http://id.loc.gov/vocabulary/relators/aft>)
        ("typographer"                                  <http://id.loc.gov/vocabulary/relators/tyg>)
        ("sponsor"                                      <http://id.loc.gov/vocabulary/relators/spn>)
        ("researcher"                                   <http://id.loc.gov/vocabulary/relators/res>)
        ("printmaker"                                   <http://id.loc.gov/vocabulary/relators/prm>)
        ("organizer"                                    <http://id.loc.gov/vocabulary/relators/orm>)
        ("honouree"                                     <http://id.loc.gov/vocabulary/relators/hnr>)
        ("creator"                                      <http://id.loc.gov/vocabulary/relators/cre>)
        ("cover designer"                               <http://id.loc.gov/vocabulary/relators/cov>)
        ("collector"                                    <http://id.loc.gov/vocabulary/relators/col>)
      }
      FILTER(?relator_term = ?role_term)
    }

    BIND(REPLACE(REPLACE(?role_term, "[^a-z0-9]+", "-"), "(^-)|(-$)", "") AS ?role_slug)
    BIND(COALESCE(?relator, fx:entity(ab:, "role/", ?role_slug)) AS ?roleConcept)
  }
}
