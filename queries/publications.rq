PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx: <http://sparql.xyz/facade-x/ns/>
PREFIX fxe: <http://sparql.xyz/facade-x/engine/>
PREFIX ab: <https://dkglab.github.io/ns/artists-books/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX bf: <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc: <http://id.loc.gov/ontologies/bflc/>
PREFIX marc: <http://www.loc.gov/MARC21/slim#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

# The publication statement (#21) of every artists' book and reference work:
# the bf:provisionActivity edge and its bf:Publication node, for both tracks.
# One query serves both so the MARC reading, the cleanup and the Zotero
# fallback are written once. The two tracks differ only in their inputs and
# URI namespace (the VALUES table below). artists-books.rq and
# reference-works.rq no longer touch publication at all. Fuseki loads this
# graph alongside theirs and merges everything into one default graph, so the
# web queries reach ?pub bflc:simpleAgent exactly as before.
#
# A work has one bf:Publication per place/publisher group of its MARC
# statement (#196, see below): /publication for the first, /publication/2 ...
# for the rest. Most works have just the one.
#
# Each field comes from MARC where the work has a record, else from its
# Zotero row:
#   bflc:simpleAgent  the group's 264 ind2=1 (or pre-RDA 260) $b, several
#                     "; "-joined
#   bflc:simplePlace  the group's $a, likewise
#   bflc:simpleDate   008 date1 (a "1972–1974" range for types m/i/k), else
#                     the field's $c year, else an 008 decade ("196-?"), else
#                     the Zotero date; on every group. This is the date as
#                     recorded, and the one the site displays.
#   bf:date           the same date normalized to one xsd:gYear (#22), for
#                     sorting and filtering only: its first year, or a
#                     decade's first year; none for "19--" and the like
#   bf:place          the LC country of publication from 008, when it names
#                     one; on the first group only
CONSTRUCT {
  ?work bf:provisionActivity ?publication .

  ?publication a bf:Publication ;
    bflc:simpleAgent ?publisher ;
    bflc:simpleDate ?date ;
    bf:date ?normalizedDate ;
    bflc:simplePlace ?place ;
    bf:place ?placeCountry ;
    .

  ?placeCountry a bf:Place .
}
WHERE {
  # The two tracks, as an inline CSV: each track's Zotero list and MARC
  # directory. Both mint under work/ (#113); ?track only gates emission below.
  # It is a SERVICE rather than a VALUES table because SPARQL-Anything resolves a
  # variable fxe:location only when an *enclosing* SERVICE binds it (as the
  # folder listing binds ?file below). A VALUES or BIND binding is not seen,
  # and the read silently returns nothing. The same table opens the MARC pass.
  SERVICE <x-sparql-anything:> {
    fxe:properties
      fxe:content "track,csv,marc\nitem,sources/artists-books.csv,sources/marc/artists-books-marc/\nreference,sources/reference-works.csv,sources/marc/reference-works-marc/\n" ;
      fxe:media-type "text/csv" ;
      fxe:csv.headers "true" .
    ?trackRow xyz:track ?track ; xyz:csv ?csv_file .

    SERVICE <x-sparql-anything:> {
      fxe:properties
        fxe:location ?csv_file ;
        fxe:csv.headers "true" ;
        fxe:csv.null-string "" ;  # an empty cell is unbound
        .

      ?row xyz:canonicalKey ?canonical_key .
      OPTIONAL { ?row xyz:title ?zotero_title }
      OPTIONAL { ?row xyz:publisher ?zotero_publisher }
      OPTIONAL {
        ?row xyz:date ?date_raw .
        # Strip Zotero's leading "YYYY-MM-DD " prefix from the date string.
        BIND(REPLACE(?date_raw, "^\\d{4}-\\d{2}-\\d{2} ", "") AS ?zotero_date)
      }
      OPTIONAL { ?row xyz:place ?zotero_place }
    }
  }

  # Hand corrections to Zotero dates the normalizer below can't repair (#22):
  # a place in the date field, an unknown 008 date copied in, a truncated
  # century. A row replaces the work's Zotero date (an empty one removes it)
  # everywhere it is used, the year guard included. Evaluated once in a
  # sub-SELECT and hash-joined on ?canonical_key.
  OPTIONAL {
    SELECT ?canonical_key ?decision_date (true AS ?has_date_decision) WHERE {
      SERVICE <x-sparql-anything:> {
        fxe:properties
          fxe:location "sources/dates/decisions.csv" ;
          fxe:csv.headers "true" ;
          fxe:csv.null-string "" ;
          .
        ?decisionRow xyz:canonicalKey ?canonical_key .
        OPTIONAL { ?decisionRow xyz:date ?decision_date }
      }
    }
  }
  # Then the mechanical cleanup. A date that only says there is none ("N.d.",
  # "[n.d.]") is dropped, as a placeholder publisher is, so nothing is
  # displayed. A Zotero range "1981-1982" (or "1979-80", "1970-") takes the en
  # dash the 008 ranges are built with.
  BIND(IF(COALESCE(?has_date_decision, false), ?decision_date, ?zotero_date) AS ?zotero_date_d)
  BIND(IF(REGEX(?zotero_date_d, "^\\[?\\s*(n\\.?\\s*d|s\\.\\s*d|no date|undated|date of publication not identified)\\.?\\s*\\]?$", "i"),
          ?sentinel,
          REPLACE(?zotero_date_d, "^([0-9]{4})-([0-9]{2}|[0-9]{4})?$", "$1–$2"))
       AS ?zotero_date_ok)

  # The MARC publication fields, one row per (track, record). Read in its own
  # pass over the per-record directories (#81), with the same nested
  # Folder -> XML triplifiers and fx:anySlot traversal as the other two
  # queries (docs/QUERY-PERFORMANCE.md), joined on the record's own 999 $a.
  OPTIONAL {
    {
      SELECT ?track ?canonical_key ?grp_x
             (SAMPLE(?record) AS ?marc_record)
             (SAMPLE(?date008_x) AS ?marc_date008)
             (SAMPLE(?decade008_x) AS ?marc_decade008)
             (SAMPLE(?country_x) AS ?marc_country)
             (SAMPLE(?pub_year_x) AS ?marc_pub_year)
             (SAMPLE(?n_groups_x) AS ?marc_n_groups)
             (GROUP_CONCAT(DISTINCT ?pub_b_x; separator="\t") AS ?marc_publisher_t)
             (GROUP_CONCAT(DISTINCT ?pub_a_x; separator="\t") AS ?marc_place_t)
      WHERE {
       # Sorted by record order, so that each group's places (and
       # publishers) concatenate in the order the field gives them: Jena's
       # GROUP_CONCAT keeps its input order, while the SERVICE's own is
       # arbitrary.
       {
        SELECT * WHERE {
        SERVICE <x-sparql-anything:> {
          fxe:properties
            fxe:content "track,csv,marc\nitem,sources/artists-books.csv,sources/marc/artists-books-marc/\nreference,sources/reference-works.csv,sources/marc/reference-works-marc/\n" ;
            fxe:media-type "text/csv" ;
            fxe:csv.headers "true" .
          ?trackRow xyz:track ?track ; xyz:marc ?marc_dir .

        SERVICE <x-sparql-anything:> {
          fxe:properties
            fxe:location ?marc_dir ;
            fxe:archive.matches ".*\\.xml" .
          ?folder fx:anySlot ?file .

          SERVICE <x-sparql-anything:> {
            fxe:properties
              fxe:location ?file ;
              fxe:media-type "application/xml" .

            ?record a marc:record .
            ?record fx:anySlot ?f999 .
            ?f999 a marc:datafield ; xyz:tag "999" .
            ?f999 fx:anySlot ?sf999a .
            ?sf999a xyz:code "a" ; rdf:_1 ?canonical_key .

            # The publication statement: the 264 with ind2=1 (RDA: publication)
            # or, in pre-RDA records, the 260 -- each about half the corpus,
            # and only one record carries both. The other 264s (ind2 0/2/3/4:
            # production, distribution, manufacture, copyright) are not read.
            #
            # Its $a places and $b publishers fall into groups (#196): a run of
            # places, then a run of publishers, each publisher going with the
            # places before it --
            #   $a Ostfildern : $b Hatje Cantz ; $a Edmonton : $b Art Gallery
            # is two groups, "$a London ; $a New York : $b Phaidon" is one. A
            # record with several such fields (co-publishers catalogued one
            # field each, or a serial's change of publisher) has at least one
            # group per field. Each group becomes its own bf:Publication.
            #
            # Groups are found by subfield position (docs/QUERY-PERFORMANCE.md,
            # "Reading subfield order"): an $a or $b subfield *starts* a group
            # unless an earlier $a/$b of the same field continues it. Any
            # earlier one continues a $b; only an earlier $a with no $b in
            # between continues an $a. And an $a with no $b after it in its
            # field starts nothing, unless it is the field's first: in
            # "$a Madrid : $b SEACEX ; $a Barcelona" (or the misordered
            # "$b BBC $a London") the stray place stays with the publisher
            # rather than standing alone. A subfield's group number is then the
            # count of starts at or before it in record order (field position,
            # then subfield position). Both subqueries run inside the
            # per-record SERVICE, so the self-joins are over one record's small
            # graph and cost next to nothing. Positions come from the slot
            # IRIs via STRAFTER rather than fx:cardinal, which fails inside a
            # SERVICE.
            {
              SELECT (COUNT(DISTINCT ?nst) AS ?n_groups_x) WHERE {
                ?nr fx:anySlot ?ndf .
                ?ndf a marc:datafield ; xyz:tag ?ntag ; xyz:ind2 ?nind2 .
                FILTER(?ntag = "260" || (?ntag = "264" && ?nind2 = "1"))
                ?ndf fx:anySlot ?nst .
                ?nst xyz:code ?nct .
                FILTER(?nct IN ("a", "b"))
                ?ndf ?nslot ?nst .
                BIND(xsd:integer(STRAFTER(STR(?nslot), "#_")) AS ?ntp)
                FILTER(?nct = "b"
                       || EXISTS { ?ndf fx:anySlot ?nsz . ?nsz xyz:code "b" . ?ndf ?nslotz ?nsz .
                                  FILTER(xsd:integer(STRAFTER(STR(?nslotz), "#_")) > ?ntp) }
                       || NOT EXISTS { ?ndf fx:anySlot ?nsw . ?nsw xyz:code ?ncw . ?ndf ?nslotw ?nsw .
                                      FILTER(?ncw IN ("a", "b") && xsd:integer(STRAFTER(STR(?nslotw), "#_")) < ?ntp) })
                FILTER NOT EXISTS {
                  ?ndf fx:anySlot ?nsx .
                  ?nsx xyz:code ?ncx .
                  FILTER(?ncx IN ("a", "b") && (?nct = "b" || ?ncx = "a"))
                  ?ndf ?nslotx ?nsx .
                  BIND(xsd:integer(STRAFTER(STR(?nslotx), "#_")) AS ?nxp)
                  FILTER(?nxp < ?ntp)
                  FILTER NOT EXISTS {
                    ?ndf fx:anySlot ?nsy .
                    ?nsy xyz:code "b" .
                    ?ndf ?nsloty ?nsy .
                    BIND(xsd:integer(STRAFTER(STR(?nsloty), "#_")) AS ?nyp)
                    FILTER(?nxp < ?nyp && ?nyp < ?ntp)
                  }
                }
              }
            }
            # Each $a/$b, with its group number and its position in the record
            # (1000 x field slot + subfield slot). The start test is the one
            # above, repeated (a subquery can't be shared).
            #
            # Each value is cleaned and placeholders ("[s.n.]", "[publisher
            # not identified]", "S.l.") are dropped inside the OPTIONAL, so
            # dropping one only drops that value. Cleanup: "[u.a.]"/"[et al.]"
            # and square brackets (cataloguer-supplied) are removed, then the
            # ISBD punctuation that ends a subfield (" :", ",", " ;"), then
            # (publisher only) a trailing "." unless it ends an abbreviation.
            # Words of under four letters ("Ed.", "Co.") are never stripped.
            # Longer ones ("Publ.", "Univ.") are listed. A place keeps its
            # trailing ".": it is nearly always abbreviated ("Calif.", "N.Y.").
            OPTIONAL {
              {
                SELECT ?sfg (COUNT(DISTINCT ?st) AS ?grp_x) (SAMPLE(1000 * ?fpg + ?pg) AS ?pos_x) WHERE {
                  ?gr fx:anySlot ?dfg .
                  ?dfg a marc:datafield ; xyz:tag ?gtag ; xyz:ind2 ?gind2 .
                  FILTER(?gtag = "260" || (?gtag = "264" && ?gind2 = "1"))
                  ?gr ?fslotg ?dfg .
                  ?dfg fx:anySlot ?sfg .
                  ?sfg xyz:code ?cg .
                  FILTER(?cg IN ("a", "b"))
                  ?dfg ?slotg ?sfg .
                  BIND(xsd:integer(STRAFTER(STR(?fslotg), "#_")) AS ?fpg)
                  BIND(xsd:integer(STRAFTER(STR(?slotg), "#_")) AS ?pg)

                  ?gr fx:anySlot ?dft .
                  ?dft a marc:datafield ; xyz:tag ?ttag ; xyz:ind2 ?tind2 .
                  FILTER(?ttag = "260" || (?ttag = "264" && ?tind2 = "1"))
                  ?gr ?fslott ?dft .
                  ?dft fx:anySlot ?st .
                  ?st xyz:code ?ct .
                  FILTER(?ct IN ("a", "b"))
                  ?dft ?slott ?st .
                  BIND(xsd:integer(STRAFTER(STR(?fslott), "#_")) AS ?ftp)
                  BIND(xsd:integer(STRAFTER(STR(?slott), "#_")) AS ?tp)
                  FILTER(?ftp < ?fpg || (?ftp = ?fpg && ?tp <= ?pg))
                  FILTER(?ct = "b"
                         || EXISTS { ?dft fx:anySlot ?sz . ?sz xyz:code "b" . ?dft ?slotz ?sz .
                                    FILTER(xsd:integer(STRAFTER(STR(?slotz), "#_")) > ?tp) }
                         || NOT EXISTS { ?dft fx:anySlot ?sw . ?sw xyz:code ?cw . ?dft ?slotw ?sw .
                                        FILTER(?cw IN ("a", "b") && xsd:integer(STRAFTER(STR(?slotw), "#_")) < ?tp) })
                  FILTER NOT EXISTS {
                    ?dft fx:anySlot ?sx .
                    ?sx xyz:code ?cx .
                    FILTER(?cx IN ("a", "b") && (?ct = "b" || ?cx = "a"))
                    ?dft ?slotx ?sx .
                    BIND(xsd:integer(STRAFTER(STR(?slotx), "#_")) AS ?xp)
                    FILTER(?xp < ?tp)
                    FILTER NOT EXISTS {
                      ?dft fx:anySlot ?sy .
                      ?sy xyz:code "b" .
                      ?dft ?sloty ?sy .
                      BIND(xsd:integer(STRAFTER(STR(?sloty), "#_")) AS ?yp)
                      FILTER(?xp < ?yp && ?yp < ?tp)
                    }
                  }
                }
                GROUP BY ?sfg
              }
              ?sfg xyz:code ?g_code ; rdf:_1 ?g_raw .
              BIND(REPLACE(REPLACE(REPLACE(?g_raw,
                     "\\[?\\b(u\\.\\s*a|et al|etc)\\.\\]?", ""),
                     "[\\[\\]]", ""),
                     "^[\\s:;,]+|[\\s:;,/]+$", "")
                   AS ?g_clean)
              BIND(IF(?g_code = "b",
                      REPLACE(?g_clean, "(?i)(\\b(?!publ|corp|assoc|dept|univ|bros|verl|inst|internat|intl|natl|soc)\\w{4,})\\.$", "$1"),
                      ?g_clean)
                   AS ?g_val)
              FILTER(?g_val != "")
              FILTER(IF(?g_code = "b",
                        !REGEX(?g_val, "^s\\.\\s*n\\.?$|^sine nomine$|^no publisher|not ident|not idenf|nicht ermittel|non identifi|no identificad", "i"),
                        !REGEX(?g_val, "^s\\.\\s*l\\.?$|^sine loco$|not ident|not idenf|nicht ermittel|non identifi|no identificad", "i")))
              # The other code's variable is "" rather than unbound: the Jena
              # trap in CLAUDE.md (a GROUP_CONCAT over a group in which any row
              # leaves its variable unbound comes back unbound altogether).
              # The empty tokens are squeezed out after aggregating.
              BIND(IF(?g_code = "b", ?g_val, "") AS ?pub_b_x)
              BIND(IF(?g_code = "a", ?g_val, "") AS ?pub_a_x)
            }
            # $c only as a year source for records with no usable 008 -- the
            # eHive/UW records synthesized from JSON (#99) carry none. The
            # string itself ("c1998.", "[2003]") is not displayed.
            OPTIONAL {
              ?record fx:anySlot ?dfpc .
              ?dfpc a marc:datafield ; xyz:tag ?pc_tag ; xyz:ind2 ?pc_ind2 .
              FILTER(?pc_tag = "260" || (?pc_tag = "264" && ?pc_ind2 = "1"))
              ?dfpc fx:anySlot ?sfpc .
              ?sfpc xyz:code "c" ; rdf:_1 ?pub_c_raw .
              FILTER(REGEX(?pub_c_raw, "\\d{4}"))
              BIND(REPLACE(?pub_c_raw, "^\\D*?(\\d{4}).*$", "$1", "s") AS ?pub_year_x)
            }
            # Date and country of publication from 008. Date1 is positions
            # 7-10 and date2 is 11-14, with the date type at 6. Only a
            # four-digit date1 is used ("19uu" etc. are not). For a multipart
            # or collection range (types m, i, k) a later four-digit date2
            # extends it to "1972–1974". A date1 that names only the decade
            # ("196u") becomes "196-?", the form catalogues transcribe it in,
            # used only when $c gives no year either. The country of publication is
            # positions 15-17. It is linked only when it names a country:
            # "xx" (unknown) and "vp" (various places) are not countries.
            OPTIONAL {
              ?record fx:anySlot ?cf008 .
              ?cf008 a marc:controlfield ; xyz:tag "008" ; rdf:_1 ?fixed008 .
              BIND(SUBSTR(?fixed008, 7, 1) AS ?date_type)
              BIND(SUBSTR(?fixed008, 8, 4) AS ?date1)
              BIND(SUBSTR(?fixed008, 12, 4) AS ?date2)
              BIND(REPLACE(SUBSTR(?fixed008, 16, 3), "[\\s|]+", "") AS ?country_raw)
              BIND(IF(REGEX(?date1, "^[0-9]{4}$"),
                      IF(?date_type IN ("m", "i", "k") && REGEX(?date2, "^[0-9]{4}$")
                           && ?date2 != "9999" && ?date2 > ?date1,
                         CONCAT(?date1, "–", ?date2), ?date1),
                      ?sentinel)
                   AS ?date008_x)
              BIND(IF(REGEX(?date1, "^[0-9]{3}u$"), CONCAT(SUBSTR(?date1, 1, 3), "-?"), ?sentinel)
                   AS ?decade008_x)
              BIND(IF(REGEX(?country_raw, "^[a-z]{2,3}$") && !(?country_raw IN ("xx", "vp")),
                      ?country_raw, ?sentinel)
                   AS ?country_x)
            }
          }  # end inner per-record SERVICE
        }  # end folder-listing SERVICE
        }  # end track-table SERVICE
        }
        ORDER BY ?pos_x
       }
      }
      # One row per publication group. A record with no $a/$b at all leaves
      # ?grp_x unbound and gives a single row, taken as group 1 below.
      GROUP BY ?track ?canonical_key ?grp_x
    }
    # Squeeze out the empty tokens (see ?pub_b_x) and join the rest.
    BIND(REPLACE(REPLACE(?marc_publisher_t, "^\t+|\t+$", ""), "\t+", "; ") AS ?marc_publisher)
    BIND(REPLACE(REPLACE(?marc_place_t, "^\t+|\t+$", ""), "\t+", "; ") AS ?marc_place)
  }
  BIND(COALESCE(?grp_x, 1) AS ?group)

  # Emit only for works the track's own query emits. A reference work needs a
  # Zotero title. A book needs a Zotero title or a MARC record (whose 245
  # supplies one): artists-books.rq drops the few rows with neither, and a
  # publication here would hang off a URI typed nowhere.
  FILTER(BOUND(?zotero_title) || (?track = "item" && BOUND(?marc_record)))

  BIND(fx:entity(ab:, "work/", ?canonical_key) AS ?work)
  # The first group keeps the plain /publication URI (it is the only one for
  # all but ~180 works); the others are /publication/2, /publication/3 ...
  BIND(IF(?group = 1,
          fx:entity(ab:, "work/", ?canonical_key, "/publication"),
          fx:entity(ab:, "work/", ?canonical_key, "/publication/", STR(?group)))
       AS ?publication)

  # Year guard (#193): a MARC record whose year is more than one year from the
  # Zotero year (outside its range, for an m/i/k range) probably describes
  # another edition or another work -- a 2002 facsimile matched to a 1748
  # printing, a DVD of a same-titled film. For such a work the whole
  # publication statement stays Zotero's, rather than overwriting a right
  # publisher and date with a wrong one. The harvest still needs fixing: the
  # title and creators come from the same record.
  BIND(IF(REGEX(COALESCE(?zotero_date_ok, ""), "(1[5-9]|20)[0-9]{2}"),
          xsd:integer(REPLACE(?zotero_date_ok, "^.*?((1[5-9]|20)[0-9]{2}).*$", "$1")), ?sentinel) AS ?zotero_year)
  # A decade ("196-?") has no four-digit year, so ?marc_year_from is unbound
  # and the guard passes it.
  BIND(COALESCE(?marc_date008, ?marc_pub_year, ?marc_decade008) AS ?marc_date)
  BIND(xsd:integer(SUBSTR(?marc_date, 1, 4)) AS ?marc_year_from)
  BIND(IF(STRLEN(?marc_date) = 9, xsd:integer(SUBSTR(?marc_date, 6, 4)), ?marc_year_from) AS ?marc_year_to)
  BIND(BOUND(?zotero_year) && BOUND(?marc_year_from)
       && (?zotero_year < ?marc_year_from - 1 || ?zotero_year > ?marc_year_to + 1) AS ?marc_year_conflict)
  BIND(IF(?marc_year_conflict, ?sentinel, ?marc_publisher) AS ?marc_publisher_ok)
  BIND(IF(?marc_year_conflict, ?sentinel, ?marc_place) AS ?marc_place_ok)
  BIND(IF(?marc_year_conflict, ?sentinel, ?marc_date) AS ?marc_date_ok)
  BIND(IF(?marc_year_conflict, ?sentinel, ?marc_country) AS ?marc_country_ok)

  # Many Zotero values were copied from a catalogue, placeholders and all. A
  # value that is *only* a placeholder ("[s.n.]", "[S.l.]") is dropped as it
  # is from MARC. A longer string that merely contains one is kept as is
  # (#194).
  BIND(REPLACE(?zotero_publisher, "^[\\s\\[]+|[\\s\\],:;.]+$", "") AS ?zotero_publisher_s)
  BIND(REPLACE(?zotero_place, "^[\\s\\[]+|[\\s\\],:;.]+$", "") AS ?zotero_place_s)
  BIND(IF(REGEX(?zotero_publisher_s, "^(s\\.\\s*n|sine nomine|no publisher|publisher not identified|verlag nicht ermittelbar)$", "i"), ?sentinel, ?zotero_publisher) AS ?zotero_publisher_ok)
  BIND(IF(REGEX(?zotero_place_s, "^(s\\.\\s*[ln]|sine loco|place of publication not identified|erscheinungsort nicht ermittelbar)$", "i"), ?sentinel, ?zotero_place) AS ?zotero_place_ok)

  # MARC first, Zotero as the fallback, field by field. An empty GROUP_CONCAT
  # (a record whose only $b is a placeholder) is unbound or "", so both fall
  # through.
  #
  # The Zotero values are one unstructured string for the whole statement, so
  # they fall back only onto a work with a single MARC group (or none, or one
  # the year guard rejected), where they stand in for exactly what is missing.
  # Onto group 1 of several they would repeat the other groups' publishers.
  BIND(?group = 1 && (?marc_year_conflict || COALESCE(?marc_n_groups, 0) <= 1) AS ?zotero_fallback)
  BIND(COALESCE(IF(?marc_publisher_ok != "", ?marc_publisher_ok, ?sentinel),
                IF(?zotero_fallback, ?zotero_publisher_ok, ?sentinel)) AS ?publisher)
  BIND(COALESCE(IF(?marc_place_ok != "", ?marc_place_ok, ?sentinel),
                IF(?zotero_fallback, ?zotero_place_ok, ?sentinel)) AS ?place)
  # The date belongs to the whole statement, so every group repeats it. The
  # 008 country is a single code for the whole record, which needn't match
  # every group's place, so only the first group carries it.
  BIND(COALESCE(?marc_date_ok, ?zotero_date_ok) AS ?date)
  # The normalized year (#22): the first four-digit year in the date ("c1978",
  # "[1996]", "1972 or 1973", a range's start), else the first year of a
  # decade ("199-?", "[198-]", "198?"). A century ("19--") or anything else
  # yields none, and the work simply has no bf:date.
  BIND(IF(REGEX(?date, "(1[5-9]|20)[0-9]{2}"),
          REPLACE(?date, "^.*?((1[5-9]|20)[0-9]{2}).*$", "$1"),
          IF(REGEX(?date, "(1[5-9]|20)[0-9][-?uX]"),
             CONCAT(REPLACE(?date, "^.*?((1[5-9]|20)[0-9])[-?uX].*$", "$1"), "0"),
             ?sentinel))
       AS ?year)
  BIND(STRDT(?year, xsd:gYear) AS ?normalizedDate)
  BIND(IF(?group = 1 && BOUND(?marc_country_ok), IRI(CONCAT("http://id.loc.gov/vocabulary/countries/", ?marc_country_ok)), ?sentinel) AS ?placeCountry)

  # Group 1 is always emitted, as /publication always was: it carries the date
  # even when MARC and Zotero name no publisher or place. A later group is
  # emitted only when it has a place or publisher of its own (not when it was
  # all placeholders), and not at all when the year guard rejected the MARC.
  FILTER(?group = 1 || (!?marc_year_conflict && (BOUND(?publisher) || BOUND(?place))))
}
