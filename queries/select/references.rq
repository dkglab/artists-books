PREFIX ab:      <https://dkglab.github.io/ns/artists-books/>
PREFIX bf:      <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:    <http://id.loc.gov/ontologies/bflc/>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:      <http://www.wikidata.org/entity/>

# One row per reference work (#34), feeding both the reference index ("Results"
# page) and the per-reference detail page. Mirrors the shape of
# queries/select/artists-books.rq. The cited artists' books are joined in from
# the artists-books graph (Fuseki loads both constructed graphs) via the
# ab:Citation / ab:citedBy / ab:cites relationship (#42).
SELECT
  ?reference ?title ?itemKey
  ?publisher ?place ?date ?language ?isbns ?citedBooks
  # Leave ?citationCount unbound (via the never-bound ?noCount sentinel) when
  # nothing is cited, so the template's {{ with }} idiom hides it — Snowman
  # renders a bound 0 as truthy. The count must be aggregated in the subquery
  # below; the sentinel BIND has to live out here in a non-aggregate context.
  (IF(?citedCount > 0, STR(?citedCount), ?noCount) AS ?citationCount)
WHERE {
  {
    SELECT
      ?reference ?title ?itemKey ?publisher ?place ?date ?language
      (GROUP_CONCAT(DISTINCT ?isbn; separator="; ") AS ?isbns)
      (GROUP_CONCAT(DISTINCT ?citedTitle; separator="; ") AS ?citedBooks)
      (COUNT(DISTINCT ?citedBook) AS ?citedCount)
    WHERE {
      ?reference
        a ab:ReferenceWork ;
        rdfs:label ?title ;
        ab:itemKey ?itemKey ;
        .

      OPTIONAL {
        ?reference bf:provisionActivity ?pub .
        OPTIONAL { ?pub bflc:simpleAgent ?publisher . }
        OPTIONAL { ?pub bflc:simplePlace ?place . }
        OPTIONAL { ?pub bflc:simpleDate  ?date . }
      }

      OPTIONAL { ?reference bf:language ?language . }

      OPTIONAL {
        ?reference bf:identifiedBy ?id .
        ?id rdf:value ?isbn ;
            bf:source wd:Q33057 .
      }

      # The artists' books this reference cites (#42). The cited book lives in
      # the artists-books graph; fall back to its itemKey when it has no label.
      OPTIONAL {
        ?citation ab:citedBy ?reference ;
                  ab:cites   ?citedBook .
        OPTIONAL { ?citedBook rdfs:label ?citedBookLabel . }
        ?citedBook ab:itemKey ?citedBookKey .
        BIND(COALESCE(?citedBookLabel, ?citedBookKey) AS ?citedTitle)
      }
    }
    GROUP BY ?reference ?title ?itemKey ?publisher ?place ?date ?language
  }
}
ORDER BY LCASE(?title)
