PREFIX ab:      <https://dkglab.github.io/ns/artists-books/>
PREFIX bf:      <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:    <http://id.loc.gov/ontologies/bflc/>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:      <http://www.wikidata.org/entity/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

SELECT
  ?book
  ?title
  ?itemKey
  (GROUP_CONCAT(DISTINCT ?creatorDisplay; separator="; ") AS ?creators)
  ?publisher
  ?place
  ?date
  ?language
  (GROUP_CONCAT(DISTINCT ?isbn; separator="; ") AS ?isbns)
  (GROUP_CONCAT(DISTINCT ?oclc_number; separator="; ") AS ?oclcNumbers)
  (SAMPLE(?worldcat_url) AS ?worldcatLink)

WHERE {
  ?book
    a ab:ArtistsBook ;
    rdfs:label ?title ;
    ab:itemKey ?itemKey ;
    .

  # Each creator, rendered as "Name (role, role)". Roles are first folded per
  # creator (a contribution may carry several relator roles), then the creators
  # are concatenated by the outer GROUP_CONCAT. Kept OPTIONAL so books with no
  # creators still render.
  OPTIONAL {
    SELECT ?book (SAMPLE(?creatorName) AS ?name)
                 (GROUP_CONCAT(DISTINCT ?roleLabel; separator=", ") AS ?roleList)
    WHERE {
      ?book bf:contribution ?contribution .
      ?contribution bf:agent ?agent .
      ?agent rdfs:label ?creatorName .
      OPTIONAL { ?contribution bf:role/rdfs:label ?roleLabel . }
    }
    GROUP BY ?book ?agent
  }
  # Roles go in square brackets, not parentheses: MARC name headings already use
  # parentheses as qualifiers (e.g. "KaKeART (Group of artists)", "Freedom House
  # (U.S.)"), so "(author, artist)" right after would be ambiguous.
  BIND(COALESCE(?roleList, "") AS ?roles)
  BIND(IF(STRLEN(?roles) > 0,
          CONCAT(?name, " [", ?roles, "]"),
          ?name) AS ?creatorDisplay)

  OPTIONAL {
    ?book bf:provisionActivity ?pub .
    OPTIONAL { ?pub bflc:simpleAgent ?publisher . }
    OPTIONAL { ?pub bflc:simplePlace ?place . }
    OPTIONAL { ?pub bflc:simpleDate  ?date . }
  }

  OPTIONAL { ?book bf:language ?language . }

  OPTIONAL {
    ?book bf:identifiedBy ?id .
    ?id rdf:value ?isbn ;
        bf:source wd:Q33057 .
  }
  OPTIONAL {
    ?book bf:identifiedBy ?id .
    ?id rdf:value ?oclc_number ;
        bf:source wd:Q846596 .
  }
  OPTIONAL {
    ?book foaf:isPrimaryTopicOf ?worldcat_url .
  }
}
GROUP BY ?book ?title ?itemKey ?publisher ?place ?date ?language ?oclc_number
ORDER BY LCASE(?title)
