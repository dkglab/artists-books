PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx: <http://sparql.xyz/facade-x/ns/>
PREFIX ab: <https://dkglab.github.io/ns/artists-books/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX bf: <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc: <http://id.loc.gov/ontologies/bflc/>

CONSTRUCT {
  ?book
    a ab:ArtistsBook ;
    rdfs:label ?title ;
    bf:title [
      a bf:Title ;
      bf:mainTitle ?title ;
    ] ;
    bf:provisionActivity [
      a bf:ProvisionActivity ;
      rdf:type bf:Publication ;
      bflc:simpleAgent ?publisher ;
      bf:date ?date ;
      bflc:simpleDate ?date ;
      bflc:simplePlace ?place ;
    ] ;
    bf:language ?language ;
     bf:identifiedBy [
        a bf:Identifier ;
        rdf:value ?ISBN ;
        bf:source [
            rdfs:label "ISBN"
      ]
    ] .
}
WHERE {
  SERVICE <x-sparql-anything:location=Zotero/artists-books.csv> {
    fx:properties fx:csv.headers "true" .

    ?row
      xyz:itemKey ?item_key ;
      xyz:title ?title ;
      xyz:publisher ?publisher ;
      xyz:place ?place ;
      xyz:date ?date ;
      xyz:language ?language ;
      xyz:ISBN ?ISBN .

    # Mint new book URI using the fx:entity function
    BIND(fx:entity(ab:, "item/", ?item_key) AS ?book)
  }
}
