PREFIX xyz: <http://sparql.xyz/facade-x/data/>
PREFIX fx: <http://sparql.xyz/facade-x/ns/>
PREFIX ab: <https://dkglab.github.io/ns/artists-books/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX bf: <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc: <http://id.loc.gov/ontologies/bflc/>
PREFIX wd: <http://www.wikidata.org/entity/>

# Reference works and the citations that link them to artists' books (#34, #42).
#
# Two independent UNION branches feed graph/reference-resources.ttl:
#
#   1. The reference-work *resource* (#34): the node + its own BIBFRAME bib
#      metadata, mirroring the shape the artists' books get in artists-books.rq
#      but typed ab:ReferenceWork and minted under reference/<itemKey>. The
#      collection is heterogeneous (151 book + 3 journalArticle + 2 webpage), so
#      ab:ReferenceWork is a subclass of schema:CreativeWork (vocab.ttl). There
#      are no MARC records for reference works, so the MARC-derived fields the
#      artists' books carry (creators, OCLC/WorldCat, extent, dimensions) are
#      absent by design.
#
#   2. The *citation* (#42, moved here from artists-books.rq): each "Cited:" note
#      paragraph is a reference work citing an artist's book. The citation is now
#      anchored on the reference resource it appears in —
#      reference/<refItemKey>/citation/<abcItemKey> — rather than on the artist's
#      book. The citing reference is resolved to a reference-resources node by the
#      #42 citation crosswalk; the cited artist's book by the #55 ABC crosswalk.
#      Page-number / image-page extraction (#43/#44/#15/#16) is still TODO.
CONSTRUCT {
  ?ref a ab:ReferenceWork ;
    rdfs:label ?title ;
    ab:itemKey ?item_key ;
    bf:provisionActivity ?refPublication ;
    bf:language ?language ;
    bf:identifiedBy ?refISBN ;
    .

  ?refPublication a bf:Publication ;
    bflc:simpleAgent ?publisher ;
    bflc:simpleDate ?date ;
    bflc:simplePlace ?place ;
    .

  ?refISBN a bf:Identifier ;
    rdf:value ?ISBN ;
    bf:source wd:Q33057 ; # ISBN
    .

  ?citation a ab:Citation ;
    ab:citedBy ?citedRef ;
    ab:cites ?book ;
    rdfs:label ?citation_text ;
    .
}
WHERE {
  {
    SERVICE <x-sparql-anything:location=Zotero/reference-resources.csv> {
      # Facade-X configuration for CSV data
      fx:properties
        fx:csv.headers "true" ;  # create xyz:header properties
        fx:csv.null-string  "" ; # treat empty strings as null values
        .

      # For each row in reference-resources.csv. Only itemKey and title are
      # required; every other field is OPTIONAL so all 156 rows emit a node
      # (e.g. webpages/articles carry no publisher).
      ?refRow
        xyz:itemKey ?item_key ;
        xyz:title ?title ;
        .

      # Mint the reference-work URI and its publication sub-resource.
      BIND(fx:entity(ab:, "reference/", ?item_key) AS ?ref)
      BIND(fx:entity(ab:, "reference/", ?item_key, "/publication") AS ?refPublication)

      OPTIONAL { ?refRow xyz:publisher ?publisher }
      OPTIONAL {
        ?refRow xyz:date ?date_raw .
        # Strip Zotero's leading "YYYY-MM-DD " prefix from the date string.
        BIND(REPLACE(?date_raw, "^\\d{4}-\\d{2}-\\d{2} ", "") AS ?date)
      }
      OPTIONAL { ?refRow xyz:place ?place }
      OPTIONAL { ?refRow xyz:language ?language }

      OPTIONAL { ?refRow xyz:ISBN ?ISBN }
      BIND(fx:entity(ab:, "reference/", ?item_key, "/identifier") AS ?isbnNode)
      BIND(IF(BOUND(?ISBN), ?isbnNode, ?sentinel) AS ?refISBN)
    }
  }
  UNION
  {
    # Citation crosswalk (#42): (citedItemKey, n) -> the reference-resources
    # itemKey it cites, plus the flattened reference string. Requiring
    # xyz:refItemKey to bind drops paragraphs with no confident reference match
    # (empty cell); review=yes drops the low-confidence / generic-title grabs.
    SERVICE <x-sparql-anything:location=Zotero/citation-crosswalk.csv> {
      fx:properties
        fx:csv.headers "true" ;
        fx:csv.null-string  "" ;
        .
      ?ccRow
        xyz:citedItemKey ?cited_key ;
        xyz:refItemKey   ?ref_key ;
        xyz:citationText ?citation_text ;
        .
      OPTIONAL { ?ccRow xyz:review ?cc_review }
      FILTER(!BOUND(?cc_review) || ?cc_review != "yes")
    }

    # ABC crosswalk (#55): the cited (lib-3) record -> the ABC book that
    # reconciles to it. Same review gate artists-books.rq applied.
    SERVICE <x-sparql-anything:location=Zotero/abc-master-crosswalk.csv> {
      fx:properties
        fx:csv.headers "true" ;
        fx:csv.null-string  "" ;
        .
      ?xwRow
        xyz:abcItemKey   ?abc_key ;
        xyz:citedItemKey ?cited_key ;
        .
      OPTIONAL { ?xwRow xyz:review ?xw_review }
      FILTER(!BOUND(?xw_review) || ?xw_review != "yes")
    }

    # The citation is anchored on the reference resource it appears in.
    BIND(fx:entity(ab:, "reference/", ?ref_key)                         AS ?citedRef)
    BIND(fx:entity(ab:, "item/", ?abc_key)                              AS ?book)
    BIND(fx:entity(ab:, "reference/", ?ref_key, "/citation/", ?abc_key) AS ?citation)
  }
}
