  <datafield tag="500" ind1=" " ind2=" ">
    <subfield code="a">"Based upon the diaries of the Reverend J.A.L. Singh, missionary, S.P.G. Mission, and the rector of the orphanage, Midnapore, Bengal, India ; with appendix, chronology of the wolf-children, by the Right Reverend H. Pakenham-Walsh, Bishop, Christas Sishya Ashram, Tagadam, P.O. Coimbatore, India."</subfield>
  </datafield>
  <datafield tag="500" ind1=" " ind2=" ">
