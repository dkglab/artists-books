# Regenerates the committed source artifacts under sources/. Run from sources/
# (e.g. `make -C sources <target>`). Two tracks live in subdirs — zotero/ (the
# Zotero DB exports) and marc/ (the Z39.50 MARC harvest) — while the crosswalks
# that bridge them stay at this level.

zotero/all-items.csv: zotero/items_export.sh zotero/items_export.sql
	./zotero/items_export.sh > $@

zotero/artists-books.csv: zotero/items_export.sh zotero/items_export.sql
	./zotero/items_export.sh "Artists' Books Collection" > $@

# (No reference-works export target: the canonical reference-works.csv is built by
# dedup.py straight from zotero.sqlite, so the "Reference resources" collection
# needs no intermediate CSV export.)

# Zotero "Cited:" notes normalized to well-formed XHTML for SPARQL-Anything
# (issue #53). freeze_citations.py reads these to build the frozen citations.ttl.
zotero/notes.xml: zotero/notes_export.sh zotero/notes_export.sql zotero/notes_export.py
	./zotero/notes_export.sh > $@

FUZZY := ../tools/fuzzy-match

# One-time cross-library dedup (issue #82, Phase 0). Collapses the same work
# catalogued across lib 1/2/3 into one canonical node (canonical key by
# precedence lib 3 > lib 2 > lib 1; see README.md "Canonical key scheme") and
# emits the authoritative artists'-book and reference-work lists plus a review
# CSV of the uncertain lib-1 fuzzy attaches. Reads zotero/zotero.sqlite directly
# (no intermediate export CSVs) and runs in the shared fuzzy-match venv. Grouped
# target (&:) -- one recipe run produces all three files.
#
# artists-books-dedup-review.csv is GENERATED (overwritten on every run). The
# human review of those fuzzy attaches lives in a separate hand-owned overlay,
# artists-books-dedup-decisions.csv (same discipline as construction/decisions.csv
# and subjects/decisions.csv): keyed by lib1Key, edited by a person, NOT generated
# by make, so a re-run of the dedup never clobbers the decisions. It is a
# prerequisite because dedup.py reads it back to gate the fuzzy merge -- a lib-1
# key marked 'no' or 'unsure' is kept as its own canonical node instead of
# collapsing into its twin.
artists-books.csv reference-works.csv artists-books-dedup-review.csv &: \
		$(FUZZY)/dedup.py $(FUZZY)/match.py artists-books-dedup-decisions.csv \
		| $(FUZZY)/venv/bin/python
	$(FUZZY)/venv/bin/python $(FUZZY)/dedup.py \
		--db zotero/zotero.sqlite \
		--out-books artists-books.csv \
		--out-refs reference-works.csv \
		--review artists-books-dedup-review.csv \
		--decisions artists-books-dedup-decisions.csv

# Frozen citations (issue #82, Phase 0, task 3). Reads the Zotero "Cited:" notes
# and emits one ab:Citation per (reference work, artist's book) against the
# canonical URIs from the two dedup lists above, capturing page numbers (#43/#44)
# from the note markup. Generated once, committed, and loaded into Fuseki as-is
# (no citations.rq); the review CSV surfaces the uncertain/unmatched paragraphs.
# The paragraph -> reference-work match reuses cite_match.py's matcher. artists-books.csv
# and reference-works.csv are committed inputs with their own target above, so they
# are read but not listed as prerequisites (a rebuild here doesn't re-run the dedup).
#
# citations-review.csv is GENERATED (overwritten on every run). The human review of
# those fuzzy matches lives in a separate hand-owned overlay, citations-decisions.csv
# (same discipline as artists-books-dedup-decisions.csv): keyed by (refKey, bookKey),
# edited by a person, NOT generated by make, so a re-run never clobbers the decisions.
# It is a prerequisite because freeze_citations.py reads it back to gate emission -- a
# citation marked 'no'/'unsure' is suppressed, one marked 'yes' blesses an uncertain match.
citations.ttl citations-review.csv &: zotero/notes.xml citations-decisions.csv \
		$(FUZZY)/freeze_citations.py $(FUZZY)/cite_match.py | $(FUZZY)/venv/bin/python
	$(FUZZY)/venv/bin/python $(FUZZY)/freeze_citations.py \
		--notes zotero/notes.xml \
		--refs reference-works.csv \
		--books artists-books.csv \
		--out citations.ttl \
		--review citations-review.csv \
		--decisions citations-decisions.csv


# Build the fuzzy-match venv on demand (order-only prerequisite above).
$(FUZZY)/venv/bin/python:
	$(MAKE) -C $(FUZZY)

# Harvest full MARC records from UNC's Z39.50 server for the items in a CSV.
# Resumable harvest state lives under marc/harvest/<csv-stem>/ (gitignored);
# only the committed marc/<stem>-marc.xml is the build product. Requires the
# YAZ toolkit (yaz-client, yaz-marcdump), built on demand under tools/yaz-client/.
# Both the harvester script and the YAZ toolkit are order-only prerequisites
# (| ...) so editing marc_harvest.py or rebuilding the toolkit does not by
# itself trigger a re-harvest -- that hits an external server, so it only
# reruns when the source CSV changes.
YAZ := ../tools/yaz-client

# The MARC harvest emits a per-record zip archive (#81) -- one <key>.xml per
# record -- not one big <collection> file; the construct queries read it via
# nested Archive -> XML triplifiers.
#
# Both canonical harvests read a deduped list at the sources/ root (canonicalKey
# column), not a per-library zotero/ export, so they get explicit rules that
# override the marc/%-marc.zip pattern below.
#
# The canonical artists'-book harvest (issue #84). The ~1,340 already-harvested
# held books are NOT re-harvested: they are merged from the frozen, re-keyed
# marc/artists-books-held-marc.xml (a one-time artifact of marc/rekey_held.py, so
# an order-only prerequisite) via --premerged, and only the ~6,619 non-held books
# hit the Z39.50/SRU servers here.
marc/artists-books-marc.zip: artists-books.csv \
		| marc/artists-books-held-marc.xml marc/marc_harvest.py \
		  $(YAZ)/bin/yaz-client $(YAZ)/bin/zoomfetch
	python3 marc/marc_harvest.py --csv $< --out $@ \
		--premerged marc/artists-books-held-marc.xml

# The canonical reference-work harvest. Reads the deduped reference-works.csv (not
# the pre-dedup "Reference resources" collection), so each record is stamped with
# the canonical key -- keeping the archive to exactly the canonical works, with no
# losing-key duplicates. row_key() prefers canonicalKey, and the hand-supplied
# marc/reference-works-manual.xml (derived from the CSV stem) is
# merged for the items no reachable catalogue serves.
marc/reference-works-marc.zip: reference-works.csv | marc/marc_harvest.py \
		$(YAZ)/bin/yaz-client $(YAZ)/bin/zoomfetch
	python3 marc/marc_harvest.py --csv $< --out $@

marc/%-marc.zip: zotero/%.csv | marc/marc_harvest.py \
		$(YAZ)/bin/yaz-client $(YAZ)/bin/zoomfetch
	python3 marc/marc_harvest.py --csv $< --out $@

# Artstor asset ID -> JSTOR Forum SSID crosswalk (issue #9). Resolves the MARC
# 856 $u links, whose retired patron-side asset IDs still 301-redirect to
# jstor.org/stable/community.<SSID> -- the key that joins our catalogue records
# to Jstor_Artists__book_records.csv, and so to the cover images.
#
# Like the harvest, this hits an external server: the script is an order-only
# prerequisite, and the committed MARC archive is read but deliberately NOT a
# prerequisite, so a rebuild here never triggers a re-harvest. The run is
# resumable (already-resolved asset IDs are read back from the CSV and skipped),
# so it can be chunked with --limit.
artstor-ssid.csv: | marc/resolve_artstor.py
	python3 marc/resolve_artstor.py --archive marc/artists-books-marc.zip --out $@

# SSID -> IIIF image identifiers (issue #9), the second half of the cover-image
# lookup. artstor-ssid.csv is read for its SSIDs but is deliberately NOT a
# prerequisite (same reasoning as above: a rebuild must never trigger a re-run
# of an external harvest), and neither file is a prerequisite of anything the
# pipeline builds -- ssid-iiif.csv is a frozen source, committed like
# citations.ttl. The metadata API is aggressively rate-limited per IP, so this
# is slow by design (~1,127 SSIDs at 8s => ~2.5h) and stops at the first 403.
# Rerun to resume; chunk it with --limit.
ssid-iiif.csv: | marc/harvest_iiif.py
	python3 marc/harvest_iiif.py --ssids artstor-ssid.csv --out $@

# Build the YAZ toolkit on demand (order-only prerequisite above). The same
# make invocation produces yaz-marcdump and the zoomfetch driver (issue #85)
# alongside yaz-client.
$(YAZ)/bin/yaz-client $(YAZ)/bin/zoomfetch:
	$(MAKE) -C $(YAZ)

# --- Construction & production methods concept scheme (SKOS) ---------------
# construction-methods.ttl is a local SKOS vocabulary of the construction
# techniques, materials, binding/format types, and printing methods named in
# the MARC records. It is built in three mined/curated steps:
#
#   1. construction/candidates.csv -- every genre/technique/material heading
#      mined from the MARC (655 + 340 materials + 650, minus plain subjects),
#      aggregated one row per concept cluster for human review. Regenerate after
#      a MARC re-harvest with `make -C sources -B construction/candidates.csv`.
#   1b. construction/occurrences.csv -- the same mining un-aggregated: one row
#      per (cluster, label, authority) occurrence. This is the machine-side
#      extract build-scheme.rq joins against; it exists as its own file so the
#      archive is read exactly once (see mine-occurrences.rq for why). Rebuild
#      alongside candidates.csv after a re-harvest.
#   2. construction/decisions.csv -- the hand-maintained curation: which of
#      those headings are construction/production methods, their preferred
#      label, and how variants group into one concept. Edited by a person; NOT
#      generated by make.
#   3. construction-methods.ttl -- the SKOS scheme, built from decisions.csv
#      joined to occurrences.csv (so every label variant + authority URI is
#      captured). Rebuild after editing decisions.csv with
#      `make -C sources construction-methods.ttl`.
#
# The mining queries read root-relative paths (sources/...), so their recipes
# run the tool from the repo root. Like the crosswalk targets above, the
# committed MARC archive is read by the mining recipes but deliberately NOT a
# prerequisite, so a rebuild here never triggers a re-harvest. build-scheme.rq
# reads only the two committed CSVs, so it does not touch the MARC at all.
SA := ../tools/sparql-anything/sparql-anything.jar
SA_RUN := java -Dlog4j2.statusLoggerLevel=OFF -jar tools/sparql-anything/sparql-anything.jar

construction/candidates.csv: construction/mine-candidates.rq | $(SA)
	cd .. && $(SA_RUN) -q sources/construction/mine-candidates.rq -f CSV > sources/construction/candidates.csv

construction/occurrences.csv: construction/mine-occurrences.rq | $(SA)
	cd .. && $(SA_RUN) -q sources/construction/mine-occurrences.rq -f CSV > sources/construction/occurrences.csv

construction-methods.ttl: construction/build-scheme.rq construction/decisions.csv construction/occurrences.csv | $(SA)
	cd .. && $(SA_RUN) -q sources/construction/build-scheme.rq -f TTL > sources/construction-methods.ttl

# subject-terms.ttl -- the subject-headings SKOS scheme (650/651), built exactly
# like construction-methods.ttl but from the subjects/ pipeline (issue #105). The
# two schemes partition the heading space; see subjects/README.md. Same
# discipline: the committed MARC zip is read by the mining recipes but is
# deliberately NOT a prerequisite (so a rebuild never triggers a re-harvest);
# build-scheme.rq reads only the two committed CSVs.
subjects/candidates.csv: subjects/mine-candidates.rq | $(SA)
	cd .. && $(SA_RUN) -q sources/subjects/mine-candidates.rq -f CSV > sources/subjects/candidates.csv

subjects/occurrences.csv: subjects/mine-occurrences.rq | $(SA)
	cd .. && $(SA_RUN) -q sources/subjects/mine-occurrences.rq -f CSV > sources/subjects/occurrences.csv

subject-terms.ttl: subjects/build-scheme.rq subjects/decisions.csv subjects/occurrences.csv | $(SA)
	cd .. && $(SA_RUN) -q sources/subjects/build-scheme.rq -f TTL > sources/subject-terms.ttl

$(SA):
	$(MAKE) -s -C ../tools/sparql-anything
