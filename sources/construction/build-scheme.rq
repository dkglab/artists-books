# Build the SKOS construction-methods scheme from the curated decisions.csv
# joined against the MARC. For every include=y cluster the matching MARC
# occurrences contribute their raw $a variants (as skos:altLabel + a normalized
# ab:matchKey) and their $0 authority URIs (as skos:exactMatch). Concepts are
# minted in the ab: namespace and grouped under four category top concepts.
#
# Matching-key normalization here MUST stay identical to mine-candidates.rq and
# to the construct query that will consume the scheme: lower-case, strip trailing
# whitespace/periods, punctuation -> hyphen, trim hyphens. matchKey is a PLAIN
# literal (no language tag) so the eventual join can never hit a langtag mismatch.
PREFIX ab:      <https://dkglab.github.io/ns/artists-books/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX xyz:     <http://sparql.xyz/facade-x/data/>
PREFIX fx:      <http://sparql.xyz/facade-x/ns/>
PREFIX marc:    <http://www.loc.gov/MARC21/slim#>

CONSTRUCT {
  ab:construction-methods a skos:ConceptScheme ;
    skos:prefLabel "Construction and production methods"@en .

  ?catConcept a skos:Concept ;
    skos:inScheme ab:construction-methods ;
    skos:topConceptOf ab:construction-methods ;
    skos:prefLabel ?catLabel ;
    rdfs:label ?catLabel .

  ?concept a skos:Concept ;
    skos:inScheme ab:construction-methods ;
    skos:broader ?catConcept ;
    skos:prefLabel ?prefLabelLang ;
    rdfs:label ?prefLabelLang ;
    skos:altLabel ?altLabelLang ;
    skos:exactMatch ?matchIRI ;
    ab:matchKey ?matchKey .
}
WHERE {
  # ---- curated decisions (include = y only) ----
  SERVICE <x-sparql-anything:location=sources/construction/decisions.csv,csv.headers=true> {
    ?drow xyz:cluster ?cluster_d ;
          xyz:include "y" ;
          xyz:conceptId ?conceptId ;
          xyz:category  ?category ;
          xyz:prefLabel ?prefLabel .
  }
  VALUES (?category ?catSlug ?catLabel) {
    ("material"            "material"            "Materials"@en)
    ("technique"           "technique"           "Techniques"@en)
    ("binding-format"      "binding-format"      "Binding and format"@en)
    ("production-printing" "production-printing" "Production and printing"@en)
  }
  BIND(fx:entity(ab:, "construction/", ?conceptId)       AS ?concept)
  BIND(fx:entity(ab:, "construction/category/", ?catSlug) AS ?catConcept)
  BIND(STRLANG(?prefLabel, "en") AS ?prefLabelLang)

  # ---- MARC occurrences for this cluster ----
  SERVICE <x-sparql-anything:location=sources/marc/artists-books-marc.xml> {
    ?record a marc:record .
    ?record fx:anySlot ?df .
    ?df a marc:datafield ; xyz:tag ?tag .
    OPTIONAL { ?df fx:anySlot ?sf2 . ?sf2 xyz:code "2" ; rdf:_1 ?sr . }
    BIND(LCASE(REPLACE(STR(?sr), "\\.$", "")) AS ?scheme)
    FILTER(
         ?tag = "655"
      || (?tag = "340" && ?scheme = "rdamat")
      || (?tag = "650" && BOUND(?scheme) && ?scheme != "fast")
    )
    ?df fx:anySlot ?sfa . ?sfa xyz:code "a" ; rdf:_1 ?labelRaw .
    BIND(STR(?labelRaw) AS ?rawLabel)
    BIND(REPLACE(REPLACE(REPLACE(LCASE(?rawLabel), "[\\s.]+$",""), "[^a-z0-9]+","-"), "(^-)|(-$)","") AS ?normLabel)
    OPTIONAL { ?df fx:anySlot ?sf0 . ?sf0 xyz:code "0" ; rdf:_1 ?zeroRaw . BIND(STR(?zeroRaw) AS ?dollar0) }
    BIND(COALESCE(?dollar0, CONCAT(COALESCE(?scheme,"none"), "|", ?normLabel)) AS ?cluster)
  }
  FILTER(?cluster = ?cluster_d)

  # normalized match key (plain literal) + variant label + exact-match IRI
  BIND(?normLabel AS ?matchKey)
  BIND(IF(STR(?rawLabel) != ?prefLabel, STRLANG(?rawLabel, "en"), ?unbound) AS ?altLabelLang)
  BIND(IF(BOUND(?dollar0), IRI(REPLACE(?dollar0, "\\.$", "")), ?unbound) AS ?matchIRI)
}
