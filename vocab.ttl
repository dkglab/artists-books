@prefix ex: <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ulan: <http://vocab.getty.edu/ulan/> .
@prefix wd: <http://www.wikidata.org/entity/> .

ex:Book a rdfs:Class ;
    rdfs:label "Book" ;
    rdfs:comment "A book is an object that takes the usual form of a book with bound pages in a cover or an artwork that is identified as a book." .

ex:authoredBy a rdfs:Property ;
    rdfs:label "authored by" ;
    rdfs:comment "Indicates the author of a book." ;
    rdfs:domain ex:Book ;
    rdfs:range ex:Agent .

ex:Agent a rdfs:Class ;
    rdfs:label "Agent" ;
    rdfs:comment "An agent is an entity that can perform actions, such as a person or an organization." .

ex:createdBy a rdfs:Property ;
    rdfs:label "created by" ;
    rdfs:comment "Indicates that an Agent created an Artist's Book." ;
    rdfs:domain ex:ArtistsBook ;
    rdfs:range ex:Agent .

ex:primaryCreator a rdf:Property ;
    rdfs:subPropertyOf ex:createdBy ;
    rdfs:label "has a primary creator" ;
    rdfs:comment "Indicates that an Agent is the primary creator of an Artist's Book." ;
    rdfs:domain ex:ArtistsBook ;
    rdfs:range ex:Agent .

ex:ArtistsBook a rdfs:Class ;
    rdfs:subClassOf ex:Book ;
    rdfs:label "Artist's Book" ;
    rdfs:comment "An artist book is a work of art that utilizes the form of a book." .

ex:secondaryCreator a rdf:Property ;
    rdfs:subPropertyOf ex:createdBy ;
    rdfs:label "has a secondary creator" ;
    rdfs:comment "Indicates that an Agent is the secondary creator of an Artist's Book." ;
    rdfs:domain ex:ArtistsBook ;
    rdfs:range ex:Agent .

ex:additionalCreator a rdf:Property ;
    rdfs:subPropertyOf ex:createdBy ;
    rdfs:label "has an additional creator" ;
    rdfs:comment "Indicates that an Agent is an additional creator of an Artist's Book." ;
    rdfs:domain ex:ArtistsBook ;
    rdfs:range ex:Agent .

ex:relatedTo a rdfs:Property ;
    rdfs:label "related to" ;
    rdfs:comment "Indicates a relationship between two books." ;
    rdfs:domain ex:Book ;
    rdfs:range ex:Book .

ex:publishedBy a rdfs:Property ;
    rdfs:label "published by" ;
    rdfs:comment "Indicates the publisher of a book." ;
    rdfs:domain ex:Book ;
    rdfs:range ex:Agent .

ex:publishedInYear a rdfs:Property ;
    rdfs:label "published in year" ;
    rdfs:comment "Indicates the year a book was published." ;
    rdfs:domain ex:Book .

ex:publishedInLocation a rdfs:Property ;
    rdfs:label "published in location" ;
    rdfs:comment "Indicates the location where a book was published." ;
    rdfs:domain ex:Book ;
    rdfs:range ex:Place .

ex:Place a rdfs:Class ;
    rdfs:label "Place" ;
    rdfs:comment "A place is a physical location, such as a city or country." .

ex:bookArtist a rdf:Property ;
    rdfs:subPropertyOf ex:createdBy ;
    rdfs:label "has book artist" ;
    rdfs:comment "Indicates that an Agent is the book artist for an Artist's Book." ;
    rdfs:domain ex:ArtistsBook ;
    rdfs:range ex:Agent .


ex:imagesAt a rdfs:Property ;
    rdfs:label "images at" ;
    rdfs:comment "Indicates a URL where images of the book can be found." ;
    rdfs:domain ex:ArtistsBook ;
    rdfs:range rdfs:Resource .
    
ex:isEditionNumber a rdfs:Property ;
    rdfs:label "is edition number" ;
    rdfs:comment "Indicates the edition number of a book." ;
    rdfs:domain ex:Book .

ex:numberMade a rdfs:Property ;
    rdfs:label "number made" ;
    rdfs:comment "Indicates the number of copies made of an Artist's Book." ;
    rdfs:domain ex:ArtistsBook .

ex:worldcatLink a rdfs:Property ;
    rdfs:label "WorldCat link" ;
    rdfs:comment "Indicates a URL to the WorldCat record for the book." ;
    rdfs:domain ex:Book ;
    rdfs:range rdfs:Resource .


ex:ReferenceBook a rdfs:Class ;
    rdfs:subClassOf ex:Book ;
    rdfs:label "Reference Book" ;
    rdfs:comment "A reference book is a book that cites an Artist's Book." .

ex:Person a rdfs:Class ;
    rdfs:subClassOf ex:Agent ;
    rdfs:label "Person" ;
    rdfs:comment "A person is an individual human being." .

ex:Group a rdfs:Class ;
    rdfs:subClassOf ex:Agent ;
    rdfs:label "Group" ;
    rdfs:comment "A group is a collection of individuals, such as an organization or collective." .

ex:associatedWith a rdfs:Property ;
    rdfs:label "associated with" ;
    rdfs:comment "Indicates an association between a Person and a Group." ;
    rdfs:domain ex:Person ;
    rdfs:range ex:Group .

ex:isBookType a rdfs:Property ;
    rdfs:label "type of Reference Book" ;
    rdfs:comment "Indicates the type of ReferenceBook, such as 'monograph' or 'exhibition catalog'." ;
    rdfs:domain ex:ReferenceBook ;
    rdfs:range ex:BookType .

ex:BookType a rdfs:Class ;
    rdfs:label "Book Type" ;
    rdfs:comment "A book type is a category of ReferenceBook, such as 'monograph' or 'exhibition catalog'." .

ex:Citation a rdfs:Class ;
    rdfs:label "Citation" ;
    rdfs:comment "A citation is a relationship between an Artist's Book and a Reference Book."  .

ex:citedBy a rdfs:Property ;
    rdfs:label "cited by" ;
    rdfs:comment "Relates a Citation to a Reference Book." ;
    rdfs:domain ex:Citation ;
    rdfs:range ex:ReferenceBook .

ex:cites a rdfs:Property ;
    rdfs:label "cites" ;
    rdfs:comment "Relates a Citation to an Artist's Book." ;
    rdfs:domain ex:Citation ;
    rdfs:range ex:ArtistsBook .

ex:onPageNumber a rdfs:Property ;
    rdfs:label "on page number" ;
    rdfs:comment "Relates Citation to page number where it is found." ;
    rdfs:domain ex:Citation .

ex:imagesOnPageNumber a rdfs:Property ;
    rdfs:subPropertyOf ex:onPageNumber ;
    rdfs:label "images on page number" ;
    rdfs:comment "Relates Citation to a page number where an image of the cited Artist_book is." ;
    rdfs:domain ex:Citation .

ex:constructedUsing a rdfs:Property ;
    rdfs:label "constructed using" ;
    rdfs:comment "Indicates techniques, materials, and production methods used in the construction of an Artist's Book." ;
    rdfs:domain ex:ArtistsBook ;
    rdfs:range ex:ConstructionMethod .

ex:ConstructionMethod a rdfs:Class ;
    rdfs:label "Construction Method" ;
    rdfs:comment "A construction method is a technique, material, or production method used in the creation of an Artist's Book." .

ex:hasDimension a rdfs:Property ;
    rdfs:label "has dimension" ;
    rdfs:comment "Indicates the dimensions of an Artist's Book." ;
    rdfs:domain ex:ArtistsBook .


ex:hasGenreHeading a rdfs:Property ;
    rdfs:label "has genre heading" ;
    rdfs:comment "Indicates a genre heading associated with the book." ;
    rdfs:domain ex:Book ;
    rdfs:range ex:GenreHeading .

ex:GenreHeading a rdfs:Class ;
    rdfs:label "Genre Heading" ;
    rdfs:comment "A genre heading is a term used to describe the genre of a book in a library record." .

ex:editionYear a rdfs:Property ;
    rdfs:label "edition year" ;
    rdfs:comment "Indicates the year of an edition of a book." ;
    rdfs:domain ex:Book  .

ex:inLanguage a rdfs:Property ;
    rdfs:label "language" ;
    rdfs:comment "Indicates the language of a book." ;
    rdfs:domain ex:Book ;
    rdfs:range ex:Language .

ex:Language a rdfs:Class ;
    rdfs:label "Language" ;
    rdfs:comment "A language is a system of communication used by a particular community or country." .

ex:photographyBy a rdf:Property ;
    rdfs:subPropertyOf ex:createdBy ;
    rdfs:subPropertyOf ex:constructedUsing ;
    rdfs:label "photographed by" ;
    rdfs:comment "Indicates that an Artist's Book uses photography as part of its construction and identifies the photographer." ;
    rdfs:domain ex:ArtistsBook ;
    rdfs:range ex:Agent .

ex:hasTitle a rdfs:Property ;
    rdfs:label "has title" ;
    rdfs:comment "Indicates the title of a book." ;
    rdfs:domain ex:Book .





    

