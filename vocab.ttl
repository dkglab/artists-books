@prefix ex: <http://example.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix ulan: <http://vocab.getty.edu/ulan/> .
@prefix wd: <http://www.wikidata.org/entity/> .
@prefix aat: <http://vocab.getty.edu/aat/> .
@prefix schema: <https://schema.org/> .
@prefix bf: <http://id.loc.gov/ontologies/bibframe/> .
@prefix ab: <https://dkglab.github.io/ns/artists-books/> .


ex:ArtistsBook a rdfs:Class ;
    rdfs:subClassOf schema:Book ;
    rdfs:label "Artist's Book" ;
    rdfs:comment "An artist book is a work of art that utilizes the form of a book." .


ex:imagesAt a rdfs:Property ;
    rdfs:label "images at" ;
    rdfs:comment "Indicates a URL where images of the book can be found." ;
    rdfs:domain ex:ArtistsBook ;
    rdfs:range rdfs:Resource .
    
ex:worldcatLink a rdfs:Property ;
    rdfs:label "WorldCat link" ;
    rdfs:comment "Indicates a URL to the WorldCat record for the book." ;
    rdfs:domain schema:Book ;
    rdfs:range rdfs:Resource .


ab:ReferenceWork a rdfs:Class ;
    rdfs:subClassOf schema:CreativeWork ;
    rdfs:label "Reference Work" ;
    rdfs:comment "A reference work is a work (book, article, webpage, etc.) that cites an Artist's Book." .

ex:Citation a rdfs:Class ;
    rdfs:label "Citation" ;
    rdfs:comment "A citation is a relationship between an Artist's Book and a Reference Book."  .

ex:citedBy a rdfs:Property ;
    rdfs:label "cited by" ;
    rdfs:comment "Relates a Citation to a Reference Work." ;
    rdfs:domain ex:Citation ;
    rdfs:range ab:ReferenceWork .

ex:cites a rdfs:Property ;
    rdfs:label "cites" ;
    rdfs:comment "Relates a Citation to an Artist's Book." ;
    rdfs:domain ex:Citation ;
    rdfs:range ex:ArtistsBook .

ex:onPageNumber a rdfs:Property ;
    rdfs:label "on page number" ;
    rdfs:comment "Relates Citation to page number where it is found." ;
    rdfs:domain ex:Citation .

ex:imagesOnPageNumber a rdfs:Property ;
    rdfs:subPropertyOf ex:onPageNumber ;
    rdfs:label "images on page number" ;
    rdfs:comment "Relates Citation to a page number where an image of the cited Artist_book is." ;
    rdfs:domain ex:Citation .

ex:constructedUsing a rdfs:Property ;
    rdfs:label "constructed using" ;
    rdfs:comment "Indicates techniques, materials, and production methods used in the construction of an Artist's Book. May also include the genre of the book like \"photographic sequence\"" ;
    rdfs:domain ex:ArtistsBook.









    

