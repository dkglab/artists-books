{
	// Codespaces dev container for the artists-books pipeline. A lightweight
	// Ubuntu base (the universal image is ~10 GB and slow to provision) plus the
	// repo's system dependencies installed from apt:
	//   - default-jre-headless : runs the Jena/Fuseki/SPARQL-Anything tools fetched under tools/
	//   - python3              : marc_harvest.py
	//   - sqlite3              : the Zotero export scripts
	//   - make                 : the Makefiles
	//   - build-essential      : C toolchain to build the vendored YAZ
	//                            (yaz-client/yaz-marcdump) from source under
	//                            tools/yaz-client/, for the Z39.50 MARC harvest
	"name": "artists-books",
	"image": "mcr.microsoft.com/devcontainers/base:ubuntu",
	// base:ubuntu has no SSH server (unlike the universal image); the sshd
	// feature restores `gh codespace ssh` / SSH-based editor access.
	"features": {
		"ghcr.io/devcontainers/features/sshd:1": {}
	},
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y default-jre-headless python3 sqlite3 make build-essential"
}
