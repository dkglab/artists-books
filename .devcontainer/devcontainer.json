{
	// Codespaces dev container for the artists-books pipeline.
	// The universal image already provides the JVM (for the Jena/Fuseki/etc.
	// tools fetched under tools/), Python 3 (marc_harvest.py), sqlite3 (the
	// Zotero export scripts), make, and gh. We add the YAZ toolkit, which
	// marc_harvest.py / `make *-marc.xml` need to talk Z39.50 to UNC's catalog.
	"name": "artists-books",
	"image": "mcr.microsoft.com/devcontainers/universal:linux",
	"postCreateCommand": "sudo apt-get update && sudo apt-get install -y yaz"
}
