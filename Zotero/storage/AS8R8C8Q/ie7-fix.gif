<script>
	$(document).ready(function(){
		$.get("search?&trln=t", function(data){
			$("#trlnresultscount").html(data);
			if (data > 0){
				$("#trlnnoresultscount").html(data);
				$("#trlnnoresults").show();
			}
		});
		if ("" != "")
			$.getJSON("content?q=", getWorldCatCount);

		$("#scopeCrumbs:not(.disabled)").click(function(e){
			$(".scopeDetails").slideToggle(100);
			return false;
		});
		
		$("#scopeCrumbs a").click(function(e){
			e.stopPropagation();
		});
	});
</script>
