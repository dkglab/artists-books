PREFIX ab:      <https://dkglab.github.io/ns/artists-books/>
PREFIX bf:      <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:    <http://id.loc.gov/ontologies/bflc/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

# One row per construction-method concept that at least one artists' book is
# linked to via ab:constructedUsing. Feeds both the construction index
# ("Construction Methods" page) and the per-method detail page. Mirrors
# queries/references.rq: the book join is REQUIRED (not OPTIONAL), so a curated
# concept that no in-collection book uses earns no page.
#
# Fuseki loads the SKOS scheme (sources/construction-methods.ttl) alongside the
# constructed graphs, so each concept's prefLabel and its category (skos:broader
# top-concept) resolve here.
SELECT
  ?concept
  # The URI slug (…/construction/<conceptKey>), used for the output path and for
  # the links minted on the book pages.
  (REPLACE(STR(?concept), ".*/construction/", "") AS ?conceptKey)
  ?label
  ?category
  ?categoryLabel
  # The category's URI slug, used as the index's in-page anchor.
  (REPLACE(STR(?category), ".*/category/", "") AS ?categoryKey)
  # Each book as a TAB-separated token, tokens newline-separated, so the
  # template can render a card per book (thumbnail, title link, creator · date,
  # place: publisher).
  # Field order is positional — the template indexes it — and every field is
  # always present, so a missing value is an empty field rather than a missing
  # one:
  #   itemKey <TAB> title <TAB> creators <TAB> date <TAB> imprint
  #     <TAB> thumbUrl <TAB> thumbWidth <TAB> thumbHeight
  ?books
  ?bookCount
WHERE {
  ?concept
    a skos:Concept ;
    skos:inScheme ab:construction-methods ;
    .
  OPTIONAL { ?concept skos:prefLabel ?prefLabel . }
  OPTIONAL { ?concept rdfs:label ?rdfsLabel . }
  BIND(COALESCE(?prefLabel, ?rdfsLabel) AS ?label)

  # Category top-concept (the BARD glossary sections: Materials,
  # Process/Technique, ...), for grouping the index, with its glossary rank.
  OPTIONAL {
    ?concept skos:broader ?category .
    ?category rdfs:label ?categoryLabel .
    OPTIONAL { ?category ab:categoryRank ?categoryRank . }
  }

  # Required: the artists' books constructed using this method.
  # One aggregated row per concept, so a concept no in-collection book uses
  # earns no page. The cards come out sorted by title: GROUP_CONCAT keeps its
  # input order, and only a scope *below* the grouping can be ordered, so the
  # innermost SELECT builds one token per book and sorts them (item key breaks
  # ties between identically titled books, keeping the build deterministic).
  {
    SELECT ?concept
           (GROUP_CONCAT(?bookToken; separator="\n") AS ?books)
           (COUNT(DISTINCT ?book) AS ?bookCount)
    WHERE {
      {
        SELECT DISTINCT ?concept ?book ?bookToken
        WHERE {
          ?book
            a ab:ArtistsBook ;
            ab:constructedUsing ?concept ;
            ab:itemKey ?bookKey ;
            rdfs:label ?title ;
            .

          # Card details for each book. Creators and the imprint are aggregated per
          # book in their own subqueries so a book with two primary creators (or two
          # dates) still yields one token rather than several near-duplicates.
          OPTIONAL {
            {
              SELECT ?book (GROUP_CONCAT(DISTINCT ?creatorName; separator="; ") AS ?creators)
              WHERE {
                ?book bf:contribution ?c .
                ?c a bflc:PrimaryContribution ;
                   bf:agent/rdfs:label ?creatorName .
              }
              GROUP BY ?book
            }
          }
          OPTIONAL {
            {
              SELECT ?book (SAMPLE(?d) AS ?date) (SAMPLE(?pl) AS ?place) (SAMPLE(?pb) AS ?publisher)
              WHERE {
                ?book bf:provisionActivity ?pub .
                OPTIONAL { ?pub bflc:simpleDate  ?d . }
                OPTIONAL { ?pub bflc:simplePlace ?pl . }
                OPTIONAL { ?pub bflc:simpleAgent ?pb . }
              }
              GROUP BY ?book
            }
          }
          # ab:representativeImage is single per book. The cards are the index's
          # masonry grid, so the thumbnail is requested by width ("400," is width 400,
          # height derived) and its height computed from the master's aspect ratio, so
          # the browser reserves the right box before the lazy image loads.
          OPTIONAL {
            ?book ab:representativeImage ?thumb .
            ?thumb ab:iiifPath    ?thumbPath ;
                   ab:pixelWidth  ?thumbMasterWidth ;
                   ab:pixelHeight ?thumbMasterHeight .
            BIND(400 AS ?thumbWidth)
            BIND(xsd:integer(ROUND(?thumbMasterHeight * ?thumbWidth / ?thumbMasterWidth)) AS ?thumbHeight)
            BIND(CONCAT("https://www.jstor.org", ?thumbPath, "/full/400,/0/default.jpg") AS ?thumbUrl)
          }
          BIND(CONCAT(
                 COALESCE(STR(?place), ""),
                 IF(BOUND(?place) && BOUND(?publisher), ": ", ""),
                 COALESCE(STR(?publisher), "")
               ) AS ?imprint)
          BIND(CONCAT(
                 ?bookKey, "\t", ?title, "\t",
                 COALESCE(?creators, ""), "\t",
                 COALESCE(STR(?date), ""), "\t",
                 ?imprint, "\t",
                 COALESCE(?thumbUrl, ""), "\t",
                 COALESCE(STR(?thumbWidth), ""), "\t",
                 COALESCE(STR(?thumbHeight), "")
               ) AS ?bookToken)
        }
        ORDER BY LCASE(?title) ?bookKey
      }
    }
    GROUP BY ?concept
  }
}
# Categories in the BARD glossary's order (ab:categoryRank, #120), not
# alphabetically; the label breaks ties so a category missing its rank still
# stays contiguous. Unranked/uncategorized concepts sort last.
ORDER BY COALESCE(?categoryRank, 1000) ?categoryLabel LCASE(?label)
