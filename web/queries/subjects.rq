PREFIX ab:      <https://dkglab.github.io/ns/artists-books/>
PREFIX bf:      <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:    <http://id.loc.gov/ontologies/bflc/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>

# One row per subject-term concept that at least one artists' book is linked to
# via ab:hasSubject. Feeds both the subjects index ("Subjects" page) and the
# per-subject detail page. Mirrors queries/construction-methods.rq: the book join
# is REQUIRED (not OPTIONAL), so a curated concept that no in-collection book uses
# earns no page.
#
# Fuseki loads the SKOS scheme (sources/subject-terms.ttl) alongside the
# constructed graphs, so each concept's prefLabel and its category (skos:broader
# top-concept: Topical subjects / Geographic subjects) resolve here.
SELECT
  ?concept
  # The URI slug (…/subject/<conceptKey>), used for the output path and for the
  # links minted on the book pages.
  (REPLACE(STR(?concept), ".*/subject/", "") AS ?conceptKey)
  ?label
  ?category
  ?categoryLabel
  # The label's first letter, for the index's A–Z sections; anything outside
  # A–Z (digits, punctuation, accented initials) files under "#".
  ?initial
  # Each book as a TAB-separated token, tokens newline-separated, so the
  # template can render a card per book (thumbnail, title link, creator · date).
  # Field order is positional — the template indexes it — and every field is
  # always present, so a missing value is an empty field rather than a missing
  # one:
  #   itemKey <TAB> title <TAB> creators <TAB> date <TAB> thumbUrl
  (GROUP_CONCAT(DISTINCT ?bookToken; separator="\n") AS ?books)
  (COUNT(DISTINCT ?book) AS ?bookCount)
WHERE {
  ?concept
    a skos:Concept ;
    skos:inScheme ab:subject-terms ;
    .
  OPTIONAL { ?concept skos:prefLabel ?prefLabel . }
  OPTIONAL { ?concept rdfs:label ?rdfsLabel . }
  BIND(COALESCE(?prefLabel, ?rdfsLabel) AS ?label)
  BIND(UCASE(SUBSTR(STR(?label), 1, 1)) AS ?firstChar)
  BIND(IF(REGEX(?firstChar, "^[A-Z]$"), ?firstChar, "#") AS ?initial)

  # Category top-concept (Topical subjects / Geographic subjects).
  OPTIONAL {
    ?concept skos:broader ?category .
    ?category rdfs:label ?categoryLabel .
  }

  # Required: the artists' books with this subject.
  ?book
    a ab:ArtistsBook ;
    ab:hasSubject ?concept ;
    ab:itemKey ?bookKey ;
    rdfs:label ?title ;
    .

  # Card details for each book. Creators and date are aggregated per book in
  # their own subqueries so a book with two primary creators (or two dates)
  # still yields one token rather than several near-duplicates.
  OPTIONAL {
    {
      SELECT ?book (GROUP_CONCAT(DISTINCT ?creatorName; separator="; ") AS ?creators)
      WHERE {
        ?book bf:contribution ?c .
        ?c a bflc:PrimaryContribution ;
           bf:agent/rdfs:label ?creatorName .
      }
      GROUP BY ?book
    }
  }
  OPTIONAL {
    {
      SELECT ?book (SAMPLE(?d) AS ?date)
      WHERE { ?book bf:provisionActivity/bflc:simpleDate ?d . }
      GROUP BY ?book
    }
  }
  # ab:representativeImage is single per book. ",180" asks the IIIF server for
  # height 180, the card's thumbnail size.
  OPTIONAL {
    ?book ab:representativeImage/ab:iiifPath ?thumbPath .
    BIND(CONCAT("https://www.jstor.org", ?thumbPath, "/full/,180/0/default.jpg") AS ?thumbUrl)
  }
  BIND(CONCAT(
         ?bookKey, "\t", ?title, "\t",
         COALESCE(?creators, ""), "\t",
         COALESCE(STR(?date), ""), "\t",
         COALESCE(?thumbUrl, "")
       ) AS ?bookToken)
}
GROUP BY ?concept ?label ?category ?categoryLabel ?initial
# A–Z across both categories, so the index's letter sections come out
# contiguous ("#" sorts before "A").
ORDER BY ?initial LCASE(?label)
