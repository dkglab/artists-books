PREFIX ab:      <https://dkglab.github.io/ns/artists-books/>
PREFIX bf:      <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:    <http://id.loc.gov/ontologies/bflc/>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

# One row per subject-term concept that at least one artists' book is linked to
# via ab:hasSubject. Feeds both the subjects index ("Subjects" page) and the
# per-subject detail page. Mirrors queries/construction-methods.rq: the book join
# is REQUIRED (not OPTIONAL), so a curated concept that no in-collection book uses
# earns no page.
#
# Fuseki loads the SKOS scheme (sources/subject-terms.ttl) alongside the
# constructed graphs, so each concept's prefLabel and its category (skos:broader
# top-concept: Topical subjects / Geographic subjects) resolve here.
SELECT
  ?concept
  # The URI slug (…/subject/<conceptKey>), used for the output path and for the
  # links minted on the book pages.
  (REPLACE(STR(?concept), ".*/subject/", "") AS ?conceptKey)
  ?label
  ?category
  ?categoryLabel
  # The label's first letter, for the index's A–Z sections (see ?sortKey).
  ?initial
  # Each book as a TAB-separated token, tokens newline-separated, so the
  # template can render a card per book (thumbnail, title link, creator · date,
  # place: publisher).
  # Field order is positional — the template indexes it — and every field is
  # always present, so a missing value is an empty field rather than a missing
  # one:
  #   itemKey <TAB> title <TAB> creators <TAB> date <TAB> imprint
  #     <TAB> thumbUrl <TAB> thumbWidth <TAB> thumbHeight
  ?books
  ?bookCount
WHERE {
  ?concept
    a skos:Concept ;
    skos:inScheme ab:subject-terms ;
    .
  OPTIONAL { ?concept skos:prefLabel ?prefLabel . }
  OPTIONAL { ?concept rdfs:label ?rdfsLabel . }
  BIND(COALESCE(?prefLabel, ?rdfsLabel) AS ?label)
  # The sort key: the label lower-cased with leading punctuation dropped and
  # Latin accents folded ("Álvarez" -> "alvarez", "Øvstebø" -> "ovstebo"), so
  # accented labels sort among the unaccented ones and file under their base
  # letter. Plain code-point order on the folded key keeps the index
  # word-by-word ("art brut" < "art history" < "artists"); a locale collation
  # (arq:collation) would not, since Java's collator ignores spaces.
  BIND(REPLACE(LCASE(STR(?label)), "^[^\\p{L}\\p{N}]+", "") AS ?key0)
  BIND(REPLACE(?key0, "\\p{M}", "") AS ?key1)
  BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(?key1,
         "[àáâãäåāăą]", "a"), "æ", "ae"), "[çćĉċč]", "c"), "[ďđð]", "d"),
         "[èéêëēĕėęě]", "e"), "[ĝğġģ]", "g"), "[ĥħ]", "h") AS ?key2)
  BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(?key2,
         "[ìíîïĩīĭįı]", "i"), "ĵ", "j"), "ķ", "k"), "[ĺļľŀł]", "l"),
         "[ñńņňŉŋ]", "n"), "[òóôõöøōŏő]", "o"), "œ", "oe") AS ?key3)
  BIND(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(?key3,
         "[ŕŗř]", "r"), "[śŝşšſ]", "s"), "ß", "ss"), "[ţťŧ]", "t"), "þ", "th"),
         "[ùúûüũūŭůűų]", "u"), "ŵ", "w"), "[ýÿŷ]", "y") AS ?key4)
  BIND(REPLACE(?key4, "[źżž]", "z") AS ?sortKey)
  # The index's A–Z section is the sort key's first letter ("[Anonymous]"
  # under A, "Éluard" under E); anything else (a leading digit) files under "#".
  BIND(UCASE(SUBSTR(?sortKey, 1, 1)) AS ?firstChar)
  BIND(IF(REGEX(?firstChar, "^[A-Z]$"), ?firstChar, "#") AS ?initial)

  # Category top-concept (Topical subjects / Geographic subjects).
  OPTIONAL {
    ?concept skos:broader ?category .
    ?category rdfs:label ?categoryLabel .
  }

  # Required: the artists' books with this subject.
  # One aggregated row per concept, so a concept no in-collection book uses
  # earns no page. The cards come out sorted by title: GROUP_CONCAT keeps its
  # input order, and only a scope *below* the grouping can be ordered, so the
  # innermost SELECT builds one token per book and sorts them (item key breaks
  # ties between identically titled books, keeping the build deterministic).
  {
    SELECT ?concept
           (GROUP_CONCAT(?bookToken; separator="\n") AS ?books)
           (COUNT(DISTINCT ?book) AS ?bookCount)
    WHERE {
      {
        SELECT DISTINCT ?concept ?book ?bookToken
        WHERE {
          ?book
            a ab:ArtistsBook ;
            ab:hasSubject ?concept ;
            ab:itemKey ?bookKey ;
            rdfs:label ?title ;
            .

          # Card details for each book. Creators and the imprint are aggregated per
          # book in their own subqueries so a book with two primary creators (or two
          # dates) still yields one token rather than several near-duplicates.
          OPTIONAL {
            {
              SELECT ?book (GROUP_CONCAT(DISTINCT ?creatorName; separator="; ") AS ?creators)
              WHERE {
                ?book bf:contribution ?c .
                ?c a bflc:PrimaryContribution ;
                   bf:agent/rdfs:label ?creatorName .
              }
              GROUP BY ?book
            }
          }
          # The imprint: every publication group's "place: publisher" (#196), in
          # order, "; "-joined.
          OPTIONAL {
            {
              SELECT ?book (SAMPLE(?d) AS ?date)
                     (GROUP_CONCAT(?part; separator="; ") AS ?imprintRaw)
              WHERE {
                {
                  # Ordered by group (the URI's /publication/<n>, plain /publication
                  # being group 1), which Jena's GROUP_CONCAT preserves.
                  SELECT ?book ?d ?pl ?pb ?pub ?part WHERE {
                    ?book bf:provisionActivity ?pub .
                    OPTIONAL { ?pub bflc:simpleDate  ?d . }
                    OPTIONAL { ?pub bflc:simplePlace ?pl . }
                    OPTIONAL { ?pub bflc:simpleAgent ?pb . }
                    BIND(CONCAT(COALESCE(STR(?pl), ""),
                                IF(BOUND(?pl) && BOUND(?pb), ": ", ""),
                                COALESCE(STR(?pb), "")) AS ?part)
                    BIND(COALESCE(xsd:integer(STRAFTER(STR(?pub), "/publication/")), 1) AS ?n)
                  }
                  ORDER BY ?book ?n
                }
              }
              GROUP BY ?book
            }
          }
          # ab:representativeImage is single per book. The cards are the index's
          # masonry grid, so the thumbnail is requested by width ("400," is width 400,
          # height derived) and its height computed from the master's aspect ratio, so
          # the browser reserves the right box before the lazy image loads.
          OPTIONAL {
            ?book ab:representativeImage ?thumb .
            ?thumb ab:iiifPath    ?thumbPath ;
                   ab:pixelWidth  ?thumbMasterWidth ;
                   ab:pixelHeight ?thumbMasterHeight .
            BIND(400 AS ?thumbWidth)
            BIND(xsd:integer(ROUND(?thumbMasterHeight * ?thumbWidth / ?thumbMasterWidth)) AS ?thumbHeight)
            BIND(CONCAT("https://www.jstor.org", ?thumbPath, "/full/400,/0/default.jpg") AS ?thumbUrl)
          }
          # A group with neither place nor publisher leaves an empty part; drop it.
          BIND(COALESCE(REPLACE(REPLACE(?imprintRaw, "^(; )+|(; )+$", ""), "(; ){2,}", "; "), "") AS ?imprint)
          BIND(CONCAT(
                 ?bookKey, "\t", ?title, "\t",
                 COALESCE(?creators, ""), "\t",
                 COALESCE(STR(?date), ""), "\t",
                 ?imprint, "\t",
                 COALESCE(?thumbUrl, ""), "\t",
                 COALESCE(STR(?thumbWidth), ""), "\t",
                 COALESCE(STR(?thumbHeight), "")
               ) AS ?bookToken)
        }
        ORDER BY LCASE(?title) ?bookKey
      }
    }
    GROUP BY ?concept
  }
}
# A–Z across both categories, so the index's letter sections come out
# contiguous ("#" sorts before "A"); the concept breaks ties.
ORDER BY ?initial ?sortKey ?concept
