PREFIX ab:      <https://dkglab.github.io/ns/artists-books/>
PREFIX bf:      <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:    <http://id.loc.gov/ontologies/bflc/>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:      <http://www.wikidata.org/entity/>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

# One row per reference work (#34) that cites at least one artists' book in the
# ABC collection, feeding both the reference index ("Results" page) and the
# per-reference detail page. Mirrors queries/artists-books.rq.
#
# The Reference resources collection is a 157-work bibliography, but a reference
# work only earns a page here when it actually cites an in-collection book: the
# citation join below is REQUIRED, not OPTIONAL, so the ~114 reference works
# that no matched "Cited:" note connects to an ABC book are excluded. Citations
# come from the artists-books graph (Fuseki loads both constructed graphs) via
# the ab:Citation / ab:citedBy / ab:cites relationship (#42); requiring the
# cited book's ab:itemKey keeps the join to books that exist in this collection.
SELECT
  ?reference
  ?title
  ?itemKey
  # Creators as display strings ("name [role]"), aggregated so a work with
  # several creators stays one row (one output page). Primary = MARC 1xx,
  # contributors = 7xx (#40, #46).
  (GROUP_CONCAT(DISTINCT ?primaryCreatorDisplay; separator="; ") AS ?primaryCreators)
  (GROUP_CONCAT(DISTINCT ?otherCreatorDisplay; separator="; ") AS ?contributors)
  # Linkable creator tokens for the detail page; see the subqueries below.
  (SAMPLE(?primaryCreatorLinksAgg) AS ?primaryCreatorLinks)
  (SAMPLE(?contributorLinksAgg) AS ?contributorLinks)
  ?publisher
  ?place
  ?imprints
  ?imprint
  ?date
  ?language
  # One OCLC number per reference work (a single 001), so SAMPLE, not concat.
  (SAMPLE(?oclcNumbers) AS ?oclcNumber)
  (SAMPLE(?worldcatLinks) AS ?worldcatLink)
  (GROUP_CONCAT(DISTINCT ?isbn; separator="; ") AS ?isbns)
  # Each cited book as a four-field TAB-separated token, tokens separated by
  # newline, so the template can link each title to its /item/ page and print
  # the page numbers after it. Field order is positional — the template indexes
  # it — and every field is always present, so an absent page list is an empty
  # field rather than a missing one:
  #   itemKey <TAB> title <TAB> citation pages <TAB> image pages
  (GROUP_CONCAT(
    DISTINCT CONCAT(
      ?citedBookKey, "\t",
      ?citedTitle, "\t",
      COALESCE(?pageNumbers, ""), "\t",
      COALESCE(?imagePageNumbers, "")
    );
    separator="\n"
  ) AS ?citedBooks)
  (COUNT(DISTINCT ?citedBook) AS ?citationCount)
WHERE {
  ?reference
    a ab:ReferenceWork ;
    rdfs:label ?title ;
    ab:itemKey ?itemKey ;
    .

  # Creators from MARC 1xx (primary) and 7xx (other), as in artists-books.rq.
  # Edited volumes and exhibition catalogues often have no 1xx, so their only
  # creators are the 7xx contributors (#40, #46).
  OPTIONAL {
    ?reference bf:contribution ?c .
    ?c a bflc:PrimaryContribution ;
       bf:agent ?agent .
    ?agent rdfs:label ?name .
    OPTIONAL { ?c bf:role/rdfs:label ?role . }
    BIND(IF(BOUND(?role), CONCAT(?name, " [", ?role, "]"), ?name) AS ?primaryCreatorDisplay)
  }

  OPTIONAL {
    ?reference bf:contribution ?c2 .
    ?c2 a bf:Contribution ;
        bf:agent ?agent2 .
    FILTER NOT EXISTS { ?c2 a bflc:PrimaryContribution }
    ?agent2 rdfs:label ?name2 .
    OPTIONAL { ?c2 bf:role/rdfs:label ?role2 . }
    BIND(IF(BOUND(?role2), CONCAT(?name2, " [", ?role2, "]"), ?name2) AS ?otherCreatorDisplay)
  }

  # The same creators as linkable tokens, for the detail page: each
  # "agentKey<TAB>name<TAB>roles", tokens newline-separated, one per
  # contribution with its roles aggregated (a contribution can carry several),
  # sorted by name. The agentKey ends every contribution URI and is the
  # creator's /creator/<agentKey> page slug (see creators.rq, which gives every
  # agent credited here a page). Built in per-work subqueries so the outer
  # cross product of OPTIONALs can't duplicate them; SAMPLE'd in the projection.
  # A role-less contribution contributes an empty role (COALESCE keeps it from
  # voiding the GROUP_CONCAT, which an unbound row would); the REPLACEs tidy
  # its separator away.
  OPTIONAL {
    {
      SELECT ?reference (GROUP_CONCAT(?linkToken; separator="\n") AS ?primaryCreatorLinksAgg)
      WHERE {
        {
          SELECT ?reference ?linkToken
          WHERE {
            {
              SELECT ?reference ?lc ?lagent
                     (GROUP_CONCAT(DISTINCT COALESCE(?lrole, ""); separator=", ") AS ?lrolesRaw)
              WHERE {
                ?reference bf:contribution ?lc .
                ?lc a bflc:PrimaryContribution ;
                    bf:agent ?lagent .
                OPTIONAL { ?lc bf:role/rdfs:label ?lrole . }
              }
              GROUP BY ?reference ?lc ?lagent
            }
            ?lagent rdfs:label ?lname .
            BIND(REPLACE(REPLACE(?lrolesRaw, "(, ){2,}", ", "), "^, |, $", "") AS ?lroles)
            BIND(CONCAT(REPLACE(STR(?lc), "^.*/contribution/", ""), "\t", ?lname, "\t", ?lroles) AS ?linkToken)
          }
          ORDER BY LCASE(?lname) ?linkToken
        }
      }
      GROUP BY ?reference
    }
  }
  OPTIONAL {
    {
      SELECT ?reference (GROUP_CONCAT(?linkToken; separator="\n") AS ?contributorLinksAgg)
      WHERE {
        {
          SELECT ?reference ?linkToken
          WHERE {
            {
              SELECT ?reference ?lc ?lagent
                     (GROUP_CONCAT(DISTINCT COALESCE(?lrole, ""); separator=", ") AS ?lrolesRaw)
              WHERE {
                ?reference bf:contribution ?lc .
                ?lc a bf:Contribution ;
                    bf:agent ?lagent .
                  FILTER NOT EXISTS { ?lc a bflc:PrimaryContribution }
                OPTIONAL { ?lc bf:role/rdfs:label ?lrole . }
              }
              GROUP BY ?reference ?lc ?lagent
            }
            ?lagent rdfs:label ?lname .
            BIND(REPLACE(REPLACE(?lrolesRaw, "(, ){2,}", ", "), "^, |, $", "") AS ?lroles)
            BIND(CONCAT(REPLACE(STR(?lc), "^.*/contribution/", ""), "\t", ?lname, "\t", ?lroles) AS ?linkToken)
          }
          ORDER BY LCASE(?lname) ?linkToken
        }
      }
      GROUP BY ?reference
    }
  }

  # The publication statement (#21). A work co-published from several places
  # has one bf:Publication per place/publisher group (#196), so the groups are
  # aggregated here to keep one row (one output page) per work. With a single
  # group the page shows Publisher and Place as before; with several, ?imprints
  # gives one "place: publisher" line per group, in order. ?imprint is the
  # same pairs on one line, for the index card.
  OPTIONAL {
    {
      SELECT ?reference
             (SAMPLE(?d) AS ?date)
             (COUNT(DISTINCT ?pub) AS ?nPub)
             (SAMPLE(?pb) AS ?pb1)
             (SAMPLE(?pl) AS ?pl1)
             (GROUP_CONCAT(?part; separator="\n") AS ?imprintLines)
      WHERE {
          {
            # Ordered by group (the URI's /publication/<n>, plain /publication
            # being group 1), which Jena's GROUP_CONCAT preserves.
            SELECT ?reference ?d ?pl ?pb ?pub ?part WHERE {
              ?reference bf:provisionActivity ?pub .
              OPTIONAL { ?pub bflc:simpleDate  ?d . }
              OPTIONAL { ?pub bflc:simplePlace ?pl . }
              OPTIONAL { ?pub bflc:simpleAgent ?pb . }
              BIND(CONCAT(COALESCE(STR(?pl), ""),
                          IF(BOUND(?pl) && BOUND(?pb), ": ", ""),
                          COALESCE(STR(?pb), "")) AS ?part)
              BIND(COALESCE(xsd:integer(STRAFTER(STR(?pub), "/publication/")), 1) AS ?n)
            }
            ORDER BY ?reference ?n
          }
      }
      GROUP BY ?reference
    }
  }
  BIND(IF(?nPub = 1, ?pb1, ?unbound) AS ?publisher)
  BIND(IF(?nPub = 1, ?pl1, ?unbound) AS ?place)
  # A group with neither place nor publisher contributes an empty line; drop it.
  BIND(REPLACE(REPLACE(?imprintLines, "^\n+|\n+$", ""), "\n{2,}", "\n") AS ?imprintLinesTidy)
  BIND(IF(?nPub > 1 && ?imprintLinesTidy != "", ?imprintLinesTidy, ?unbound) AS ?imprints)
  BIND(IF(?imprintLinesTidy != "", REPLACE(?imprintLinesTidy, "\n", "; "), ?unbound) AS ?imprint)

  OPTIONAL { ?reference bf:language ?language . }

  OPTIONAL {
    ?reference bf:identifiedBy ?id .
    ?id rdf:value ?isbn ;
        bf:source wd:Q33057 .
  }

  OPTIONAL {
    ?reference bf:identifiedBy ?refOCLCNum .
    ?refOCLCNum
      rdf:value ?oclcNumbers ;
      bf:source wd:Q846596 .
  }

  OPTIONAL {
    ?reference foaf:isPrimaryTopicOf ?worldcatLinks .
  }

  # Required: the artists' books this reference cites (#42). The cited book must
  # exist in the artists-books graph (carry an ab:itemKey); fall back to that
  # key for display when it has no label.
  ?citation ab:citedBy ?reference ;
            ab:cites   ?citedBook .
  ?citedBook ab:itemKey ?citedBookKey .
  OPTIONAL { ?citedBook rdfs:label ?citedBookLabel . }

  # The pages this citation appears on (#44) and the pages carrying an image of
  # the book (#43). Each list is aggregated per-citation in its own subquery,
  # for two reasons:
  #
  #  1. It avoids a citation-pages x image-pages cross product. A citation with
  #     2 page numbers and 1 image page would otherwise yield 2 solutions and
  #     so 2 near-duplicate tokens in ?citedBooks.
  #  2. GROUP_CONCAT has no ordering guarantee, so the pages come out in hash
  #     order ("82, 89, 12, 90, 91"). Only a scope *below* the grouping can be
  #     ordered — ORDER BY in the aggregating subquery would apply after
  #     GROUP BY — hence the innermost ordered SELECT. Jena carries that input
  #     order into GROUP_CONCAT; that is implementation-defined rather than
  #     promised by SPARQL, but Snowman exposes no template sort function, so
  #     this is the only place to do it.
  #
  # Pages sort on their leading integer, which keeps ranges ("97-99") in place;
  # every page value in the citation graph starts with a digit.
  #
  # NB: ab:imagesOnPageNumber is an rdfs:subPropertyOf ab:onPageNumber, so under
  # a reasoner every image page would also match ?page and appear in *both*
  # lists. Fuseki loads these graphs without inference and no page is asserted
  # under both predicates, so the two lists are disjoint as emitted; enabling
  # inference would require filtering the plain list against the image one.
  OPTIONAL {
    {
      SELECT ?citation (GROUP_CONCAT(?page; separator=", ") AS ?pageNumbers)
      WHERE {
        {
          SELECT DISTINCT ?citation ?page
          WHERE { ?citation ab:onPageNumber ?page . }
          ORDER BY xsd:integer(REPLACE(STR(?page), "[^0-9].*$", ""))
        }
      }
      GROUP BY ?citation
    }
  }

  OPTIONAL {
    {
      SELECT ?citation (GROUP_CONCAT(?imagePage; separator=", ") AS ?imagePageNumbers)
      WHERE {
        {
          SELECT DISTINCT ?citation ?imagePage
          WHERE { ?citation ab:imagesOnPageNumber ?imagePage . }
          ORDER BY xsd:integer(REPLACE(STR(?imagePage), "[^0-9].*$", ""))
        }
      }
      GROUP BY ?citation
    }
  }

  BIND(COALESCE(?citedBookLabel, ?citedBookKey) AS ?citedTitle)
}
GROUP BY ?reference ?title ?itemKey ?publisher ?place ?imprints ?imprint ?date ?language
ORDER BY LCASE(?title)
