PREFIX ab:      <https://dkglab.github.io/ns/artists-books/>
PREFIX bf:      <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:    <http://id.loc.gov/ontologies/bflc/>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:      <http://www.wikidata.org/entity/>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT
  ?book
  ?title
  ?itemKey
  (GROUP_CONCAT(DISTINCT ?primaryCreatorDisplay; separator="; ") AS ?primaryCreators)
  (GROUP_CONCAT(DISTINCT ?otherCreatorDisplay; separator="; ") AS ?contributors)
  # Linkable creator tokens for the detail page; see the subqueries below.
  (SAMPLE(?primaryCreatorLinksAgg) AS ?primaryCreatorLinks)
  (SAMPLE(?contributorLinksAgg) AS ?contributorLinks)
  ?publisher
  ?place
  ?imprints
  ?imprint
  ?date
  (GROUP_CONCAT(DISTINCT STR(?languageDisplay); separator=", ") AS ?language)
  (GROUP_CONCAT(DISTINCT ?originalLanguageDisplay; separator=", ") AS ?originalLanguage)
  (SAMPLE(?languageNoteLabel) AS ?languageNote)
  ?extent
  ?illustrativeContent
  ?dimensions
  ?edition
  (SAMPLE(?summaries) AS ?summary)
  # Each construction method as a "conceptKey<TAB>label" token, tokens newline-
  # separated, so the template links each to its /construction/ page.
  (GROUP_CONCAT(DISTINCT CONCAT(
     REPLACE(STR(?constructionTerm), ".*/construction/", ""), "\t",
     COALESCE(?constructionTermLabel, STR(?constructionTerm))
   ); separator="\n") AS ?constructionTerms)
  # Each subject term as a "conceptKey<TAB>label" token, tokens newline-separated,
  # so the template links each to its /subject/ page.
  (GROUP_CONCAT(DISTINCT CONCAT(
     REPLACE(STR(?subjectTerm), ".*/subject/", ""), "\t",
     COALESCE(?subjectTermLabel, STR(?subjectTerm))
   ); separator="\n") AS ?subjectTerms)
  (GROUP_CONCAT(DISTINCT ?isbn; separator="; ") AS ?isbns)
  (GROUP_CONCAT(DISTINCT ?oclc_number; separator="; ") AS ?oclcNumbers)
  (SAMPLE(?worldcatLinks) AS ?worldcatLink)
  # Reference works that cite this book (#42), each as a four-field
  # TAB-separated token (tokens newline-separated) so the template can link
  # each to its /reference/ page and print the page numbers after it (#16).
  # Field order is positional and every field is always present, so an absent
  # page list is an empty field rather than a missing one:
  #   itemKey <TAB> title <TAB> citation pages <TAB> image pages
  # Any citing reference necessarily cites an in-collection book (this one),
  # so it always has a reference page.
  (GROUP_CONCAT(DISTINCT ?citedByToken; separator="\n") AS ?citedBy)
  # The index thumbnail. ab:representativeImage is single per book, so these are
  # grouped on rather than aggregated.
  ?thumbUrl
  ?thumbWidth
  ?thumbHeight
  ?thumbView
  # Every full-size image, each as a "url<TAB>width<TAB>height<TAB>view" token,
  # tokens newline-separated. Multi-valued: four books carry several images
  # (multi-volume sets, cover variants), so the book page shows them all.
  ?images
  (GROUP_CONCAT(DISTINCT ?relatedTitle; separator="; ") AS ?relatedTitles)
  # Variant titles (MARC 246, #20), each as a "title<TAB>kind" token, tokens
  # newline-separated; the kind is "" when the record doesn't say.
  (GROUP_CONCAT(DISTINCT ?variantToken; separator="\n") AS ?variantTitles)
  # Where images of the book can be found elsewhere (ab:imagesAt, #17), each as
  # a "url<TAB>site name" token, tokens newline-separated.
  (GROUP_CONCAT(DISTINCT ?imagesAtToken; separator="\n") AS ?imagesAt)
WHERE {
  ?book
    a ab:ArtistsBook ;
    rdfs:label ?title ;
    ab:itemKey ?itemKey ;
    .

  OPTIONAL {
    ?book bf:contribution ?c .
    ?c a bflc:PrimaryContribution ;
       bf:agent ?agent .
    ?agent rdfs:label ?name .
    OPTIONAL { ?c bf:role/rdfs:label ?role . }
    BIND(
      IF(BOUND(?role),
         CONCAT(?name, " [", ?role, "]"),
         ?name
      ) AS ?primaryCreatorDisplay
    )
  }

  OPTIONAL {
    ?book bf:contribution ?c2 .
    ?c2 a bf:Contribution ;
        bf:agent ?agent2 .
    FILTER NOT EXISTS { ?c2 a bflc:PrimaryContribution }
    ?agent2 rdfs:label ?name2 .
    OPTIONAL { ?c2 bf:role/rdfs:label ?role2 . }
    BIND(
      IF(BOUND(?role2),
         CONCAT(?name2, " [", ?role2, "]"),
         ?name2
      ) AS ?otherCreatorDisplay
    )
  }

  # The same creators as linkable tokens, for the detail page: each
  # "agentKey<TAB>name<TAB>roles", tokens newline-separated, one per
  # contribution with its roles aggregated (a contribution can carry several),
  # sorted by name. The agentKey ends every contribution URI and is the
  # creator's /creator/<agentKey> page slug (see creators.rq, which gives every
  # agent credited here a page). Built in per-work subqueries so the outer
  # cross product of OPTIONALs can't duplicate them; SAMPLE'd in the projection.
  # A role-less contribution contributes an empty role (COALESCE keeps it from
  # voiding the GROUP_CONCAT, which an unbound row would); the REPLACEs tidy
  # its separator away.
  OPTIONAL {
    {
      SELECT ?book (GROUP_CONCAT(?linkToken; separator="\n") AS ?primaryCreatorLinksAgg)
      WHERE {
        {
          SELECT ?book ?linkToken
          WHERE {
            {
              SELECT ?book ?lc ?lagent
                     (GROUP_CONCAT(DISTINCT COALESCE(?lrole, ""); separator=", ") AS ?lrolesRaw)
              WHERE {
                ?book bf:contribution ?lc .
                ?lc a bflc:PrimaryContribution ;
                    bf:agent ?lagent .
                OPTIONAL { ?lc bf:role/rdfs:label ?lrole . }
              }
              GROUP BY ?book ?lc ?lagent
            }
            ?lagent rdfs:label ?lname .
            BIND(REPLACE(REPLACE(?lrolesRaw, "(, ){2,}", ", "), "^, |, $", "") AS ?lroles)
            BIND(CONCAT(REPLACE(STR(?lc), "^.*/contribution/", ""), "\t", ?lname, "\t", ?lroles) AS ?linkToken)
          }
          ORDER BY LCASE(?lname) ?linkToken
        }
      }
      GROUP BY ?book
    }
  }
  OPTIONAL {
    {
      SELECT ?book (GROUP_CONCAT(?linkToken; separator="\n") AS ?contributorLinksAgg)
      WHERE {
        {
          SELECT ?book ?linkToken
          WHERE {
            {
              SELECT ?book ?lc ?lagent
                     (GROUP_CONCAT(DISTINCT COALESCE(?lrole, ""); separator=", ") AS ?lrolesRaw)
              WHERE {
                ?book bf:contribution ?lc .
                ?lc a bf:Contribution ;
                    bf:agent ?lagent .
                  FILTER NOT EXISTS { ?lc a bflc:PrimaryContribution }
                OPTIONAL { ?lc bf:role/rdfs:label ?lrole . }
              }
              GROUP BY ?book ?lc ?lagent
            }
            ?lagent rdfs:label ?lname .
            BIND(REPLACE(REPLACE(?lrolesRaw, "(, ){2,}", ", "), "^, |, $", "") AS ?lroles)
            BIND(CONCAT(REPLACE(STR(?lc), "^.*/contribution/", ""), "\t", ?lname, "\t", ?lroles) AS ?linkToken)
          }
          ORDER BY LCASE(?lname) ?linkToken
        }
      }
      GROUP BY ?book
    }
  }

  # The publication statement (#21). A work co-published from several places
  # has one bf:Publication per place/publisher group (#196), so the groups are
  # aggregated here to keep one row (one output page) per work. With a single
  # group the page shows Publisher and Place as before; with several, ?imprints
  # gives one "place: publisher" line per group, in order. ?imprint is the
  # same pairs on one line, for the index card.
  OPTIONAL {
    {
      SELECT ?book
             (SAMPLE(?d) AS ?date)
             (COUNT(DISTINCT ?pub) AS ?nPub)
             (SAMPLE(?pb) AS ?pb1)
             (SAMPLE(?pl) AS ?pl1)
             (GROUP_CONCAT(?part; separator="\n") AS ?imprintLines)
      WHERE {
          {
            # Ordered by group (the URI's /publication/<n>, plain /publication
            # being group 1), which Jena's GROUP_CONCAT preserves.
            SELECT ?book ?d ?pl ?pb ?pub ?part WHERE {
              ?book bf:provisionActivity ?pub .
              OPTIONAL { ?pub bflc:simpleDate  ?d . }
              OPTIONAL { ?pub bflc:simplePlace ?pl . }
              OPTIONAL { ?pub bflc:simpleAgent ?pb . }
              BIND(CONCAT(COALESCE(STR(?pl), ""),
                          IF(BOUND(?pl) && BOUND(?pb), ": ", ""),
                          COALESCE(STR(?pb), "")) AS ?part)
              BIND(COALESCE(xsd:integer(STRAFTER(STR(?pub), "/publication/")), 1) AS ?n)
            }
            ORDER BY ?book ?n
          }
      }
      GROUP BY ?book
    }
  }
  BIND(IF(?nPub = 1, ?pb1, ?unbound) AS ?publisher)
  BIND(IF(?nPub = 1, ?pl1, ?unbound) AS ?place)
  # A group with neither place nor publisher contributes an empty line; drop it.
  BIND(REPLACE(REPLACE(?imprintLines, "^\n+|\n+$", ""), "\n{2,}", "\n") AS ?imprintLinesTidy)
  BIND(IF(?nPub > 1 && ?imprintLinesTidy != "", ?imprintLinesTidy, ?unbound) AS ?imprints)
  BIND(IF(?imprintLinesTidy != "", REPLACE(?imprintLinesTidy, "\n", "; "), ?unbound) AS ?imprint)

  OPTIONAL {
    ?book bf:language ?languageValue .
    OPTIONAL {
      ?languageValue rdfs:label ?languageLabel .
    }

    BIND(
      COALESCE(?languageLabel, REPLACE(STR(?languageValue), "^.*/", ""))
      AS ?languageDisplay
    )
  }

  OPTIONAL {
    ?book bf:note ?languageNoteNode .
    ?languageNoteNode
      a bf:Note ;
      rdfs:label ?languageNoteLabel .
  }

  OPTIONAL {
    ?book bf:note ?originalLanguageNote .
    ?originalLanguageNote
      a bf:Note ;
      bf:language ?originalLanguageValue .

    OPTIONAL {
      ?originalLanguageValue rdfs:label ?originalLanguageLabel .
    }

    BIND(
      COALESCE(
        ?originalLanguageLabel,
        REPLACE(STR(?originalLanguageValue), "^.*/", "")
      )
      AS ?originalLanguageDisplay
    )
  }

  OPTIONAL {
    ?book bf:extent ?extentNode .
    ?extentNode rdfs:label ?extent .
  }

  # A book may carry several bf:illustrativeContent values (multi-part items
  # list one 300 $b per volume or format), so this is aggregated rather than
  # grouped on. Its own subquery, as in references.rq: it keeps the values out
  # of the outer cross product with creators/citations, and the innermost
  # ordered SELECT gives GROUP_CONCAT a deterministic input order (only a scope
  # *below* the grouping can be ordered).
  #
  # The innermost SELECT dedupes on ?icKey rather than with a plain DISTINCT.
  # Cataloging is inconsistent about the terminal period and about case, so one
  # record can carry two spellings of the same thing ("illustrations" and
  # "illustrations."), which are distinct literals that DISTINCT would keep and
  # the page would render as "illustrations; illustrations.". Folding case and
  # a trailing period gives the comparison key; MIN picks one surface form
  # deterministically (the period-less one, since it sorts before its own
  # extension). Values that appear in only one form — the AACR2 abbreviations
  # such as "ill." and "col. ill." — are single-member groups and pass through
  # untouched, so their period is preserved.
  OPTIONAL {
    {
      SELECT ?book
             (GROUP_CONCAT(?ic; separator="; ") AS ?illustrativeContent)
      WHERE {
        {
          SELECT ?book (MIN(?icRaw) AS ?ic)
          WHERE {
            ?book bf:illustrativeContent ?icRaw .
            BIND(LCASE(REPLACE(STR(?icRaw), "\\.$", "")) AS ?icKey)
          }
          GROUP BY ?book ?icKey
          ORDER BY ?ic
        }
      }
      GROUP BY ?book
    }
  }

  OPTIONAL {
    ?book bf:editionStatement ?edition .
  }

  OPTIONAL {
    ?book bf:dimensions ?dimensions .
  }

  OPTIONAL {
    ?book bf:summary ?summaryNode .
    ?summaryNode rdfs:label ?summaries .
  }

  OPTIONAL {
    ?book bf:identifiedBy ?id .
    ?id rdf:value ?isbn ;
        bf:source wd:Q33057 .
  }

  OPTIONAL {
    ?book bf:identifiedBy ?oclcId .
    ?oclcId rdf:value ?oclc_number ;
            bf:source wd:Q846596 .
  }

  OPTIONAL {
    ?book foaf:isPrimaryTopicOf ?worldcatLinks .
  }

  # The graph keeps only links on an allowlist of hosts (queries/artists-books.rq),
  # so every one should find its site name here; a new host falls back to its
  # bare domain.
  OPTIONAL {
    ?book ab:imagesAt ?imagesAtUrl .
    OPTIONAL {
      VALUES (?imagesAtHost ?imagesAtSiteName) {
        ("wsworkshop.org"                            "Visual Studies Workshop")
        ("scad.lunaimaging.com"                      "SCAD Libraries Digital Collections")
        ("librarystack.org"                          "LIBRARYSTACK")
        ("libmma.s3-website-us-east-1.amazonaws.com" "the Metropolitan Museum of Art Libraries")
        ("digital.library.wisc.edu"                  "UW–Madison Libraries Digital Collections")
      }
      FILTER(STRSTARTS(REPLACE(STR(?imagesAtUrl), "^https?://(www\\.)?", ""), CONCAT(?imagesAtHost, "/")))
    }
    BIND(CONCAT(STR(?imagesAtUrl), "\t",
                COALESCE(?imagesAtSiteName, REPLACE(STR(?imagesAtUrl), "^https?://([^/]+).*", "$1")))
         AS ?imagesAtToken)
  }

  OPTIONAL {
    ?book ab:constructedUsing ?constructionTerm .
    OPTIONAL { ?constructionTerm rdfs:label ?constructionTermLabel . }
  }

  OPTIONAL {
    ?book ab:hasSubject ?subjectTerm .
    OPTIONAL { ?subjectTerm rdfs:label ?subjectTermLabel . }
  }

  # Imagery (#9). Only 1,145 of the 7,920 books have any, so both blocks are
  # OPTIONAL and the fields come back unbound — which is what {{ with }} tests.
  #
  # The URL is built here from ab:iiifPath rather than taken from the graph's
  # schema:contentUrl, so each view can ask the IIIF server for the size it
  # wants. Display dimensions are derived from the master's, which is the exact
  # figure the graph stores; the server's own rounding can differ by a pixel,
  # which matters for the aspect ratio the browser reserves and nothing else.
  # The index grid lays thumbnails out in fixed-width lanes at their own aspect
  # ratio, so they are requested by width: IIIF "400," is width 400, height
  # derived (about twice the lane width, for high-density screens).
  OPTIONAL {
    ?book ab:representativeImage ?thumb .
    ?thumb ab:iiifPath    ?thumbPath ;
           ab:pixelWidth  ?thumbMasterWidth ;
           ab:pixelHeight ?thumbMasterHeight .
    OPTIONAL { ?thumb ab:imageViewType/skos:prefLabel ?thumbView . }
    BIND(400 AS ?thumbWidth)
    BIND(xsd:integer(ROUND(?thumbMasterHeight * ?thumbWidth / ?thumbMasterWidth)) AS ?thumbHeight)
    BIND(CONCAT("https://www.jstor.org", ?thumbPath, "/full/400,/0/default.jpg") AS ?thumbUrl)
  }

  # Ordered innermost so GROUP_CONCAT sees a deterministic input order, as with
  # ?illustrativeContent above (only a scope below the grouping can be ordered).
  OPTIONAL {
    {
      SELECT ?book (GROUP_CONCAT(?imageToken; separator="\n") AS ?images)
      WHERE {
        {
          SELECT ?book ?imageToken
          WHERE {
            ?book ab:sourceImage ?image .
            ?image ab:iiifPath    ?imagePath ;
                   ab:pixelWidth  ?imageMasterWidth ;
                   ab:pixelHeight ?imageMasterHeight .
            OPTIONAL { ?image ab:imageViewType/skos:prefLabel ?imageView . }
            BIND(xsd:integer(ROUND(?imageMasterWidth * 600 / ?imageMasterHeight)) AS ?imageWidth)
            BIND(CONCAT(
                   "https://www.jstor.org", ?imagePath, "/full/,600/0/default.jpg", "\t",
                   STR(?imageWidth), "\t600\t",
                   COALESCE(?imageView, "")
                 ) AS ?imageToken)
          }
          ORDER BY ?image
        }
      }
      GROUP BY ?book
    }
  }

  OPTIONAL {
    ?citation ab:cites ?book ;
              ab:citedBy ?citingRef .
    ?citingRef rdfs:label ?citingRefLabel ;
               ab:itemKey ?citingRefKey .
    # The pages this citation appears on (#44) and the pages carrying an image
    # of the book (#43), each aggregated per citation in its own ordered
    # subquery to avoid a pages x image-pages cross product and to sort pages
    # on their leading integer. Same pattern as references.rq, whose comment
    # explains it in full (including why the two lists are disjoint despite
    # ab:imagesOnPageNumber being a sub-property of ab:onPageNumber).
    OPTIONAL {
      {
        SELECT ?citation (GROUP_CONCAT(?page; separator=", ") AS ?pageNumbers)
        WHERE {
          {
            SELECT DISTINCT ?citation ?page
            WHERE { ?citation ab:onPageNumber ?page . }
            ORDER BY xsd:integer(REPLACE(STR(?page), "[^0-9].*$", ""))
          }
        }
        GROUP BY ?citation
      }
    }
    OPTIONAL {
      {
        SELECT ?citation (GROUP_CONCAT(?imagePage; separator=", ") AS ?imagePageNumbers)
        WHERE {
          {
            SELECT DISTINCT ?citation ?imagePage
            WHERE { ?citation ab:imagesOnPageNumber ?imagePage . }
            ORDER BY xsd:integer(REPLACE(STR(?imagePage), "[^0-9].*$", ""))
          }
        }
        GROUP BY ?citation
      }
    }
    BIND(CONCAT(
      ?citingRefKey, "\t",
      ?citingRefLabel, "\t",
      COALESCE(?pageNumbers, ""), "\t",
      COALESCE(?imagePageNumbers, "")
    ) AS ?citedByToken)
  }

  OPTIONAL {
    ?book bf:relatedTo ?relatedWork .
    ?relatedWork rdfs:label ?relatedTitle .
  }

  OPTIONAL {
    ?book bf:title ?variant .
    ?variant a bf:VariantTitle ; rdfs:label ?variantLabel .
    OPTIONAL { ?variant bf:variantType ?variantType . }
    BIND(CONCAT(?variantLabel, "\t", COALESCE(?variantType, "")) AS ?variantToken)
  }

}
GROUP BY ?book ?title ?itemKey ?publisher ?place ?imprints ?imprint ?date ?extent ?illustrativeContent ?dimensions ?edition
         ?thumbUrl ?thumbWidth ?thumbHeight ?thumbView ?images
ORDER BY LCASE(?title)
