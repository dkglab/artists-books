PREFIX ab:      <https://dkglab.github.io/ns/artists-books/>
PREFIX bf:      <http://id.loc.gov/ontologies/bibframe/>
PREFIX bflc:    <http://id.loc.gov/ontologies/bflc/>
PREFIX rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:    <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wd:      <http://www.wikidata.org/entity/>
PREFIX foaf:    <http://xmlns.com/foaf/0.1/>
PREFIX skos:    <http://www.w3.org/2004/02/skos/core#>
PREFIX xsd:     <http://www.w3.org/2001/XMLSchema#>

SELECT
  ?book
  ?title
  ?itemKey
  (GROUP_CONCAT(DISTINCT ?primaryCreatorDisplay; separator="; ") AS ?primaryCreators)
  (GROUP_CONCAT(DISTINCT ?otherCreatorDisplay; separator="; ") AS ?contributors)
  ?publisher
  ?place
  ?date
  ?language
  ?extent
  ?illustrativeContent
  ?dimensions
  ?edition
  (SAMPLE(?summaries) AS ?summary)
  # Each construction method as a "conceptKey<TAB>label" token, tokens newline-
  # separated, so the template links each to its /construction/ page.
  (GROUP_CONCAT(DISTINCT CONCAT(
     REPLACE(STR(?constructionTerm), ".*/construction/", ""), "\t",
     COALESCE(?constructionTermLabel, STR(?constructionTerm))
   ); separator="\n") AS ?constructionTerms)
  # Each subject term as a "conceptKey<TAB>label" token, tokens newline-separated,
  # so the template links each to its /subject/ page.
  (GROUP_CONCAT(DISTINCT CONCAT(
     REPLACE(STR(?subjectTerm), ".*/subject/", ""), "\t",
     COALESCE(?subjectTermLabel, STR(?subjectTerm))
   ); separator="\n") AS ?subjectTerms)
  (GROUP_CONCAT(DISTINCT ?isbn; separator="; ") AS ?isbns)
  (GROUP_CONCAT(DISTINCT ?oclc_number; separator="; ") AS ?oclcNumbers)
  (SAMPLE(?worldcatLinks) AS ?worldcatLink)
  # Reference works that cite this book (#42), each as an "itemKey<TAB>title"
  # token (tokens newline-separated) so the template can link each to its
  # /reference/ page. Any citing reference necessarily cites an in-collection
  # book (this one), so it always has a reference page.
  (GROUP_CONCAT(DISTINCT ?citedByToken; separator="\n") AS ?citedBy)
  # The index thumbnail. ab:representativeImage is single per book, so these are
  # grouped on rather than aggregated.
  ?thumbUrl
  ?thumbWidth
  ?thumbHeight
  ?thumbView
  # Every full-size image, each as a "url<TAB>width<TAB>height<TAB>view" token,
  # tokens newline-separated. Multi-valued: four books carry several images
  # (multi-volume sets, cover variants), so the book page shows them all.
  ?images
WHERE {
  ?book
    a ab:ArtistsBook ;
    rdfs:label ?title ;
    ab:itemKey ?itemKey ;
    .

  OPTIONAL {
    ?book bf:contribution ?c .
    ?c a bflc:PrimaryContribution ;
       bf:agent ?agent .
    ?agent rdfs:label ?name .
    OPTIONAL { ?c bf:role/rdfs:label ?role . }
    BIND(
      IF(BOUND(?role),
         CONCAT(?name, " [", ?role, "]"),
         ?name
      ) AS ?primaryCreatorDisplay
    )
  }

  OPTIONAL {
    ?book bf:contribution ?c2 .
    ?c2 a bf:Contribution ;
        bf:agent ?agent2 .
    FILTER NOT EXISTS { ?c2 a bflc:PrimaryContribution }
    ?agent2 rdfs:label ?name2 .
    OPTIONAL { ?c2 bf:role/rdfs:label ?role2 . }
    BIND(
      IF(BOUND(?role2),
         CONCAT(?name2, " [", ?role2, "]"),
         ?name2
      ) AS ?otherCreatorDisplay
    )
  }

  OPTIONAL {
    ?book bf:provisionActivity ?pub .
    OPTIONAL { ?pub bflc:simpleAgent ?publisher . }
    OPTIONAL { ?pub bflc:simplePlace ?place . }
    OPTIONAL { ?pub bflc:simpleDate  ?date . }
  }

  OPTIONAL { ?book bf:language ?language . }

  OPTIONAL {
    ?book bf:extent ?extentNode .
    ?extentNode rdfs:label ?extent .
  }

  # A book may carry several bf:illustrativeContent values (multi-part items
  # list one 300 $b per volume or format), so this is aggregated rather than
  # grouped on. Its own subquery, as in references.rq: it keeps the values out
  # of the outer cross product with creators/citations, and the innermost
  # ordered SELECT gives GROUP_CONCAT a deterministic input order (only a scope
  # *below* the grouping can be ordered).
  #
  # The innermost SELECT dedupes on ?icKey rather than with a plain DISTINCT.
  # Cataloging is inconsistent about the terminal period and about case, so one
  # record can carry two spellings of the same thing ("illustrations" and
  # "illustrations."), which are distinct literals that DISTINCT would keep and
  # the page would render as "illustrations; illustrations.". Folding case and
  # a trailing period gives the comparison key; MIN picks one surface form
  # deterministically (the period-less one, since it sorts before its own
  # extension). Values that appear in only one form — the AACR2 abbreviations
  # such as "ill." and "col. ill." — are single-member groups and pass through
  # untouched, so their period is preserved.
  OPTIONAL {
    {
      SELECT ?book
             (GROUP_CONCAT(?ic; separator="; ") AS ?illustrativeContent)
      WHERE {
        {
          SELECT ?book (MIN(?icRaw) AS ?ic)
          WHERE {
            ?book bf:illustrativeContent ?icRaw .
            BIND(LCASE(REPLACE(STR(?icRaw), "\\.$", "")) AS ?icKey)
          }
          GROUP BY ?book ?icKey
          ORDER BY ?ic
        }
      }
      GROUP BY ?book
    }
  }

  OPTIONAL {
    ?book bf:editionStatement ?edition .
  }

  OPTIONAL {
    ?book bf:dimensions ?dimensions .
  }

  OPTIONAL {
    ?book bf:summary ?summaryNode .
    ?summaryNode rdfs:label ?summaries .
  }

  OPTIONAL {
    ?book bf:identifiedBy ?id .
    ?id rdf:value ?isbn ;
        bf:source wd:Q33057 .
  }

  OPTIONAL {
    ?book bf:identifiedBy ?oclcId .
    ?oclcId rdf:value ?oclc_number ;
            bf:source wd:Q846596 .
  }

  OPTIONAL {
    ?book foaf:isPrimaryTopicOf ?worldcatLinks .
  }

  OPTIONAL {
    ?book ab:constructedUsing ?constructionTerm .
    OPTIONAL { ?constructionTerm rdfs:label ?constructionTermLabel . }
  }

  OPTIONAL {
    ?book ab:hasSubject ?subjectTerm .
    OPTIONAL { ?subjectTerm rdfs:label ?subjectTermLabel . }
  }

  # Imagery (#9). Only 1,145 of the 7,920 books have any, so both blocks are
  # OPTIONAL and the fields come back unbound — which is what {{ with }} tests.
  #
  # The URL is built here from ab:iiifPath rather than taken from the graph's
  # schema:contentUrl, so each view can ask the IIIF server for the size it
  # wants. Display dimensions are derived from the master's, which is the exact
  # figure the graph stores; the server's own rounding can differ by a pixel,
  # which matters for the aspect ratio the browser reserves and nothing else.
  # Note the IIIF size syntax: ",200" is height 200, width derived.
  OPTIONAL {
    ?book ab:representativeImage ?thumb .
    ?thumb ab:iiifPath    ?thumbPath ;
           ab:pixelWidth  ?thumbMasterWidth ;
           ab:pixelHeight ?thumbMasterHeight .
    OPTIONAL { ?thumb ab:imageViewType/skos:prefLabel ?thumbView . }
    BIND(200 AS ?thumbHeight)
    BIND(xsd:integer(ROUND(?thumbMasterWidth * ?thumbHeight / ?thumbMasterHeight)) AS ?thumbWidth)
    BIND(CONCAT("https://www.jstor.org", ?thumbPath, "/full/,200/0/default.jpg") AS ?thumbUrl)
  }

  # Ordered innermost so GROUP_CONCAT sees a deterministic input order, as with
  # ?illustrativeContent above (only a scope below the grouping can be ordered).
  OPTIONAL {
    {
      SELECT ?book (GROUP_CONCAT(?imageToken; separator="\n") AS ?images)
      WHERE {
        {
          SELECT ?book ?imageToken
          WHERE {
            ?book ab:sourceImage ?image .
            ?image ab:iiifPath    ?imagePath ;
                   ab:pixelWidth  ?imageMasterWidth ;
                   ab:pixelHeight ?imageMasterHeight .
            OPTIONAL { ?image ab:imageViewType/skos:prefLabel ?imageView . }
            BIND(xsd:integer(ROUND(?imageMasterWidth * 600 / ?imageMasterHeight)) AS ?imageWidth)
            BIND(CONCAT(
                   "https://www.jstor.org", ?imagePath, "/full/,600/0/default.jpg", "\t",
                   STR(?imageWidth), "\t600\t",
                   COALESCE(?imageView, "")
                 ) AS ?imageToken)
          }
          ORDER BY ?image
        }
      }
      GROUP BY ?book
    }
  }

  OPTIONAL {
    ?citation ab:cites ?book ;
              ab:citedBy ?citingRef .
    ?citingRef rdfs:label ?citingRefLabel ;
               ab:itemKey ?citingRefKey .
    BIND(CONCAT(?citingRefKey, "\t", ?citingRefLabel) AS ?citedByToken)
  }
}
GROUP BY ?book ?title ?itemKey ?publisher ?place ?date ?language ?extent ?illustrativeContent ?dimensions ?edition
         ?thumbUrl ?thumbWidth ?thumbHeight ?thumbView ?images
ORDER BY LCASE(?title)
