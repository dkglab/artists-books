.DS_Store
.claude
# Zotero storage noise - web snapshot assets
sources/zotero/storage/**/*.gif
sources/zotero/storage/**/*.jpg
sources/zotero/storage/**/*.jpeg
sources/zotero/storage/**/*.png
sources/zotero/storage/**/*.ico
sources/zotero/storage/**/*.js
sources/zotero/storage/**/*.css
# Zotero full-text index state - machine-regenerable, no research value
sources/zotero/storage/**/.zotero-ft-cache
sources/zotero/storage/**/.zotero-ft-unprocessed
/.sprite
tools/jena/*
!tools/jena/Makefile
tools/sparql-anything/*
!tools/sparql-anything/Makefile
tools/fuseki/*
!tools/fuseki/Makefile
tools/yaz-client/*
!tools/yaz-client/Makefile
tools/snowman/*
!tools/snowman/Makefile
# fuzzy-match: commit the scripts, ignore the generated venv (issue #55)
tools/fuzzy-match/venv/
/graph/
/web/.snowman/
/web/site/
# same Snowman output when the build is (mistakenly) run from the repo root
/.snowman/
/site/
# MARC harvest state (resumable; only sources/marc/*-marc.xml is committed)
/sources/marc/harvest/
# scratch dir for unpacked MARC records and other throwaway working files
/tmp/
# Python bytecode cache
__pycache__/
*.pyc
# generated files
diff.txt
inferred.ttl
